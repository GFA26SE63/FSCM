C4Component
title FSCM Goods Receipt, Batch, and QR Components

Container_Boundary(clients, "Warehouse Clients") {
    Component(warehouse_mobile, "Warehouse Mobile", "Flutter", "Scans receipts, batches, and QR tags")
    Component(warehouse_portal, "Warehouse Operations Portal", "React", "Reviews scoped receipt and inventory data")
}

Container_Boundary(api, "Backend API") {
    Component(receipt_endpoint, "Goods Receipt Endpoints", ".NET", "Authorizes assigned warehouse and validates commands")
    Component(inventory_query, "Inventory Queries", ".NET", "Returns scoped batch, tag, and balance views")
}

Container_Boundary(application, "Application") {
    Component(receipt_service, "Receipt Service", ".NET", "Records inbound SKU, quantity, source lot, and expiry")
    Component(batch_service, "Batch Service", ".NET", "Merges warehouse + SKU + expiry and preserves lineage")
    Component(qr_service, "QR Lineage Service", ".NET", "Generates, resolves, splits, and prevents duplicate tag use")
    Component(balance_service, "Inventory Balance Service", ".NET", "Maintains on-hand, held, reserved, and available invariants")
}

Container_Boundary(data, "Data") {
    Component(repository, "Inventory Persistence", "EF Core", "Transactions, constraints, versions, history, and audit")
    ContainerDb(postgres, "PostgreSQL", "Database")
}

Rel(warehouse_mobile, receipt_endpoint, "Submits scans/receipts", "JSON/HTTPS")
Rel(warehouse_portal, inventory_query, "Reads inventory", "JSON/HTTPS")
Rel(receipt_endpoint, receipt_service, "Invokes")
Rel(receipt_service, batch_service, "Creates or merges batch")
Rel(batch_service, qr_service, "Maintains label lineage")
Rel(batch_service, balance_service, "Adds physical quantity")
Rel(receipt_service, repository, "Persists atomically")
Rel(batch_service, repository, "Persists atomically")
Rel(qr_service, repository, "Persists atomically")
Rel(balance_service, repository, "Persists versioned balance")
Rel(inventory_query, repository, "Reads scoped projections")
Rel(repository, postgres, "Reads/writes")
