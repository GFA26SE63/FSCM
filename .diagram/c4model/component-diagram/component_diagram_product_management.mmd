C4Component
title FSCM Catalog, Price, MLOR, and Promotion Components

Container_Boundary(clients, "Clients") {
    Component(admin_portal, "Admin Portal", "React", "Manages categories, products, prices, and promotions")
    Component(sales_mobile, "Sales Mobile", "Flutter", "Reads sellable catalog and server price snapshots")
}

Container_Boundary(api, "Backend API") {
    Component(catalog_endpoint, "Catalog Endpoints", ".NET", "Commands and scoped catalog queries")
    Component(promotion_endpoint, "Promotion Endpoints", ".NET", "Campaign and batch-discount commands")
}

Container_Boundary(application, "Application") {
    Component(category, "Category Service", ".NET", "Category hierarchy and lifecycle")
    Component(product, "Product Lifecycle Service", ".NET", "Draft, Published, Inactive, and new-SKU versioning")
    Component(price, "Effective Price Service", ".NET", "Effective-dated VND prices and order snapshots")
    Component(mlor, "MLOR Policy", ".NET", "Retailer-product minimum life requirement")
    Component(promotion, "Promotion Service", ".NET", "Targeting, effective periods, stacking, and batch discounts")
}

Container_Boundary(data, "Data") {
    Component(repository, "Catalog Persistence", "EF Core", "Master data, effective history, constraints, and audit")
    ContainerDb(postgres, "PostgreSQL", "Database")
}

Rel(admin_portal, catalog_endpoint, "Manages catalog", "JSON/HTTPS")
Rel(admin_portal, promotion_endpoint, "Manages promotions", "JSON/HTTPS")
Rel(sales_mobile, catalog_endpoint, "Reads cached/current catalog", "JSON/HTTPS")
Rel(catalog_endpoint, category, "Invokes")
Rel(catalog_endpoint, product, "Invokes")
Rel(catalog_endpoint, price, "Invokes")
Rel(catalog_endpoint, mlor, "Queries")
Rel(promotion_endpoint, promotion, "Invokes")
Rel(category, repository, "Persists")
Rel(product, repository, "Persists")
Rel(price, repository, "Persists/reads")
Rel(mlor, repository, "Reads effective policy")
Rel(promotion, repository, "Persists/reads")
Rel(repository, postgres, "Reads/writes")
