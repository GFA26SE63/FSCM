C4Component
title FSCM Backend Component Overview

Container_Boundary(api_boundary, "FSCM.API") {
    Component(auth_boundary, "Authentication and Scope Filters", ".NET", "Authenticates and enforces role plus assignment scope")
    Component(rest_api, "REST/OpenAPI Endpoints", ".NET", "Task-oriented commands and operational queries")
    Component(realtime, "State Notifications", "SignalR", "Advisory change notifications; clients re-query state")
}

Container_Boundary(application, "FSCM.Application") {
    Component(identity_scope, "Identity and Territory", ".NET", "Roles, warehouse/group/retailer assignments, and retailer eligibility")
    Component(catalog, "Catalog and Commercial Rules", ".NET", "Product lifecycle, prices, MLOR, promotions, and snapshots")
    Component(inventory, "Inventory and Transfer", ".NET", "Receipt, batches, QR lineage, balances, and central-to-regional transfer")
    Component(ordering, "Order and Allocation", ".NET", "Offline sync, hard filters, scoring, greedy allocation, and holds")
    Component(fulfillment, "Approval and Fulfillment", ".NET", "Reservations, picking, dispatch, delivery, and receipt confirmation")
    Component(payment_loyalty, "Payment, Loyalty, and Complaint", ".NET", "Full payment, point ledger, rewards, and complaints")
    Component(reporting, "KPI and Reporting", ".NET", "Post-promotion revenue, Sales KPI, ranking, and top products")
    Component(platform, "Platform Services", ".NET", "Configuration, audit, idempotency, notifications, jobs, and outbox")
}

Container_Boundary(adapters, "Persistence and Infrastructure") {
    Component(persistence, "PostgreSQL Persistence", "EF Core", "Repositories, transactions, constraints, migrations, and concurrency")
    Component(external, "External Adapters", ".NET", "Identity, object storage, and notification providers")
}

