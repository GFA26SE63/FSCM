C4Container
title "Component Diagram - Clean Architecture Backend"

Container_Boundary(web_portal, "Web Portal with React") {
    %% ADMIN/MANAGER
    Component(pg_product_information_mng, "Product Information Management Page", "React", "Manage product information")
    Component(pg_enterprise_warehouse_mng, "Enterprise Warehouses Management Page", "React", "Manage warehouses of the enterprise")
    Component(pg_goods_receipt_pro, "Goods Receipt Processing Page", "React", "Process goods receipt")
    Component(pg_buying_order_pro, "Buying Order Processing Page", "React", "Process order")
    Component(pg_dashboard_vw, "Dashboard Viewing Page", "React", "Displays system operation data")
    Component(pg_report_vw, "Report Viewing Page", "React", "Displays analytical business data")
    Component(pg_delivery_schedule_mng, "Delivery Schedule Management Page", "React", "Manage delivery schedule")
    %% -- WAREHOUSE STAFF --
    Component(pg_goods_receipt_mng, "Goods Receipt Management Page", "React", "Manage goods receipt")
    Component(pg_batch_location_vw, "Batch Location Viewing Page", "React", "Display batch location map")
    Component(pg_warehouse_goods_mng, "Warehouse Goods Management Page", "React", "View detail of warehouse's goods")
    Component(pg_warehouse_facility_mng, "Warehouse Facility Management Page", "React", "Manage each warehouse information")
}

Container_Boundary(mobile_app, "Mobile Application with Flutter") {
    %% -- DELIVERY MAN --
    Component(pg_delivery_order_vw, "Delivery Order Viewing Page", "Flutter", "View delivery order")
    Component(pg_personal_delivery_schedule_vw, "Delivery Schedule Viewing Page", "Flutter", "View personal delivery schedule for each delivery man")
    %% -- SALE MAN --
    Component(pg_buying_order_mng, "Buying Orders Management Page", "Flutter", "Manage buying order")
    Component(pg_sale_path_mng, "Sale Path Management Page", "Flutter", "Manage sale path planning")
}

