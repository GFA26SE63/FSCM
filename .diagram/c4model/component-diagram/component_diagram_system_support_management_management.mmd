C4Component
title FSCM Configuration, Reporting, Audit, and Jobs Components

Container_Boundary(clients, "Clients") {
    Component(admin_portal, "Admin Portal", "React", "Manages configuration and audits operational changes")
    Component(manager_portal, "Manager Dashboard", "React", "Views Sales/team KPI, ranking, and product performance")
    Component(user_clients, "Authorized Clients", "React/Flutter", "Receive notifications and read scoped history")
}

Container_Boundary(api_worker, "API and Worker") {
    Component(config_endpoint, "Configuration Endpoints", ".NET", "Versions approved business parameters")
    Component(report_endpoint, "Reporting Endpoints", ".NET", "Returns scoped post-promotion KPI projections")
    Component(audit_endpoint, "Audit Queries", ".NET", "Returns authorized immutable history")
    Component(job_worker, "Background Worker", ".NET", "Expiry, replenishment, discount, overdue, and notification jobs")
}

Container_Boundary(application, "Application") {
    Component(configuration, "Configuration Service", ".NET", "Weights, radius, transit, thresholds, terms, loyalty, and KPI settings")
    Component(reporting, "KPI and Reporting Service", ".NET", "Revenue after promotion, comparisons, ranking, and top products")
    Component(audit, "Audit Service", ".NET", "Material command history with actor/reason/correlation")
    Component(notification, "Notification Service", ".NET", "Creates and delivers scoped user notifications")
    Component(outbox, "Outbox Processor", ".NET", "Provides idempotent at-least-once asynchronous delivery")
}

Container_Boundary(data, "Data and Providers") {
    Component(repository, "Platform Persistence", "EF Core", "Configuration versions, projections, audit, notifications, jobs, and outbox")
    ContainerDb(postgres, "PostgreSQL", "Database")
    Component(provider, "Notification Provider", "External API", "Push/email transport")
}

Rel(admin_portal, config_endpoint, "Updates configuration", "JSON/HTTPS")
Rel(admin_portal, audit_endpoint, "Reviews audit", "JSON/HTTPS")
Rel(manager_portal, report_endpoint, "Reads KPI", "JSON/HTTPS")
Rel(user_clients, notification, "Reads notifications", "JSON/HTTPS")
Rel(config_endpoint, configuration, "Invokes")
Rel(report_endpoint, reporting, "Invokes")
Rel(audit_endpoint, audit, "Queries")
Rel(job_worker, outbox, "Claims work")
Rel(job_worker, notification, "Runs scheduled delivery")
Rel(configuration, repository, "Persists versions")
Rel(reporting, repository, "Reads projections")
Rel(audit, repository, "Appends/reads")
Rel(notification, repository, "Persists status")
Rel(outbox, repository, "Claims/settles messages")
Rel(notification, provider, "Delivers")
Rel(repository, postgres, "Reads/writes")
