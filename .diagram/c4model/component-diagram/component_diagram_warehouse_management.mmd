C4Component
title FSCM Warehouse Inventory and Transfer Components

Container_Boundary(clients, "Clients") {
    Component(admin_portal, "Admin Portal", "React", "Manages warehouse master data and configuration")
    Component(warehouse_client, "Warehouse Client", "Flutter/React", "Views stock and scans transfer dispatch/receipt")
}

Container_Boundary(api, "Backend API") {
    Component(warehouse_endpoint, "Warehouse Endpoints", ".NET", "Enforces role and assigned-warehouse scope")
    Component(transfer_endpoint, "Transfer Endpoints", ".NET", "Controls request, approval, dispatch, and receipt")
}

Container_Boundary(application, "Application") {
    Component(warehouse_master, "Warehouse Master Service", ".NET", "Central/regional warehouses, location, status, and assignments")
    Component(inventory, "Inventory Service", ".NET", "Batch balances, FEFO views, and expiry eligibility")
    Component(replenishment, "Replenishment Service", ".NET", "Suggests central-to-regional transfer below configured threshold")
    Component(transfer, "Transfer Service", ".NET", "FEFO source selection, in-transit state, receipt, and lineage conservation")
}

Container_Boundary(data, "Data") {
    Component(repository, "Warehouse Persistence", "EF Core", "Versioned balances, transfer state, history, and outbox")
    ContainerDb(postgres, "PostgreSQL", "Database")
}

Rel(admin_portal, warehouse_endpoint, "Manages warehouse data", "JSON/HTTPS")
Rel(warehouse_client, warehouse_endpoint, "Reads scoped inventory", "JSON/HTTPS")
Rel(warehouse_client, transfer_endpoint, "Scans dispatch/receipt", "JSON/HTTPS")
Rel(warehouse_endpoint, warehouse_master, "Invokes")
Rel(warehouse_endpoint, inventory, "Queries")
Rel(transfer_endpoint, transfer, "Invokes")
Rel(replenishment, inventory, "Checks regional threshold")
Rel(replenishment, transfer, "Suggests approved direction")
Rel(transfer, inventory, "Selects FEFO and moves quantity")
Rel(warehouse_master, repository, "Persists")
Rel(inventory, repository, "Reads/writes")
Rel(replenishment, repository, "Reads configuration/demand")
Rel(transfer, repository, "Persists atomically")
Rel(repository, postgres, "Reads/writes")
