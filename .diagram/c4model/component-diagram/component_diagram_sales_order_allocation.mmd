C4Component
title FSCM Sales Order and Allocation Components

Container_Boundary(clients, "Clients") {
    Component(sales_mobile, "Sales Mobile", "Flutter + SQLite", "Captures online/offline territory-scoped orders")
    Component(operations_portal, "Operations Portal", "React", "Reviews, approves, rejects, or cancels orders")
}

Container_Boundary(api, "Backend API") {
    Component(order_endpoint, "Order and Sync Endpoints", ".NET", "Validates contracts, identity, idempotency, and version")
    Component(order_query, "Order Queries", ".NET", "Returns scoped orders, snapshots, and sync outcomes")
}

Container_Boundary(application, "Application") {
    Component(scope_policy, "Territory Authorization", ".NET", "Validates Sales-to-retailer assignment")
    Component(sync_service, "Offline Sync Service", ".NET", "Orders commands by server receipt time and deduplicates retries")
    Component(pricing, "Pricing and Promotion", ".NET", "Revalidates server price/discount and creates snapshots")
    Component(allocation, "Allocation Engine", ".NET", "Hard filters, weighted scoring, greedy selection, and full-order decision")
    Component(inventory_hold, "Inventory Hold Service", ".NET", "Atomically creates/releases holds with optimistic concurrency")
    Component(approval, "Order Approval Service", ".NET", "Converts holds to reservations and creates picking work")
}

Container_Boundary(data, "Data") {
    Component(repository, "Order/Inventory Persistence", "EF Core", "Transactions, versions, history, idempotency, and outbox")
    ContainerDb(postgres, "PostgreSQL", "Database")
}

Rel(sales_mobile, order_endpoint, "Submits/retries orders", "JSON/HTTPS")
Rel(operations_portal, order_endpoint, "Sends review commands", "JSON/HTTPS")
Rel(operations_portal, order_query, "Reads order decisions", "JSON/HTTPS")
Rel(order_endpoint, scope_policy, "Authorizes")
Rel(order_endpoint, sync_service, "Invokes")
Rel(sync_service, pricing, "Revalidates")
Rel(sync_service, allocation, "Requests allocation")
Rel(allocation, inventory_hold, "Commits only complete supply")
Rel(order_endpoint, approval, "Invokes approval/rejection/cancellation")
Rel(sync_service, repository, "Persists command/result")
Rel(pricing, repository, "Reads effective data")
Rel(allocation, repository, "Reads candidates/configuration")
Rel(inventory_hold, repository, "Mutates balances atomically")
Rel(approval, repository, "Mutates status/reservations/picking")
Rel(repository, postgres, "Reads/writes")
