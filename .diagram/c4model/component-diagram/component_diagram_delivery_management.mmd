C4Component
title FSCM Fulfillment, Delivery, Receipt, and Complaint Components

Container_Boundary(clients, "Clients") {
    Component(operations_portal, "Operations Portal", "React", "Assigns vehicle/person and processes complaints")
    Component(warehouse_mobile, "Warehouse Mobile", "Flutter", "Scans picking and confirms dispatch")
    Component(retailer_mobile, "Retailer Mobile", "Flutter", "Scans receipt and submits complaints")
}

Container_Boundary(api, "Backend API") {
    Component(fulfillment_endpoint, "Fulfillment Endpoints", ".NET", "Picking and dispatch commands")
    Component(delivery_endpoint, "Delivery Endpoints", ".NET", "Assignment and status commands")
    Component(receipt_endpoint, "Receipt and Complaint Endpoints", ".NET", "Idempotent QR receipt and complaint evidence")
}

Container_Boundary(application, "Application") {
    Component(picking, "Picking Service", ".NET", "Validates allocated batches, tags, warehouse, and complete quantity")
    Component(dispatch, "Dispatch Service", ".NET", "Consumes reservations and decreases physical stock exactly once")
    Component(delivery, "Delivery Service", ".NET", "Stores vehicle/person snapshots and delivery state")
    Component(receipt, "Receipt Confirmation Service", ".NET", "Validates retailer ownership and expected QR tags")
    Component(complaint, "Complaint Service", ".NET", "Records differences, evidence, review, and response without returns")
}

Container_Boundary(data, "Data and Evidence") {
    Component(repository, "Fulfillment Persistence", "EF Core", "Transactions, state history, idempotency, audit, and outbox")
    ContainerDb(postgres, "PostgreSQL", "Database")
    ContainerDb(storage, "Object Storage", "Evidence blobs")
}

Rel(warehouse_mobile, fulfillment_endpoint, "Scans pick/dispatch", "JSON/HTTPS")
Rel(operations_portal, delivery_endpoint, "Assigns and updates delivery", "JSON/HTTPS")
Rel(retailer_mobile, receipt_endpoint, "Confirms receipt/submits complaint", "JSON/HTTPS")
Rel(fulfillment_endpoint, picking, "Invokes")
Rel(fulfillment_endpoint, dispatch, "Invokes")
Rel(delivery_endpoint, delivery, "Invokes")
Rel(receipt_endpoint, receipt, "Invokes")
Rel(receipt_endpoint, complaint, "Invokes")
Rel(picking, repository, "Reads/writes")
Rel(dispatch, repository, "Consumes stock atomically")
Rel(delivery, repository, "Persists snapshots/state")
Rel(receipt, repository, "Persists idempotently")
Rel(complaint, repository, "Persists workflow")
Rel(complaint, storage, "Stores controlled evidence")
Rel(repository, postgres, "Reads/writes")
