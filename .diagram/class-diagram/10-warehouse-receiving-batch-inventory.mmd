classDiagram
direction LR

class Warehouse {
  -Id : Guid «PK»
  -Code : string
  -Name : string
  -Type : string
  -Address : string?
  -MinimumStockThresholdCartons : int
  -IsActive : bool
}

class GoodsReceipt {
  -Id : Guid «PK»
  -ReceiptCode : string «UK»
