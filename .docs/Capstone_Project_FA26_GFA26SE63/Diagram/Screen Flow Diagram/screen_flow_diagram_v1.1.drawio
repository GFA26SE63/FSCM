  <diagram name="Retailer App" id="Rg3VrA-keWCBa3-NX6Hz">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="edsnrresWStiblYMUJev-0" />
        <mxCell id="edsnrresWStiblYMUJev-1" parent="edsnrresWStiblYMUJev-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Retailer App - Screen Flow (prototype Prod) =====\n    %% Notation: beige = common screen | blue text = form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several tabs / sections\n\n    LOGIN[\&quot;Login\&quot;]:::common\n    NOTI[\&quot;Notifications\&quot;]:::common\n    MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    LOGIN --&gt; MAIN\n    MAIN --&gt;|bell| NOTI\n    MAIN -.-&gt;|Logout| LOGIN\n\n    %% ===== Tabs =====\n    MAIN --&gt; SCAN\n    MAIN --&gt; ORD_L\n    MAIN --&gt; ACC[\&quot;Account\&quot;]\n\n    subgraph SCAN[\&quot;Scan QR\&quot;]\n        direction TB\n        SCAN_1[\&quot;&lt;i&gt;Scan Parcel Label&lt;/i&gt;\&quot;]\n        SCAN_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n    end\n    class SCAN tab\n\n    %% ===== Orders &amp; receiving goods =====\n    subgraph ORD_L[\&quot;Orders List\&quot;]\n        direction TB\n        ORD_L_1[\&quot;&lt;i&gt;Points Summary&lt;/i&gt;\&quot;]\n        ORD_L_2[\&quot;&lt;i&gt;Best Sellers in Area&lt;/i&gt;\&quot;]\n        ORD_L_5[\&quot;&lt;i&gt;Debts &amp; Delivering Alerts&lt;/i&gt;\&quot;]\n        ORD_L_3[\&quot;&lt;i&gt;In Progress&lt;/i&gt;\&quot;]\n        ORD_L_4[\&quot;&lt;i&gt;Completed&lt;/i&gt;\&quot;]\n    end\n    class ORD_L tab\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_6[\&quot;&lt;i&gt;Warehouse Portions&lt;/i&gt;\&quot;]\n        ORD_D_1[\&quot;&lt;i&gt;Items &amp; Batches&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Price per Batch&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Promotions&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Payment &amp; Points&lt;/i&gt;\&quot;]\n        ORD_D_8[\&quot;&lt;i&gt;Complaints&lt;/i&gt;\&quot;]\n        ORD_D_4[\&quot;&lt;i&gt;Delivery Info&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    NOTI --&gt; ORD_D\n    subgraph RCV[\&quot;Receive Goods\&quot;]\n        direction TB\n        RCV_1[\&quot;&lt;i&gt;Scan Labels by Portion&lt;br/&gt;(camera or enter code)&lt;/i&gt;\&quot;]\n        RCV_2[\&quot;&lt;i&gt;Received / Damaged Qty per Portion&lt;/i&gt;\&quot;]\n        RCV_3[\&quot;&lt;i&gt;Shortage Result &amp; Amount on Hold&lt;/i&gt;\&quot;]\n    end\n    class RCV tab\n    ORD_D --&gt; RCV\n    SCAN --&gt;|parcel label of this store| RCV\n    RCV --&gt;|all portions confirmed| DONE[\&quot;Order Received\&quot;]\n    RCV --&gt;|portion with shortage| CMP[\&quot;Send Complaint\&quot;]:::form\n    ORD_D --&gt; CMP\n    CMP --&gt;|sent| ORD_D\n    DONE --&gt;|view order| ORD_D\n    DONE --&gt;|back to list| ORD_L\n\n    %% ===== Account &amp; loyalty =====\n    subgraph PAY[\&quot;Payments\&quot;]\n        direction TB\n        PAY_1[\&quot;&lt;i&gt;Paid by Period&lt;/i&gt;\&quot;]\n        PAY_2[\&quot;&lt;i&gt;Debts to Pay &amp; Disputed Amount&lt;/i&gt;\&quot;]\n        PAY_3[\&quot;&lt;i&gt;Refunds&lt;/i&gt;\&quot;]\n    end\n    class PAY tab\n    subgraph LOY[\&quot;Loyalty Points\&quot;]\n        direction TB\n        LOY_1[\&quot;&lt;i&gt;Available / Held / Pending Points&lt;/i&gt;\&quot;]\n        LOY_3[\&quot;&lt;i&gt;Redeem Gifts&lt;/i&gt;\&quot;]\n        LOY_4[\&quot;&lt;i&gt;My Gifts&lt;/i&gt;\&quot;]\n        LOY_5[\&quot;&lt;i&gt;Points History&lt;/i&gt;\&quot;]\n    end\n    class LOY tab\n    ACC --&gt; PAY\n    ACC --&gt; LOY\n    ORD_L --&gt; PAY\n    ORD_L --&gt; LOY\n    PAY --&gt;|open order| ORD_D\n    LOY --&gt;|redeem| RDM_C([\&quot;Confirm Redemption\&quot;])\n    RDM_C --&gt;|confirmed| LOY\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eE66y0fEDmxinkCnNLLI-0">
          <mxCell connectable="0" parent="edsnrresWStiblYMUJev-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
