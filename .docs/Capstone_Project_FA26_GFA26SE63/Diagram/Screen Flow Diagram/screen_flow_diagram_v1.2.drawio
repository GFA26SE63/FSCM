<mxfile host="app.diagrams.net" pages="4">
  <diagram id="wgiUZbiXALRk12Co15po" name="Web Portal">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Portal - Screen Flow (prototype Prod) =====\n    %% Notation: beige = common screen | blue text = create/edit form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several information tabs\n\n    LOGIN[\&quot;Login\&quot;]:::common\n    RESET[\&quot;Forgot Password\&quot;]:::common\n    RESET_SENT[\&quot;Check Email\&quot;]:::common\n    RESET_NP[\&quot;Set New Password\&quot;]:::form\n    NOTI([\&quot;Notifications\&quot;]):::common\n    POST[\&quot;&lt;b&gt;PostLogin&lt;/b&gt;\&quot;]\n    LOGIN --&gt; POST\n    LOGIN --&gt;|Forgot password| RESET\n    RESET --&gt;|send link| RESET_SENT\n    RESET_SENT --&gt;|open link in email| RESET_NP\n    RESET_NP --&gt;|password updated| LOGIN\n    LOGIN --&gt;|Microsoft Entra ID| MS_ACC([\&quot;Choose Microsoft Account\&quot;]):::common\n    MS_ACC --&gt;|role assigned| MS_WAIT[\&quot;Signing In\&quot;]:::common\n    MS_WAIT --&gt; POST\n    MS_ACC --&gt;|no FSCM role| MS_DENY[\&quot;Access Denied\&quot;]:::common\n    MS_DENY --&gt;|choose another account| MS_ACC\n    MS_DENY --&gt;|back| LOGIN\n    POST --&gt; NOTI\n    POST -.-&gt;|Logout| LOGIN\n\n    %% ===== Sales &amp; order operations =====\n    POST --&gt; DASH[\&quot;Dashboard\&quot;]\n    DASH --&gt;|click tile| ORD_L\n    POST --&gt; ORD_L[\&quot;Orders List\&quot;]\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_1[\&quot;&lt;i&gt;Order Info&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Products, Promos &amp; Expected Price&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Batch Allocation &amp; Price per Batch&lt;/i&gt;\&quot;]\n        ORD_D_4[\&quot;&lt;i&gt;Warehouse Portions &amp; Readiness&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Payments&lt;/i&gt;\&quot;]\n        ORD_D_6[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Cancel / Reject Evidence&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    ORD_D --&gt; REJ([\&quot;Reject / Cancel Order\&quot;])\n    ORD_D --&gt; TRACE([\&quot;Allocation Trace\&quot;])\n    ORD_D --&gt;|allocated| ASSIGN[\&quot;Assign Vehicle to Portion\&quot;]:::form\n    ORD_D --&gt;|dispatched| DELIV[\&quot;Start Delivery\&quot;]:::form\n    ORD_D --&gt;|prepaid / COD| PAY[\&quot;Record Payment\&quot;]:::form\n    ORD_D --&gt;|refund case| REF_D\n    ORD_L --&gt;|12:00 run button| RUN_L[\&quot;12:00 Allocation Runs\&quot;]\n    subgraph RUN_D[\&quot;Allocation Run Details\&quot;]\n        direction TB\n        RUN_D_1[\&quot;&lt;i&gt;Orders in Run&lt;/i&gt;\&quot;]\n        RUN_D_2[\&quot;&lt;i&gt;Batch &amp; Price Plan&lt;/i&gt;\&quot;]\n        RUN_D_3[\&quot;&lt;i&gt;Weighted vs Strict FEFO&lt;/i&gt;\&quot;]\n        RUN_D_4[\&quot;&lt;i&gt;Report by Warehouse&lt;/i&gt;\&quot;]\n        RUN_D_5[\&quot;&lt;i&gt;Version History&lt;/i&gt;\&quot;]\n    end\n    class RUN_D tab\n    RUN_L --&gt; RUN_D\n    RUN_D --&gt; RERUN[\&quot;Request Recalculation\&quot;]:::form\n    RUN_D --&gt; ORD_D\n    POST --&gt; DEBT_L[\&quot;Debts List\&quot;]\n    DEBT_L --&gt; ORD_D\n    DEBT_L --&gt;|record payment| COLLECT[\&quot;Collect Payment\&quot;]:::form\n    ORD_D --&gt;|deferred payment| COLLECT\n    DEBT_L --&gt;|Refunds tab| REF_L[\&quot;Refunds List\&quot;]\n    REF_L --&gt; REF_D[\&quot;Refund Details\&quot;]\n    REF_D --&gt; REF_TX[\&quot;Record Refund Transfer &amp; Evidence\&quot;]:::form\n    REF_D --&gt;|Admin| REF_RET[\&quot;Return Refund Request\&quot;]:::form\n    POST --&gt; PROMO_L[\&quot;Promotions List\&quot;]\n    PROMO_L --&gt; PROMO_D[\&quot;Promotion Details\&quot;]\n    PROMO_L --&gt; PROMO_F[\&quot;Create Promotion\&quot;]:::form\n    POST --&gt; RET_L[\&quot;Retailers List\&quot;]\n    subgraph RET_D[\&quot;Retailer / Declaration Details\&quot;]\n        direction TB\n        RET_D_1[\&quot;&lt;i&gt;General Info&lt;/i&gt;\&quot;]\n        RET_D_2[\&quot;&lt;i&gt;Shelf-life Requirements (MLOR)&lt;/i&gt;\&quot;]\n        RET_D_3[\&quot;&lt;i&gt;Debts&lt;/i&gt;\&quot;]\n    end\n    class RET_D tab\n    RET_L --&gt; RET_D\n    subgraph RET_F[\&quot;Add / Edit Retailer\&quot;]\n        direction TB\n        RET_F_1[\&quot;&lt;i&gt;General Info&lt;/i&gt;\&quot;]\n        RET_F_2[\&quot;&lt;i&gt;Location &amp; Status&lt;/i&gt;\&quot;]\n        RET_F_3[\&quot;&lt;i&gt;Potential &amp; Credit&lt;/i&gt;\&quot;]\n        RET_F_4[\&quot;&lt;i&gt;Admin Assessment &amp; Priority&lt;/i&gt;\&quot;]\n    end\n    class RET_F formTab\n    RET_L --&gt; RET_F\n    RET_D --&gt; RET_F\n    RET_D --&gt; MLOR_F[\&quot;Edit MLOR by Category / SKU\&quot;]:::form\n    RET_D --&gt;|declaration pending| RET_APV[\&quot;Approve &amp; Assess Potential\&quot;]:::form\n    RET_D --&gt;|declaration pending| RET_DREJ[\&quot;Reject Declaration\&quot;]:::form\n    RET_L --&gt; RET_IMP([\&quot;Import Retailers\&quot;])\n    POST --&gt; LOY_L[\&quot;Loyalty List\&quot;]\n    LOY_L --&gt; LOY_D[\&quot;Points &amp; History\&quot;]\n    POST --&gt; RDM_L[\&quot;Gift Redemption Requests\&quot;]\n    RDM_L --&gt; RW_L\n    POST --&gt; RW_L[\&quot;Gift Catalog\&quot;]\n    RW_L --&gt; RW_F[\&quot;Add / Edit Gift\&quot;]:::form\n    POST --&gt; REG_L[\&quot;Regions &amp; Sales Groups\&quot;]\n    REG_L --&gt; REG_D[\&quot;Group Details\&quot;]\n    subgraph GRP_F[\&quot;Add / Edit Sales Group\&quot;]\n        direction TB\n        GRP_F_1[\&quot;&lt;i&gt;Group Info&lt;/i&gt;\&quot;]\n        GRP_F_2[\&quot;&lt;i&gt;Members&lt;/i&gt;\&quot;]\n    end\n    class GRP_F formTab\n    REG_L --&gt; GRP_F\n    REG_D --&gt; GRP_F\n    REG_D --&gt; TRF_S[\&quot;Transfer Sales\&quot;]:::form\n    REG_L --&gt; AREA_F[\&quot;Create Region\&quot;]:::form\n    subgraph KPI_L[\&quot;KPI Sales List\&quot;]\n        direction TB\n        KPI_L_1[\&quot;&lt;i&gt;KPI Sales&lt;/i&gt;\&quot;]\n        KPI_L_2[\&quot;&lt;i&gt;Ranking&lt;/i&gt;\&quot;]\n        KPI_L_3[\&quot;&lt;i&gt;Best-selling Products&lt;/i&gt;\&quot;]\n        KPI_L_4[\&quot;&lt;i&gt;Group Orders&lt;/i&gt;\&quot;]\n        KPI_L_5[\&quot;&lt;i&gt;Group Retailers&lt;/i&gt;\&quot;]\n        KPI_L_6[\&quot;&lt;i&gt;Basic Report&lt;/i&gt;\&quot;]\n    end\n    class KPI_L tab\n    POST --&gt; KPI_L\n    KPI_L --&gt; KPI_D[\&quot;KPI Details\&quot;]\n    KPI_L --&gt; KPI_F[\&quot;KPI Targets &amp; Weights\&quot;]:::form\n    POST --&gt; CMP_L[\&quot;Complaints List\&quot;]\n    CMP_L --&gt; CMP_D[\&quot;Complaint Details\&quot;]\n    CMP_D --&gt;|Operator propose / Admin approve| KN_ACC[\&quot;Accept &amp; Adjust Amount\&quot;]:::form\n    CMP_D --&gt; KN_REJ[\&quot;Reject Complaint\&quot;]:::form\n    KN_ACC --&gt;|paid order| REF_D\n\n    %% ===== Warehouse &amp; master data =====\n    POST --&gt; PICK_L[\&quot;Picking List\&quot;]\n    subgraph PICK_D[\&quot;Picking Details\&quot;]\n        direction TB\n        PICK_D_1[\&quot;&lt;i&gt;Gather by Batch&lt;/i&gt;\&quot;]\n        PICK_D_2[\&quot;&lt;i&gt;Split per Order Line&lt;/i&gt;\&quot;]\n        PICK_D_3[\&quot;&lt;i&gt;Exceptions&lt;/i&gt;\&quot;]\n    end\n    class PICK_D tab\n    PICK_L --&gt; PICK_D\n    PICK_D_3 --&gt;|exception open| PICK_EXC[\&quot;Resolve Exception\&quot;]:::form\n    POST --&gt; RCPT_L[\&quot;Goods Receipts\&quot;]\n    RCPT_L --&gt; RCPT_D[\&quot;Receipt Details\&quot;]\n    RCPT_L --&gt; RCPT_F[\&quot;Create Receipt\&quot;]:::form\n    POST --&gt; BAT_L[\&quot;Batches List\&quot;]\n    subgraph BAT_D[\&quot;Batch Details\&quot;]\n        direction TB\n        BAT_D_1[\&quot;&lt;i&gt;Batch Info &amp; Stock&lt;/i&gt;\&quot;]\n        BAT_D_2[\&quot;&lt;i&gt;Locked Stock&lt;/i&gt;\&quot;]\n        BAT_D_3[\&quot;&lt;i&gt;Orders Holding Batch&lt;/i&gt;\&quot;]\n        BAT_D_4[\&quot;&lt;i&gt;History&lt;/i&gt;\&quot;]\n    end\n    class BAT_D tab\n    BAT_L --&gt; BAT_D\n    BAT_L --&gt; LOCK_F[\&quot;Lock Damaged / Expired Stock\&quot;]:::form\n    BAT_D --&gt; LOCK_F\n    BAT_D --&gt;|create disposal| DISP_F\n    POST --&gt; EXPD_L[\&quot;Expiry Discounts\&quot;]\n    EXPD_L --&gt; EXPD_F[\&quot;Add / Edit Discount Rule\&quot;]:::form\n    POST --&gt; DISP_L[\&quot;Expired Disposal\&quot;]\n    DISP_L --&gt; DISP_D[\&quot;Disposal Details\&quot;]\n    DISP_D --&gt;|Admin, pending| DISP_APV[\&quot;Approve Disposal\&quot;]:::form\n    DISP_D --&gt;|Admin, pending| DISP_REJ[\&quot;Reject Disposal\&quot;]:::form\n    DISP_L --&gt; DISP_F[\&quot;Create Disposal Record\&quot;]:::form\n    POST --&gt; CAT_L[\&quot;Category Tree\&quot;]\n    CAT_L --&gt; CAT_F[\&quot;Add / Edit Category\&quot;]:::form\n    POST --&gt; SKU_L[\&quot;Products (SKU)\&quot;]\n    SKU_L --&gt; SKU_D[\&quot;SKU Details\&quot;]\n    subgraph SKU_F[\&quot;Add / Edit SKU\&quot;]\n        direction TB\n        SKU_F_1[\&quot;&lt;i&gt;Product Info&lt;/i&gt;\&quot;]\n        SKU_F_2[\&quot;&lt;i&gt;Shelf Life &amp; MLOR&lt;/i&gt;\&quot;]\n    end\n    class SKU_F formTab\n    SKU_L --&gt; SKU_F\n    SKU_D --&gt;|Draft| SKU_F\n    SKU_D --&gt;|On sale: price locked| SKU_NEW[\&quot;Create New Version\&quot;]:::form\n    POST --&gt; WH_L[\&quot;Warehouses List\&quot;]\n    WH_L --&gt; WH_D[\&quot;Warehouse Details\&quot;]\n    WH_L --&gt; WH_MAP([\&quot;Warehouse Network Map\&quot;])\n    subgraph WH_F[\&quot;Add / Edit Warehouse\&quot;]\n        direction TB\n        WH_F_1[\&quot;&lt;i&gt;Warehouse Info + Map Picker&lt;/i&gt;\&quot;]\n        WH_F_2[\&quot;&lt;i&gt;Assignment&lt;/i&gt;\&quot;]\n    end\n    class WH_F formTab\n    WH_L --&gt; WH_F\n    WH_D --&gt; WH_F\n    POST --&gt; USR_L[\&quot;Users List\&quot;]\n    USR_L --&gt; USR_D[\&quot;User Details\&quot;]\n    subgraph USR_F[\&quot;Create / Edit User\&quot;]\n        direction TB\n        USR_F_1[\&quot;&lt;i&gt;Account Info&lt;/i&gt;\&quot;]\n        USR_F_2[\&quot;&lt;i&gt;Role Scope&lt;/i&gt;\&quot;]\n    end\n    class USR_F formTab\n    USR_L --&gt; USR_F\n    USR_D --&gt; USR_F\n    POST --&gt; CFG_L[\&quot;System Config\&quot;]\n    subgraph CFG_F[\&quot;Edit Config\&quot;]\n        direction TB\n        CFG_F_1[\&quot;&lt;i&gt;Allocation Algorithm&lt;/i&gt;\&quot;]\n        CFG_F_2[\&quot;&lt;i&gt;Cutoff &amp; Approval Reminders&lt;/i&gt;\&quot;]\n    end\n    class CFG_F formTab\n    CFG_L --&gt; CFG_F\n\n    %% ===== Notification deep links =====\n    NOTI -.-&gt;|pending order / order update| ORD_D\n    NOTI -.-&gt;|order blocked at dispatch| ORD_D\n    NOTI -.-&gt;|cutoff reminder| ORD_L\n    NOTI -.-&gt;|allocation plan pending| RUN_D\n    NOTI -.-&gt;|new declaration| RET_D\n    NOTI -.-&gt;|overdue debt| DEBT_L\n    NOTI -.-&gt;|refund pending| REF_D\n    NOTI -.-&gt;|new complaint| CMP_D\n    NOTI -.-&gt;|gift request| RDM_L\n    NOTI -.-&gt;|expired stock| DISP_L\n    NOTI -.-&gt;|disposal pending approval| DISP_D\n    NOTI -.-&gt;|picking pending| PICK_D\n    NOTI -.-&gt;|KPI updated| KPI_L\n    NOTI -.-&gt;|group missing Sales| REG_L\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="38gzEipAoTiK7GDyniop-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
