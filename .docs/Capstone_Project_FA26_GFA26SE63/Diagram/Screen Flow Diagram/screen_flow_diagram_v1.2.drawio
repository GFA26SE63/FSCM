  <diagram id="gmnCWpsz279sj34mXNzF" name="Sales App">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Sales App - Screen Flow (prototype Prod) =====\n    %% Notation: beige = common screen | blue text = create/edit form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several tabs / sections\n\n    LOGIN[\&quot;Login\&quot;]:::common\n    NOTI[\&quot;Notifications\&quot;]:::common\n    MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    LOGIN --&gt; MAIN\n    LOGIN --&gt;|Microsoft| MS_ACC[\&quot;Choose Microsoft Account\&quot;]:::common\n    MS_ACC --&gt;|Sales role| MS_WAIT[\&quot;Signing In\&quot;]:::common\n    MS_WAIT --&gt; MAIN\n    MS_ACC --&gt;|no Sales role| MS_DENY[\&quot;Access Denied\&quot;]:::common\n    MS_DENY --&gt;|choose another account| MS_ACC\n    MS_DENY --&gt;|back| LOGIN\n    MAIN --&gt;|bell| NOTI\n    MAIN -.-&gt;|Logout| LOGIN\n\n    %% ===== Tabs =====\n    MAIN --&gt; HOME\n    MAIN --&gt; ORD_L\n    MAIN --&gt; SYNC\n    MAIN --&gt; ACC[\&quot;Account\&quot;]\n\n    %% ===== Home =====\n    subgraph HOME[\&quot;Home\&quot;]\n        direction TB\n        HOME_0[\&quot;&lt;i&gt;Sync Status &amp; Overdue Debt Alert&lt;/i&gt;\&quot;]\n        HOME_1[\&quot;&lt;i&gt;Today&#39;s Orders &amp; Shortcuts&lt;/i&gt;\&quot;]\n        HOME_2[\&quot;&lt;i&gt;Priority Retailers&lt;/i&gt;\&quot;]\n        HOME_3[\&quot;&lt;i&gt;Best Sellers This Month&lt;/i&gt;\&quot;]\n        HOME_4[\&quot;&lt;i&gt;Latest Notifications&lt;/i&gt;\&quot;]\n    end\n    class HOME tab\n\n    %% ===== Create order =====\n    HOME --&gt;|create order| RET[\&quot;Select Retailer\&quot;]\n    HOME --&gt;|priority retailer| PROD\n    subgraph RET_D[\&quot;Retailer Details\&quot;]\n        direction TB\n        RET_D_1[\&quot;&lt;i&gt;General Info&lt;/i&gt;\&quot;]\n        RET_D_2[\&quot;&lt;i&gt;Shelf-life Requirements (MLOR)&lt;/i&gt;\&quot;]\n    end\n    class RET_D tab\n    RET --&gt; RET_D\n    RET_D --&gt;|order for this store| PROD\n    subgraph PROD[\&quot;Products\&quot;]\n        direction TB\n        PROD_1[\&quot;&lt;i&gt;All&lt;/i&gt;\&quot;]\n        PROD_2[\&quot;&lt;i&gt;Best Sellers&lt;/i&gt;\&quot;]\n    end\n    class PROD tab\n    PROD --&gt; CART[\&quot;Cart\&quot;] --&gt; PROMO_A[\&quot;Applied Promotions\&quot;] --&gt; CONF\n    subgraph CONF[\&quot;Confirm Order\&quot;]\n        direction TB\n        CONF_1[\&quot;&lt;i&gt;Delivery Info&lt;/i&gt;\&quot;]\n        CONF_6[\&quot;&lt;i&gt;Requested Receive Date&lt;/i&gt;\&quot;]\n        CONF_2[\&quot;&lt;i&gt;Products &amp; Expected Price&lt;/i&gt;\&quot;]\n        CONF_3[\&quot;&lt;i&gt;Applied Promotions&lt;/i&gt;\&quot;]\n        CONF_4[\&quot;&lt;i&gt;Payment Method&lt;/i&gt;\&quot;]\n        CONF_5[\&quot;&lt;i&gt;Expected Loyalty Points&lt;/i&gt;\&quot;]\n    end\n    class CONF formTab\n    CONF --&gt; RESULT[\&quot;Order Result\&quot;]\n    RESULT --&gt;|back home| HOME\n\n    %% ===== Orders &amp; sync =====\n    subgraph ORD_L[\&quot;Orders List\&quot;]\n        direction TB\n        ORD_L_1[\&quot;&lt;i&gt;In Progress&lt;/i&gt;\&quot;]\n        ORD_L_2[\&quot;&lt;i&gt;Completed&lt;/i&gt;\&quot;]\n    end\n    class ORD_L tab\n    subgraph SYNC[\&quot;Sync Queue\&quot;]\n        direction TB\n        SYNC_1[\&quot;&lt;i&gt;Pending Sync&lt;/i&gt;\&quot;]\n        SYNC_2[\&quot;&lt;i&gt;Syncing&lt;/i&gt;\&quot;]\n        SYNC_3[\&quot;&lt;i&gt;Synced&lt;/i&gt;\&quot;]\n    end\n    class SYNC tab\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_1[\&quot;&lt;i&gt;Retailer &amp; Time&lt;/i&gt;\&quot;]\n        ORD_D_6[\&quot;&lt;i&gt;Processing Steps&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Products&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Price &amp; Promotions&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Warehouse Portions&lt;/i&gt;\&quot;]\n        ORD_D_4[\&quot;&lt;i&gt;Payment&lt;/i&gt;\&quot;]\n        ORD_D_8[\&quot;&lt;i&gt;Shortage / Complaint&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    SYNC --&gt; ORD_D\n    RESULT --&gt;|view order| ORD_D\n    NOTI --&gt; ORD_D\n    ORD_D --&gt;|price per batch| PRICE_D[\&quot;Batch Price Details\&quot;]\n    ORD_D --&gt;|shortage: new order| PROD\n\n    %% ===== Account &amp; shortcuts =====\n    ACC --&gt; MYS[\&quot;My Sales\&quot;]\n    ACC --&gt; PRM_L[\&quot;Active Promotions\&quot;]\n    ACC --&gt; RANK\n    ACC --&gt; DEBT[\&quot;Debts to Collect\&quot;]\n    ACC --&gt; DCL_L[\&quot;Retailer Declarations\&quot;]\n    HOME --&gt; MYS &amp; PRM_L &amp; RANK &amp; DEBT &amp; DCL_L\n    HOME --&gt; SYNC\n    HOME --&gt;|see all| NOTI\n    MYS --&gt; ORD_D\n    PRM_L --&gt; PRM_D[\&quot;Promotion Details\&quot;]\n    subgraph RANK[\&quot;KPI &amp; Ranking\&quot;]\n        direction TB\n        RANK_0[\&quot;&lt;i&gt;My KPI&lt;/i&gt;\&quot;]\n        RANK_1[\&quot;&lt;i&gt;Sales&lt;/i&gt;\&quot;]\n        RANK_2[\&quot;&lt;i&gt;Best-selling Products&lt;/i&gt;\&quot;]\n    end\n    class RANK tab\n    HOME --&gt;|best sellers| RANK\n    NOTI --&gt; DEBT\n    subgraph DCL_D[\&quot;Declaration Details\&quot;]\n        direction TB\n        DCL_D_1[\&quot;&lt;i&gt;Store Info&lt;/i&gt;\&quot;]\n        DCL_D_2[\&quot;&lt;i&gt;Potential &amp; Admin Assessment&lt;/i&gt;\&quot;]\n        DCL_D_3[\&quot;&lt;i&gt;Shelf-life Requirements (Category / SKU)&lt;/i&gt;\&quot;]\n        DCL_D_4[\&quot;&lt;i&gt;Survey Photos &amp; Notes&lt;/i&gt;\&quot;]\n        DCL_D_5[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n    end\n    class DCL_D tab\n    subgraph DCL_F[\&quot;New Retailer Declaration\&quot;]\n        direction TB\n        DCL_F_1[\&quot;&lt;i&gt;Tab 1 – General Info:&lt;br/&gt;Store Info &amp; Location, Survey Photos,&lt;br/&gt;Potential Assessment, Survey Notes&lt;/i&gt;\&quot;]\n        DCL_F_2[\&quot;&lt;i&gt;Tab 2 – Shelf-life Requirements&lt;br/&gt;(MLOR by Category / SKU)&lt;/i&gt;\&quot;]\n    end\n    class DCL_F formTab\n    DCL_L --&gt; DCL_D\n    DCL_L --&gt; DCL_F\n    DCL_D --&gt;|approved: order for this store| PROD\n    DCL_F_1 --&gt; MAP([\&quot;Map Picker\&quot;])\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Q5G47zjXL_91k2nDmHXN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
