  <diagram name="Warehouse App" id="JzO-NCmISSQS0NL6OW_8">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="KzWuF-mWxIEZnyy0Ls85-0" />
        <mxCell id="KzWuF-mWxIEZnyy0Ls85-1" parent="KzWuF-mWxIEZnyy0Ls85-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Warehouse App - Screen Flow (prototype Prod) =====\n    %% Notation: beige = common screen | blue text = form\n    %%           subgraph = screen with several tabs / sections\n\n    LOGIN[\&quot;Login\&quot;]:::common\n    NOTI[\&quot;Notifications\&quot;]:::common\n    MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    LOGIN --&gt; MAIN\n    LOGIN --&gt;|Microsoft| MS_ACC[\&quot;Choose Microsoft Account\&quot;]:::common\n    MS_ACC --&gt;|Warehouse Keeper role| MS_WAIT[\&quot;Signing In\&quot;]:::common\n    MS_WAIT --&gt; MAIN\n    MS_ACC --&gt;|no Warehouse Keeper role| MS_DENY[\&quot;Access Denied\&quot;]:::common\n    MS_DENY --&gt;|choose another account| MS_ACC\n    MS_DENY --&gt;|back| LOGIN\n    MAIN --&gt;|bell| NOTI\n    MAIN -.-&gt;|Logout| LOGIN\n\n    %% ===== Tabs =====\n    MAIN --&gt; HOME\n    MAIN --&gt; PICK_L\n    MAIN --&gt; SCAN\n    MAIN --&gt; RCV\n    MAIN --&gt; ACC[\&quot;Account\&quot;]\n\n    %% ===== Home =====\n    subgraph HOME[\&quot;Home\&quot;]\n        direction TB\n        HOME_1[\&quot;&lt;i&gt;Picking Summary&lt;/i&gt;\&quot;]\n        HOME_2[\&quot;&lt;i&gt;Shortcuts&lt;/i&gt;\&quot;]\n        HOME_3[\&quot;&lt;i&gt;Portions to Pick&lt;/i&gt;\&quot;]\n    end\n    class HOME tab\n    HOME --&gt;|see all| PICK_L\n    HOME --&gt;|receive goods| RCV\n    HOME --&gt;|label lookup| SCAN\n\n    %% ===== Picking &amp; shipping =====\n    subgraph PICK_L[\&quot;Picking List\&quot;]\n        direction TB\n        PICK_L_0[\&quot;&lt;i&gt;Picking Slips by Run&lt;/i&gt;\&quot;]\n        PICK_L_1[\&quot;&lt;i&gt;All&lt;/i&gt;\&quot;]\n        PICK_L_2[\&quot;&lt;i&gt;Not Picked&lt;/i&gt;\&quot;]\n        PICK_L_3[\&quot;&lt;i&gt;Picking&lt;/i&gt;\&quot;]\n        PICK_L_5[\&quot;&lt;i&gt;Ready&lt;/i&gt;\&quot;]\n        PICK_L_4[\&quot;&lt;i&gt;Shipped&lt;/i&gt;\&quot;]\n    end\n    class PICK_L tab\n    subgraph SLIP[\&quot;Picking Slip Details\&quot;]\n        direction TB\n        SLIP_1[\&quot;&lt;i&gt;Run &amp; Progress&lt;/i&gt;\&quot;]\n        SLIP_2[\&quot;&lt;i&gt;Gather by Batch&lt;/i&gt;\&quot;]\n        SLIP_3[\&quot;&lt;i&gt;Split per Order (Batch Price Codes)&lt;/i&gt;\&quot;]\n    end\n    class SLIP tab\n    subgraph PICK_D[\&quot;Picking Details\&quot;]\n        direction TB\n        PICK_D_1[\&quot;&lt;i&gt;Order &amp; Progress&lt;/i&gt;\&quot;]\n        PICK_D_3[\&quot;&lt;i&gt;Order Readiness &amp; Block Reasons&lt;/i&gt;\&quot;]\n        PICK_D_2[\&quot;&lt;i&gt;Pick Lines&lt;/i&gt;\&quot;]\n        PICK_D_4[\&quot;&lt;i&gt;Dispatch Conditions&lt;/i&gt;\&quot;]\n    end\n    class PICK_D tab\n    subgraph LBL[\&quot;Print Labels\&quot;]\n        direction TB\n        LBL_1[\&quot;&lt;i&gt;Picked Label&lt;/i&gt;\&quot;]\n        LBL_2[\&quot;&lt;i&gt;Source Label Left&lt;/i&gt;\&quot;]\n    end\n    class LBL tab\n    PICK_L --&gt;|slip| SLIP\n    SLIP --&gt;|order line| PICK_D\n    HOME --&gt; PICK_D\n    PICK_L --&gt; PICK_D\n    NOTI --&gt; SLIP\n    PICK_D --&gt;|pick a line| SRC\n    subgraph SRC[\&quot;Scan Source Label\&quot;]\n        direction TB\n        SRC_1[\&quot;&lt;i&gt;Scan Label&lt;/i&gt;\&quot;]\n        SRC_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n    end\n    class SRC tab\n    SRC --&gt;|wrong batch / duplicate / locked: blocked| SRC\n    SRC --&gt;|right batch| QTY[\&quot;Confirm Quantity\&quot;]:::form\n    QTY --&gt;|take whole label or split| LBL\n    LBL --&gt;|next line| SRC\n    LBL --&gt;|all lines picked| PICK_D\n    PICK_D --&gt;|shortage / damaged / wrong label| EXC[\&quot;Report Exception\&quot;]:::form\n    SRC --&gt;|report exception| EXC\n    EXC --&gt;|sent| PICK_D\n    PICK_D --&gt;|confirm picked: server confirms Ready| PICK_D\n    PICK_D --&gt;|confirm portion dispatch| SHIP[\&quot;Shipped\&quot;]\n    SHIP --&gt;|back to slip| SLIP\n\n    %% ===== Label lookup =====\n    subgraph SCAN[\&quot;Scan QR\&quot;]\n        direction TB\n        SCAN_1[\&quot;&lt;i&gt;Scan Any Label&lt;/i&gt;\&quot;]\n        SCAN_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n        SCAN_3[\&quot;&lt;i&gt;Recent Lookups&lt;/i&gt;\&quot;]\n    end\n    class SCAN tab\n    subgraph LOOK[\&quot;Label Lookup\&quot;]\n        direction TB\n        LOOK_1[\&quot;&lt;i&gt;Label Info&lt;/i&gt;\&quot;]\n        LOOK_2[\&quot;&lt;i&gt;Parent / Child Labels&lt;/i&gt;\&quot;]\n        LOOK_3[\&quot;&lt;i&gt;Label History&lt;/i&gt;\&quot;]\n        LOOK_4[\&quot;&lt;i&gt;Reprint / Lock Damaged / Request Write-off&lt;/i&gt;\&quot;]\n    end\n    class LOOK tab\n    SCAN --&gt;|any label| LOOK\n    HOME --&gt;|expired stock| LOOK\n    NOTI --&gt; LOOK\n\n    %% ===== Goods receipt =====\n    subgraph RCV[\&quot;Receive Goods\&quot;]\n        direction TB\n        RCV_1[\&quot;&lt;i&gt;Supplier Document&lt;/i&gt;\&quot;]\n        RCV_2[\&quot;&lt;i&gt;SKU, Product Name, Production &amp; Expiry Date&lt;/i&gt;\&quot;]\n        RCV_3[\&quot;&lt;i&gt;Quantity, Batch ID &amp; Production Lot&lt;/i&gt;\&quot;]\n        RCV_4[\&quot;&lt;i&gt;Split into Labels&lt;/i&gt;\&quot;]\n    end\n    class RCV formTab\n    RCV --&gt;|save &amp; print| RCVD[\&quot;Goods Received\&quot;]\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ShIeNnFizJrvYwTCa_yq-0">
          <mxCell connectable="0" parent="KzWuF-mWxIEZnyy0Ls85-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Receive Goods" mermaidId="n:RCV" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=default;strokeColor=#111111;fontColor=#1F3FD1;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Receive Goods" id="l5I2g1e5nak5muVLLzsO-0">
          <mxCell parent="ShIeNnFizJrvYwTCa_yq-0" style="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=default;strokeColor=#111111;fontColor=#1F3FD1;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="270" width="376" x="638" y="2434" as="geometry" />
          </mxCell>
