        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass ExpirySweepRun {\n  -Id : Guid «PK»\n  -BusinessDate : DateOnly\n  -Status : string\n  -BatchesScanned : int\n  -StatusesUpdated : int\n  -BatchesExpired : int\n  -Error : string?\n  -StartedAt : DateTimeOffset\n  -CompletedAt : DateTimeOffset?\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -BatchCode : string «UK»\n  -Quantity : decimal\n  -ExpirationDate : DateOnly\n  -ExpiryStatus : string\n  -StockStatus : string\n  -Version : int\n}\n\nclass InventoryBalance {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK, UK»\n  -PhysicalQuantity : decimal\n  -ReservedQuantity : decimal\n  -AvailableQuantity : decimal\n  -Version : int\n  -UpdatedAt : DateTimeOffset\n}\n\nclass InventoryLock {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -LockedQuantity : decimal\n  -Status : string\n  -Reason : string\n  -RequiresResolution : bool\n  -LockedByUserId : Guid? «FK»\n  -ReleasedByUserId : Guid? «REF»\n  -ReleasedAt : DateTimeOffset?\n  -Note : string?\n  -Version : int\n}\n\nclass WriteOff {\n  -Id : Guid «PK»\n  -WriteOffCode : string «UK»\n  -WarehouseId : Guid «FK»\n  -CreatedByUserId : Guid «FK»\n  -Status : string\n  -Reason : string?\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass WriteOffItem {\n  -Id : Guid «PK»\n  -WriteOffId : Guid «FK»\n  -BatchId : Guid «FK»\n  -Quantity : decimal\n  -Reason : string?\n  -CreatedAt : DateTimeOffset\n}\n\nclass InventoryTransaction {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -TransactionType : string\n  -SourceType : string\n  -SourceId : Guid «REF»\n  -PhysicalQuantityDelta : decimal\n  -ReservedQuantityDelta : decimal\n  -PhysicalQuantityAfter : decimal\n  -ReservedQuantityAfter : decimal\n  -AvailableQuantityAfter : decimal\n  -OccurredAt : DateTimeOffset\n}\n\nclass OutboxMessage {\n  -Id : Guid «PK»\n  -EventType : string\n  -AggregateType : string\n  -AggregateId : Guid «REF»\n  -Payload : json\n  -Status : string\n  -RetryCount : int\n  -ProcessedAt : DateTimeOffset?\n}\n\nclass Notification {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -OutboxMessageId : Guid? «FK»\n  -Type : string\n  -Title : string\n  -Message : string\n  -IsRead : bool\n  -CreatedAt : DateTimeOffset\n}\n\nclass Warehouse {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -Sku : string\n  -Name : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nExpirySweepRun ..&gt; Batch : scans and updates\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : stores\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : product lots\nBatch \&quot;1\&quot; *-- \&quot;1\&quot; InventoryBalance : balance\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; InventoryLock : blocked quantity\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; InventoryLock : lock location\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; InventoryLock : locked product\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; InventoryLock : creates lock\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; WriteOff : disposal documents\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; WriteOff : creates\nWriteOff \&quot;1\&quot; *-- \&quot;1..*\&quot; WriteOffItem : items\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; WriteOffItem : reduces stock\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; InventoryTransaction : stock ledger\nExpirySweepRun ..&gt; OutboxMessage : emits expiry event\nOutboxMessage \&quot;0..1\&quot; -- \&quot;0..*\&quot; Notification : dispatch source\nUserAccount \&quot;1\&quot; *-- \&quot;0..*\&quot; Notification : recipient\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0XmmVsrxMhLms1v8LpoV-1">
