        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass RunPickingList {\n  -Id : Guid «PK»\n  -PickingCode : string «UK»\n  -AllocationRunId : Guid «FK»\n  -AllocationPlanVersionId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -Status : string\n  -IssuedAt : DateTimeOffset\n  -CompletedAt : DateTimeOffset?\n  -ExceptionType : string?\n  -ExceptionNote : string?\n  -Version : int\n}\n\nclass RunPickingGather {\n  -Id : Guid «PK»\n  -RunPickingListId : Guid «FK»\n  -BatchId : Guid «FK»\n  -RequiredQuantity : decimal\n  -PickedQuantity : decimal\n  -Status : string\n}\n\nclass RunPickingSplit {\n  -Id : Guid «PK»\n  -RunPickingGatherId : Guid «FK»\n  -AllocationRunAllocationId : Guid «FK, UK»\n  -AllocationPlanPriceId : Guid «FK»\n  -SalesOrderId : Guid «REF»\n  -SalesOrderLineId : Guid «REF»\n  -Quantity : decimal\n  -PickedQuantity : decimal\n}\n\nclass Shipment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -RunPickingListId : Guid «FK»\n  -ShipmentCode : string «UK»\n  -Status : string\n  -DriverId : Guid? «FK»\n  -VehicleId : Guid? «FK»\n  -TotalQuantity : decimal\n  -ReceivedQuantity : decimal\n  -ReadyAt : DateTimeOffset?\n  -IssuedAt : DateTimeOffset?\n  -AssignedAt : DateTimeOffset?\n  -DispatchedAt : DateTimeOffset?\n  -ReceivedAt : DateTimeOffset?\n  -ExceptionReason : string?\n  -Version : int\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -Status : string\n  -PaymentMethod : string\n  -Version : int\n}\n\nclass Payment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -Status : string\n  -AdjustedAmount : decimal\n  -ConfirmedAmount : decimal\n}\n\nclass Driver {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -Code : string\n  -FullName : string\n  -IsActive : bool\n}\n\nclass Vehicle {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -PlateNumber : string\n  -Capacity : decimal\n  -IsActive : bool\n}\n\nclass ReceiptConfirmation {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ShipmentId : Guid? «FK, UK»\n  -ConfirmedByRetailerUserId : Guid «FK»\n  -Status : string\n  -ConfirmedAt : DateTimeOffset\n}\n\nclass OrderShipmentReadinessResult {\n  +SalesOrderId : Guid\n  +OrderCode : string\n  +IsReady : bool\n  +PaymentSettled : bool\n  +HasException : bool\n  +BlockingReasons : List~string~\n  +Parts : List~ShipmentReadinessPartResult~\n}\n\nclass ShipmentReadinessPartResult {\n  +ShipmentId : Guid?\n  +ShipmentCode : string?\n  +WarehouseId : Guid\n  +WarehouseCode : string\n  +Status : string\n  +ExceptionReason : string?\n}\n\nRunPickingList \&quot;1\&quot; *-- \&quot;1..*\&quot; RunPickingGather : gather work\nRunPickingGather \&quot;1\&quot; *-- \&quot;1..*\&quot; RunPickingSplit : order portions\nRunPickingList \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : produces when ready\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : all-or-nothing parts\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : readiness condition\nDriver \&quot;0..1\&quot; -- \&quot;0..*\&quot; Shipment : dispatch assignment\nVehicle \&quot;0..1\&quot; -- \&quot;0..*\&quot; Shipment : dispatch assignment\nShipment \&quot;0..1\&quot; -- \&quot;0..1\&quot; ReceiptConfirmation : receipt outcome\nSalesOrder ..&gt; OrderShipmentReadinessResult : evaluates\nPayment ..&gt; OrderShipmentReadinessResult : settlement gate\nRunPickingList ..&gt; ShipmentReadinessPartResult : picking state\nShipment ..&gt; ShipmentReadinessPartResult : part state\nOrderShipmentReadinessResult \&quot;1\&quot; *-- \&quot;1..*\&quot; ShipmentReadinessPartResult : parts\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jaUY3BQXuV5oWoTS-fMd-1">
