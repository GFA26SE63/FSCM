        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass AllocationRun {\n  -Id : Guid «PK»\n  -RunCode : string «UK»\n  -BusinessDate : DateOnly «UK»\n  -CutoffAt : DateTimeOffset\n  -Status : string\n  -AlgorithmSettings : json\n  -TransitTableVersion : int\n  -EtaScheduleVersion : int\n  -OrderCount : int\n  -FailureReason : string?\n  -StartedAt : DateTimeOffset\n  -SnapshotCompletedAt : DateTimeOffset?\n  -CompletedAt : DateTimeOffset?\n  -Version : int\n}\n\nclass AllocationRunOrder {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -SalesOrderId : Guid «FK»\n  -OrderCodeSnapshot : string\n  -RetailerId : Guid «REF»\n  -AcceptedAt : DateTimeOffset\n  -DeliveryDeadline : DateOnly?\n  -PriorityRank : int\n  -Status : string\n  -ShortageReason : string?\n}\n\nclass AllocationRunLine {\n  -Id : Guid «PK»\n  -AllocationRunOrderId : Guid «FK»\n  -SalesOrderLineId : Guid «FK»\n  -ProductId : Guid «REF»\n  -SkuSnapshot : string\n  -OrderedQuantity : decimal\n  -TotalShelfLifeHours : int\n  -EffectiveMlorRatio : decimal\n  -MlorSource : string\n  -AllocatedQuantity : decimal\n}\n\nclass AllocationRunStock {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «REF»\n  -ProductId : Guid «REF»\n  -ExpirationDate : DateOnly\n  -SnapshotQuantity : decimal\n  -RemainingQuantity : decimal\n  -InventoryVersion : int\n}\n\nclass AllocationPlanVersion {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -VersionNumber : int\n  -Status : string\n  -PricedAt : DateTimeOffset\n  -FulfilledOrderCount : int\n  -ShortOrderCount : int\n  -TotalFinalAmount : decimal\n  -ApprovedByUserId : Guid? «FK»\n  -ApprovedAt : DateTimeOffset?\n  -RecalculationRequestedByUserId : Guid? «REF»\n  -RecalculationRequestedAt : DateTimeOffset?\n  -RecalculationReason : string?\n  -Version : int\n}\n\nclass AllocationRunAllocation {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -AllocationPlanVersionId : Guid «FK»\n  -AllocationRunLineId : Guid «FK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «REF»\n  -Quantity : decimal\n  -Sequence : int\n  -EstimatedArrivalAt : DateTimeOffset\n  -RemainingShelfLifeHours : decimal\n  -WeightedScore : decimal\n}\n\nclass Reservation {\n  -Id : Guid «PK»\n  -AllocationId : Guid? «FK, UK»\n  -AllocationRunAllocationId : Guid? «FK, UK»\n  -BatchId : Guid «FK»\n  -Quantity : decimal\n  -Status : string\n  -ReservedAt : DateTimeOffset\n  -ReleasedAt : DateTimeOffset?\n  -ConsumedAt : DateTimeOffset?\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -BatchCode : string\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -ExpirationDate : DateOnly\n  -Version : int\n}\n\nclass InventoryBalance {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK, UK»\n  -PhysicalQuantity : decimal\n  -ReservedQuantity : decimal\n  -AvailableQuantity : decimal\n  -Version : int\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -Status : string\n  -ServerReceivedAt : DateTimeOffset\n  -Version : int\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nAllocationRun \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunOrder : order snapshot\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunOrder : included order\nAllocationRunOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; AllocationRunLine : line snapshot\nAllocationRun \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunStock : frozen pool\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunStock : pool batch\nBatch \&quot;1\&quot; *-- \&quot;1\&quot; InventoryBalance : authoritative balance\nAllocationRun \&quot;1\&quot; *-- \&quot;1..*\&quot; AllocationPlanVersion : proposals\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; AllocationPlanVersion : approves\nAllocationPlanVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunAllocation : plan fragments\nAllocationRunLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunAllocation : fulfilled by\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunAllocation : chosen batch\nAllocationRunAllocation \&quot;1\&quot; -- \&quot;0..1\&quot; Reservation : reserves on approval\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation : held stock\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ltz2UIJS9DbMJH7_jVs_-1">
