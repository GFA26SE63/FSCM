        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Delivery {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -DriverId : Guid «FK»\n  -VehicleId : Guid «FK»\n  -OperationKey : string «UK»\n  -Status : string\n  -DriverCodeSnapshot : string\n  -DriverNameSnapshot : string\n  -DriverPhoneSnapshot : string\n  -DriverLicenseSnapshot : string\n  -PlateNumberSnapshot : string\n  -VehicleTypeSnapshot : string\n  -Version : int\n  -AssignedAt : DateTimeOffset\n  -DispatchedAt : DateTimeOffset?\n  -DeliveredAt : DateTimeOffset?\n  -Note : string?\n}\n\nclass Driver {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -Code : string «UK»\n  -FullName : string\n  -Phone : string\n  -LicenseNumber : string\n  -IsActive : bool\n}\n\nclass Vehicle {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -PlateNumber : string «UK»\n  -VehicleType : string\n  -Capacity : decimal\n  -IsActive : bool\n}\n\nclass Warehouse {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Type : string\n  -IsActive : bool\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string «UK»\n  -RetailerId : Guid «FK»\n  -DeliveryAddress : string\n  -RequestedDeliveryDate : DateOnly?\n  -Status : string\n  -Version : int\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Address : string?\n}\n\nclass Shipment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -RunPickingListId : Guid «FK»\n  -ShipmentCode : string «UK»\n  -Status : string\n  -DriverId : Guid? «FK»\n  -VehicleId : Guid? «FK»\n  -TotalQuantity : decimal\n  -ReceivedQuantity : decimal\n  -AssignedAt : DateTimeOffset?\n  -IssuedAt : DateTimeOffset?\n  -DispatchedAt : DateTimeOffset?\n  -ReceivedAt : DateTimeOffset?\n  -ExceptionReason : string?\n  -Version : int\n}\n\nclass ReceiptConfirmation {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ShipmentId : Guid? «FK, UK»\n  -ConfirmedByRetailerUserId : Guid «FK»\n  -OperationKey : string «UK»\n  -Status : string\n  -ConfirmedAt : DateTimeOffset\n  -Note : string?\n}\n\nclass MapLocation {\n  -Id : Guid «PK»\n  -WarehouseId : Guid? «FK»\n  -RetailerId : Guid? «FK»\n  -Latitude : decimal\n  -Longitude : decimal\n  -Version : int\n}\n\nclass MapDistanceCache {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -RetailerId : Guid «FK»\n  -OriginLocationId : Guid «FK»\n  -DestinationLocationId : Guid «FK»\n  -OriginLocationVersion : int\n  -DestinationLocationVersion : int\n  -DistanceMeters : int\n  -DurationSeconds : int\n  -Provider : string\n  -ProviderStatus : string\n  -Version : int\n  -CalculatedAt : DateTimeOffset\n  -ExpiresAt : DateTimeOffset\n  -IsActive : bool\n}\n\nWarehouse \&quot;1\&quot; *-- \&quot;0..*\&quot; Driver : drivers\nWarehouse \&quot;1\&quot; *-- \&quot;0..*\&quot; Vehicle : fleet\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Delivery : legacy order delivery\nDriver \&quot;1\&quot; -- \&quot;0..*\&quot; Delivery : assigned driver\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; Delivery : assigned vehicle\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : warehouse parts\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : receives orders\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : ships from\nDriver \&quot;0..1\&quot; -- \&quot;0..*\&quot; Shipment : assigned driver\nVehicle \&quot;0..1\&quot; -- \&quot;0..*\&quot; Shipment : assigned vehicle\nShipment \&quot;0..1\&quot; -- \&quot;0..1\&quot; ReceiptConfirmation : receipt\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmation : order receipts\nWarehouse \&quot;0..1\&quot; -- \&quot;0..1\&quot; MapLocation : geocode\nRetailer \&quot;0..1\&quot; -- \&quot;0..1\&quot; MapLocation : geocode\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; MapDistanceCache : origin warehouse\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; MapDistanceCache : destination retailer\nMapLocation \&quot;1\&quot; -- \&quot;0..*\&quot; MapDistanceCache : origin or destination\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="3LHjn8kt3ks0N-ncpf61-1">
