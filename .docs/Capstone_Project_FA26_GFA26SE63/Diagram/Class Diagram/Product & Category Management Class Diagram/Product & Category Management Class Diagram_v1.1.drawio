        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass ProductCategory {\n  -Id : Guid «PK»\n  -ParentCategoryId : Guid? «FK»\n  -Code : string «UK»\n  -Name : string\n  -Description : string?\n  -IsActive : bool\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -ProductCategoryId : Guid «FK»\n  -ReplacesProductId : Guid? «FK, UK»\n  -Sku : string «UK»\n  -Name : string\n  -Unit : string\n  -ShelfLifeHours : int\n  -NearDateThresholdHours : int\n  -Status : string\n  -PublishedAt : DateTimeOffset?\n  -InactivatedAt : DateTimeOffset?\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass ProductPrice {\n  -Id : Guid «PK»\n  -ProductId : Guid «FK»\n  -UnitPrice : decimal\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n  -CreatedAt : DateTimeOffset\n}\n\nclass GoodsReceiptLine {\n  -Id : Guid «PK»\n  -GoodsReceiptId : Guid «FK»\n  -ProductId : Guid «FK»\n  -ReceivedQuantity : decimal\n  -ProductionDate : DateOnly\n  -ExpirationDate : DateOnly\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -ProductId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -BatchCode : string «UK»\n  -Quantity : decimal\n  -ExpirationDate : DateOnly\n  -ExpiryStatus : string\n  -StockStatus : string\n}\n\nclass PromotionProduct {\n  -Id : Guid «PK»\n  -PromotionId : Guid «FK»\n  -ProductId : Guid «FK»\n}\n\nclass PromotionCategory {\n  -Id : Guid «PK»\n  -PromotionId : Guid «FK»\n  -ProductCategoryId : Guid «FK»\n}\n\nclass RetailerProductMlor {\n  -Id : Guid «PK»\n  -RetailerId : Guid «FK»\n  -ProductCategoryId : Guid? «FK»\n  -ProductId : Guid? «FK»\n  -MinimumLifeRatio : decimal\n  -Version : int\n  -IsActive : bool\n}\n\nProductCategory \&quot;0..1\&quot; -- \&quot;0..*\&quot; ProductCategory : parent category\nProductCategory \&quot;1\&quot; *-- \&quot;0..*\&quot; Product : classifies\nProduct \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Product : replaces\nProduct \&quot;1\&quot; *-- \&quot;0..*\&quot; ProductPrice : price history\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; GoodsReceiptLine : received product\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : inventory batches\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; PromotionProduct : promotion scope\nProductCategory \&quot;1\&quot; -- \&quot;0..*\&quot; PromotionCategory : promotion scope\nProduct \&quot;0..1\&quot; -- \&quot;0..*\&quot; RetailerProductMlor : SKU MLOR\nProductCategory \&quot;0..1\&quot; -- \&quot;0..*\&quot; RetailerProductMlor : category MLOR\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Fm9BuLYRc379jIERnOSr-1">
