        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass RunPickingList {\n  -Id : Guid «PK»\n  -PickingCode : string «UK»\n  -AllocationRunId : Guid «FK»\n  -AllocationPlanVersionId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -AssignedToUserId : Guid? «REF»\n  -Status : string\n  -IssuedAt : DateTimeOffset\n  -StartedAt : DateTimeOffset?\n  -CompletedAt : DateTimeOffset?\n  -ExceptionType : string?\n  -ExceptionNote : string?\n  -CompletedByUserId : Guid? «FK»\n  -Version : int\n}\n\nclass RunPickingGather {\n  -Id : Guid «PK»\n  -RunPickingListId : Guid «FK»\n  -ProductId : Guid «REF»\n  -SkuSnapshot : string\n  -BatchId : Guid «FK»\n  -BatchCodeSnapshot : string\n  -RequiredQuantity : decimal\n  -PickedQuantity : decimal\n  -Status : string\n}\n\nclass RunPickingSplit {\n  -Id : Guid «PK»\n  -RunPickingGatherId : Guid «FK»\n  -AllocationRunAllocationId : Guid «FK, UK»\n  -AllocationRunLineId : Guid «REF»\n  -AllocationPlanPriceId : Guid «FK»\n  -SalesOrderId : Guid «REF»\n  -SalesOrderLineId : Guid «REF»\n  -OrderCodeSnapshot : string\n  -Quantity : decimal\n  -PickedQuantity : decimal\n}\n\nclass Shipment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -RunPickingListId : Guid «FK»\n  -ShipmentCode : string «UK»\n  -Status : string\n  -DriverId : Guid? «FK»\n  -VehicleId : Guid? «FK»\n  -TotalQuantity : decimal\n  -ReceivedQuantity : decimal\n  -ReadyAt : DateTimeOffset?\n  -IssuedAt : DateTimeOffset?\n  -DispatchedAt : DateTimeOffset?\n  -ReceivedAt : DateTimeOffset?\n  -ExceptionReason : string?\n  -Version : int\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -Status : string\n  -FinalAmount : decimal\n}\n\nclass SalesOrderLine {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ProductId : Guid «FK»\n  -LineNumber : int\n  -OrderedQuantity : decimal\n  -NetAmount : decimal\n}\n\nclass ReceiptConfirmation {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ShipmentId : Guid? «FK, UK»\n  -ConfirmedByRetailerUserId : Guid «FK»\n  -OperationKey : string «UK»\n  -RequestHash : string\n  -Status : string\n  -ConfirmedAt : DateTimeOffset\n  -Note : string?\n}\n\nclass ReceiptConfirmationItem {\n  -Id : Guid «PK»\n  -ReceiptConfirmationId : Guid «FK»\n  -SalesOrderLineId : Guid? «FK»\n  -BatchId : Guid «FK»\n  -BatchQrLabelId : Guid «FK»\n  -ExpectedQuantity : decimal\n  -ReceivedQuantity : decimal\n  -DamagedQuantity : decimal\n  -MissingQuantity : decimal\n  -ScannedAt : DateTimeOffset\n}\n\nclass ReceiptConfirmationQrLabel {\n  -Id : Guid «PK»\n  -ReceiptConfirmationId : Guid «FK»\n  -BatchQrLabelId : Guid «FK, UK»\n  -ScannedAt : DateTimeOffset\n}\n\nclass ReceiptDiscrepancy {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ReceiptConfirmationId : Guid «FK»\n  -ReportedByRetailerUserId : Guid «FK»\n  -ReviewedByUserId : Guid? «FK»\n  -Status : string\n  -Note : string?\n  -ReportedAt : DateTimeOffset\n  -ReviewedAt : DateTimeOffset?\n  -ResolvedAt : DateTimeOffset?\n}\n\nclass ReceiptDiscrepancyItem {\n  -Id : Guid «PK»\n  -ReceiptDiscrepancyId : Guid «FK»\n  -BatchId : Guid? «FK»\n  -IssueType : string\n  -ExpectedQuantity : decimal\n  -ActualReceivedQuantity : decimal\n  -EvidenceBlobUrl : string?\n  -Note : string?\n}\n\nclass BatchQrLabel {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -CurrentWarehouseId : Guid «FK»\n  -ParentLabelId : Guid? «FK»\n  -RootLabelId : Guid? «FK»\n  -QrCode : string «UK»\n  -Quantity : decimal\n  -Status : string\n  -Version : int\n  -GeneratedAt : DateTimeOffset\n  -InvalidatedAt : DateTimeOffset?\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -BatchCode : string\n  -ExpirationDate : DateOnly\n  -StockStatus : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -Email : string\n  -FullName : string\n  -Role : string\n}\n\nRunPickingList \&quot;1\&quot; *-- \&quot;1..*\&quot; RunPickingGather : gather by batch\nRunPickingGather \&quot;1\&quot; *-- \&quot;1..*\&quot; RunPickingSplit : split by order\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; RunPickingGather : picked batch\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; RunPickingSplit : order portion\nSalesOrderLine \&quot;1\&quot; -- \&quot;0..*\&quot; RunPickingSplit : line portion\nRunPickingList \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : produces\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : delivery parts\nShipment \&quot;0..1\&quot; -- \&quot;0..1\&quot; ReceiptConfirmation : confirmed by\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmation : receipts\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmation : retailer confirms\nReceiptConfirmation \&quot;1\&quot; *-- \&quot;1..*\&quot; ReceiptConfirmationItem : quantities\nSalesOrderLine \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmationItem : received line\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmationItem : received batch\nBatch \&quot;1\&quot; *-- \&quot;0..*\&quot; BatchQrLabel : labels\nBatchQrLabel \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmationItem : scanned label\nReceiptConfirmation \&quot;1\&quot; *-- \&quot;0..*\&quot; ReceiptConfirmationQrLabel : scan evidence\nBatchQrLabel \&quot;1\&quot; -- \&quot;0..1\&quot; ReceiptConfirmationQrLabel : consumed once\nReceiptConfirmation \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancy : may report\nReceiptDiscrepancy \&quot;1\&quot; *-- \&quot;1..*\&quot; ReceiptDiscrepancyItem : issue lines\nBatch \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancyItem : affected batch\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; RunPickingList : completes\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancy : reports or reviews\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="4wuJiVCGbgsn-UmaLzcW-1">
