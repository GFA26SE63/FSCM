        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Warehouse {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Type : string\n  -Address : string?\n  -MinimumStockThresholdCartons : int\n  -IsActive : bool\n}\n\nclass GoodsReceipt {\n  -Id : Guid «PK»\n  -ReceiptCode : string «UK»\n  -IdempotencyKey : string? «UK»\n  -RequestHash : string?\n  -WarehouseId : Guid «FK»\n  -CreatedByUserId : Guid «FK»\n  -ApprovedByUserId : Guid? «FK»\n  -Status : string\n  -ReceivedAt : DateTimeOffset?\n  -ApprovedAt : DateTimeOffset?\n  -RejectionReason : string?\n  -Version : int\n}\n\nclass GoodsReceiptLine {\n  -Id : Guid «PK»\n  -GoodsReceiptId : Guid «FK»\n  -ProductId : Guid «FK»\n  -SourceLotCode : string?\n  -ReceivedQuantity : decimal\n  -ProductionDate : DateOnly\n  -ExpirationDate : DateOnly\n  -CreatedAt : DateTimeOffset\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -ParentBatchId : Guid? «FK»\n  -RootBatchId : Guid? «FK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -GoodsReceiptLineId : Guid? «FK»\n  -BatchCode : string «UK»\n  -Quantity : decimal\n  -ExpirationDate : DateOnly\n  -ExpiryStatus : string\n  -StockStatus : string\n  -Version : int\n}\n\nclass InventoryBalance {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK, UK»\n  -PhysicalQuantity : decimal\n  -ReservedQuantity : decimal\n  -AvailableQuantity : decimal\n  -Version : int\n  -UpdatedAt : DateTimeOffset\n}\n\nclass BatchQrLabel {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -CurrentWarehouseId : Guid «FK»\n  -GoodsReceiptId : Guid? «FK»\n  -ParentLabelId : Guid? «FK»\n  -RootLabelId : Guid? «FK»\n  -QrCode : string «UK»\n  -Quantity : decimal\n  -Status : string\n  -Version : int\n}\n\nclass QrLabelEvent {\n  -Id : Guid «PK»\n  -BatchQrLabelId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -PerformedByUserId : Guid «FK»\n  -OperationKey : string «UK»\n  -EventType : string\n  -FromStatus : string\n  -ToStatus : string\n  -Quantity : decimal\n  -OccurredAt : DateTimeOffset\n}\n\nclass InventoryTransaction {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -GoodsReceiptId : Guid? «FK»\n  -GoodsReceiptLineId : Guid? «FK»\n  -CreatedByUserId : Guid «FK»\n  -TransactionType : string\n  -SourceType : string\n  -SourceId : Guid «REF»\n  -PhysicalQuantityDelta : decimal\n  -ReservedQuantityDelta : decimal\n  -AvailableQuantityAfter : decimal\n  -OccurredAt : DateTimeOffset\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -Sku : string\n  -Name : string\n  -Unit : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; GoodsReceipt : receives at\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; GoodsReceipt : creates or approves\nGoodsReceipt \&quot;1\&quot; *-- \&quot;1..*\&quot; GoodsReceiptLine : lines\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; GoodsReceiptLine : product\nGoodsReceiptLine \&quot;0..1\&quot; -- \&quot;0..*\&quot; Batch : creates batches\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : stores\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : inventory of\nBatch \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Batch : parent lineage\nBatch \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Batch : root lineage\nBatch \&quot;1\&quot; *-- \&quot;1\&quot; InventoryBalance : balance\nBatch \&quot;1\&quot; *-- \&quot;0..*\&quot; BatchQrLabel : labels\nGoodsReceipt \&quot;0..1\&quot; -- \&quot;0..*\&quot; BatchQrLabel : trace origin\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; BatchQrLabel : current location\nBatchQrLabel \&quot;1\&quot; *-- \&quot;0..*\&quot; QrLabelEvent : lifecycle\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; QrLabelEvent : performs\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; InventoryTransaction : ledger\nGoodsReceipt \&quot;0..1\&quot; -- \&quot;0..*\&quot; InventoryTransaction : source document\nUserAccount \&quot;1\&quot; 