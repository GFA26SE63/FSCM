        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -EntraObjectId : string? «UK»\n  -IdentityProvider : string\n  -Email : string «UK»\n  -FullName : string\n  -Role : string\n  -IsActive : bool\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass UserCredential {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK, UK»\n  -PasswordHash : string\n  -FailedLoginCount : int\n  -LockoutEndAt : DateTimeOffset?\n  -MustChangePassword : bool\n  -PasswordChangedAt : DateTimeOffset?\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass RefreshToken {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -TokenHash : string «UK»\n  -ExpiresAt : DateTimeOffset\n  -CreatedAt : DateTimeOffset\n  -RevokedAt : DateTimeOffset?\n  -ReplacedByTokenId : Guid? «FK»\n  -CreatedByIpAddress : string?\n  -RevokedByIpAddress : string?\n}\n\nclass AccountToken {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -Purpose : string\n  -TokenHash : string «UK»\n  -ExpiresAt : DateTimeOffset\n  -ConsumedAt : DateTimeOffset?\n  -CreatedAt : DateTimeOffset\n}\n\nclass UserWarehouseAssignment {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -WarehouseId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -IsActive : bool\n}\n\nclass UserRegionAssignment {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -RegionId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -UnassignedAt : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass SalesGroupMember {\n  -Id : Guid «PK»\n  -SalesGroupId : Guid «FK»\n  -UserAccountId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -UnassignedAt : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass Warehouse {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Type : string\n  -Address : string?\n  -IsActive : bool\n}\n\nclass Region {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -IsActive : bool\n}\n\nclass SalesGroup {\n  -Id : Guid «PK»\n  -RegionId : Guid «FK»\n  -Code : string\n  -Name : string\n  -IsActive : bool\n}\n\nUserAccount \&quot;1\&quot; *-- \&quot;0..1\&quot; UserCredential : local credential\nUserAccount \&quot;1\&quot; *-- \&quot;0..*\&quot; RefreshToken : sessions\nRefreshToken \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; RefreshToken : replaces\nUserAccount \&quot;1\&quot; *-- \&quot;0..*\&quot; AccountToken : account actions\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; UserWarehouseAssignment : warehouse scope\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; UserWarehouseAssignment : assigned users\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; UserRegionAssignment : region scope\nRegion \&quot;1\&quot; -- \&quot;0..*\&quot; UserRegionAssignment : assigned users\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroupMember : memberships\nSalesGroup \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroupMember : members\nRegion \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroup : contains\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="YcKjBYsg1aYlj3qhSI-a-1">
