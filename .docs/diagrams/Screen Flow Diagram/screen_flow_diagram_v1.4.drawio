        <UserObject label="count task" mermaidId="e:M_NOTI-&gt;M_CNT#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=none;endArrow=block;endSize=8;jumpStyle=arc;jumpSize=12;strokeColor=#000000;html=1;fontSize=16;labelBackgroundColor=#cccccc;fontFamily=Recursive;fontColor=#28253D;exitX=1;exitY=0.56;entryX=0;entryY=0.66;strokeWidth=2;targetPerimeterSpacing=4;" mermaidBaseValue="count task" id="XTkt9WKR4wtTY-d1lMFB-113">
