<mxfile host="app.diagrams.net" pages="7">
  <diagram id="n-NPij77xDPp2qF3SmQN" name="Admin Screen Flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Administrator (Web Portal) - Screen Flow (FSCM_Prototype_Prod_v1.3, baseline 02/11/2026) =====\n    %% Notation: beige = common screen | blue text = create/edit form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several information tabs\n\n    LOGIN[\&quot;Login\&quot;]:::common\n    RESET[\&quot;Forgot Password\&quot;]:::common\n    RESET_SENT[\&quot;Check Email\&quot;]:::common\n    RESET_NP[\&quot;Set New Password\&quot;]:::form\n    NOTI([\&quot;Notifications\&quot;]):::common\n    POST[\&quot;&lt;b&gt;PostLogin&lt;/b&gt;\&quot;]\n    LOGIN --&gt; POST\n    LOGIN --&gt;|Forgot password| RESET\n    RESET --&gt;|send link| RESET_SENT\n    RESET_SENT --&gt;|open link in email| RESET_NP\n    RESET_NP --&gt;|password updated| LOGIN\n    LOGIN --&gt;|Google| GG_ACC([\&quot;Choose Google Account\&quot;]):::common\n    GG_ACC --&gt;|Administrator role| GG_WAIT[\&quot;Signing In\&quot;]:::common\n    GG_WAIT --&gt; POST\n    GG_ACC --&gt;|no Administrator role| GG_DENY[\&quot;Access Denied\&quot;]:::common\n    GG_DENY --&gt;|choose another account| GG_ACC\n    GG_DENY --&gt;|back| LOGIN\n    POST --&gt; NOTI\n    POST -.-&gt;|Logout| LOGIN\n\n    %% ===== Sales &amp; order operations =====\n    POST --&gt; DASH[\&quot;FMCG Dashboard\&quot;]\n    DASH --&gt;|click tile| ORD_L\n    POST --&gt; ORD_L[\&quot;Orders List\&quot;]\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_1[\&quot;&lt;i&gt;Order Info &amp; Status&lt;br/&gt;(Delivered / Receipt Exception / Completed)&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Products &amp; Selected Promotion&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Real-time Allocation Result &amp; Price per Batch&lt;br/&gt;(% shelf life at ETA)&lt;/i&gt;\&quot;]\n        ORD_D_Q[\&quot;&lt;i&gt;Quote, Payment Choice &amp; PO&lt;/i&gt;\&quot;]\n        ORD_D_4[\&quot;&lt;i&gt;Warehouse Portions &amp; Readiness&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Payments (PayOS / Payment Receipts)&lt;/i&gt;\&quot;]\n        ORD_D_6[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Withdrawal / Quote Rejection Evidence&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    ORD_L --&gt;|quote pending / awaiting payment| REJ\n    ORD_D --&gt;|quote pending / awaiting payment| REJ[\&quot;Record Retailer Quote Rejection&lt;br/&gt;(reason + evidence, release stock)\&quot;]:::form\n    ORD_L --&gt;|allocation failed| RETRY\n    ORD_D --&gt;|\&quot;allocation failed (conflict / technical)\&quot;| RETRY([\&quot;Re-allocate\&quot;])\n    RETRY --&gt;|reserved &amp; quoted| ORD_D\n    RETRY --&gt;|out of stock / failed again| ORD_D\n    ORD_D --&gt;|allocation attempt| ALLOC_D\n    ORD_D --&gt;|awaiting payment| PAYOS([\&quot;PayOS Payment Status&lt;br/&gt;(webhook → PO + picking per warehouse)\&quot;])\n    PAYOS --&gt;|paid| ORD_D\n    ORD_D --&gt;|issued| ASSIGN[\&quot;Assign Vehicle to Portion\&quot;]:::form\n    ORD_D --&gt;|issued, all portions assigned| DELIV[\&quot;Start Delivery\&quot;]:::form\n    ORD_D --&gt;|delivering| DFAIL[\&quot;Record Delivery Failure&lt;br/&gt;(shipment exception)\&quot;]:::form\n    ORD_D --&gt;|credit order| COLLECT\n    ORD_D --&gt;|receipt exception| CMP_D\n    ORD_D --&gt;|refund case| REF_D\n    ORD_L --&gt;|Allocation History| ALLOC_L[\&quot;Allocation History\&quot;]\n    subgraph ALLOC_D[\&quot;Allocation Attempt Details\&quot;]\n        direction TB\n        ALLOC_D_1[\&quot;&lt;i&gt;Attempt Info, Retries (max 3) &amp; Result&lt;/i&gt;\&quot;]\n        ALLOC_D_2[\&quot;&lt;i&gt;Optimistic Locking Log&lt;/i&gt;\&quot;]\n        ALLOC_D_3[\&quot;&lt;i&gt;B1 Warehouse Radius · B2 Available Stock &amp; Locks&lt;/i&gt;\&quot;]\n        ALLOC_D_4[\&quot;&lt;i&gt;B3 MLOR at ETA · B4 Score, Selection &amp; Price&lt;/i&gt;\&quot;]\n    end\n    class ALLOC_D tab\n    ALLOC_L --&gt; ALLOC_D\n    ALLOC_L --&gt;|allocation failed| RETRY\n    ALLOC_D --&gt; ORD_D\n    subgraph DEBT_L[\&quot;Debts\&quot;]\n        direction TB\n        DEBT_L_1[\&quot;&lt;i&gt;Receivables &amp; Aging&lt;/i&gt;\&quot;]\n        DEBT_L_2[\&quot;&lt;i&gt;Payment Receipts&lt;/i&gt;\&quot;]\n        DEBT_L_3[\&quot;&lt;i&gt;Refunds&lt;/i&gt;\&quot;]\n    end\n    class DEBT_L tab\n    POST --&gt; DEBT_L\n    DEBT_L --&gt; ORD_D\n    DEBT_L --&gt;|overdue| REMIND([\&quot;Remind All Overdue Orders\&quot;])\n    subgraph COLLECT[\&quot;Create Payment Receipt\&quot;]\n        direction TB\n        COLLECT_1[\&quot;&lt;i&gt;Retailer, Amount &amp; Bank Transfer Ref.&lt;/i&gt;\&quot;]\n        COLLECT_2[\&quot;&lt;i&gt;Allocate to Invoices&lt;br/&gt;(oldest first, partial allowed)&lt;/i&gt;\&quot;]\n        COLLECT_3[\&quot;&lt;i&gt;Unapplied Credit&lt;/i&gt;\&quot;]\n    end\n    class COLLECT formTab\n    DEBT_L --&gt;|+ create receipt| COLLECT\n    DEBT_L_2 --&gt; ARR_D[\&quot;Payment Receipt Details\&quot;]\n    COLLECT --&gt;|saved as draft| ARR_D\n    ARR_D --&gt;|draft| ARR_OK([\&quot;Confirm Receipt\&quot;])\n    ARR_D --&gt;|draft| ARR_DEL([\&quot;Cancel Draft\&quot;])\n    ARR_D --&gt;|Admin, wrong receipt| ARR_REV([\&quot;Create Reversal Entry\&quot;])\n    DEBT_L_3 --&gt; REF_L[\&quot;Refunds List\&quot;]\n    REF_L --&gt; REF_D[\&quot;Refund Details\&quot;]\n    REF_D --&gt;|pending transfer| REF_TX[\&quot;Record Refund Transfer &amp; Evidence\&quot;]:::form\n    REF_D --&gt;|Admin, awaiting verification| REF_VER([\&quot;Verify Refunded\&quot;])\n    REF_D --&gt;|Admin| REF_RET[\&quot;Return Refund Request\&quot;]:::form\n    POST --&gt; PROMO_L[\&quot;Promotions List\&quot;]\n    PROMO_L --&gt; PROMO_D[\&quot;Promotion Details\&quot;]\n    PROMO_D --&gt; PROMO_R[\&quot;Orders Applying Promotion\&quot;]\n    PROMO_L --&gt; PROMO_F[\&quot;Create Promotion\&quot;]:::form\n    POST --&gt; RET_L[\&quot;Retailers List\&quot;]\n    subgraph RET_D[\&quot;Retailer / Declaration Details\&quot;]\n        direction TB\n        RET_D_1[\&quot;&lt;i&gt;General Info&lt;/i&gt;\&quot;]\n        RET_D_2[\&quot;&lt;i&gt;Shelf-life Requirements (MLOR)&lt;/i&gt;\&quot;]\n        RET_D_3[\&quot;&lt;i&gt;Debts &amp; Credit Eligibility&lt;br/&gt;(term, limit, no overdue)&lt;/i&gt;\&quot;]\n        RET_D_4[\&quot;&lt;i&gt;Profile History (AuditLog)&lt;/i&gt;\&quot;]\n    end\n    class RET_D tab\n    RET_L --&gt; RET_D\n    subgraph RET_F[\&quot;Add / Edit Retailer\&quot;]\n        direction TB\n        RET_F_1[\&quot;&lt;i&gt;General Info&lt;/i&gt;\&quot;]\n        RET_F_2[\&quot;&lt;i&gt;Location &amp; Status&lt;/i&gt;\&quot;]\n        RET_F_3[\&quot;&lt;i&gt;Potential, Credit Term &amp; Limit&lt;br/&gt;(Sales change notifies retailer)&lt;/i&gt;\&quot;]\n        RET_F_4[\&quot;&lt;i&gt;Admin Assessment &amp; Priority&lt;/i&gt;\&quot;]\n    end\n    class RET_F formTab\n    RET_L --&gt; RET_F\n    RET_D --&gt; RET_F\n    RET_D --&gt; MLOR_F[\&quot;Edit MLOR by Category / SKU\&quot;]:::form\n    RET_D --&gt;|declaration pending| RET_APV[\&quot;Approve, Assess &amp; Issue Code&lt;br/&gt;(email sent to retailer)\&quot;]:::form\n    RET_D --&gt;|declaration pending| RET_DREJ[\&quot;Reject Declaration\&quot;]:::form\n    RET_L --&gt; RET_IMP([\&quot;Import Retailers\&quot;])\n    RET_D --&gt;|active| LOCK_ACC[\&quot;Lock Account&lt;br/&gt;(reason, effective time, open transactions)\&quot;]:::form\n    RET_D --&gt;|locked| RET_REACT([\&quot;Reactivate\&quot;])\n    POST --&gt; LOY_L[\&quot;Loyalty List\&quot;]\n    LOY_L --&gt; LOY_D[\&quot;Points &amp; History\&quot;]\n    POST --&gt; RDM_L[\&quot;Gift Redemption Requests\&quot;]\n    RDM_L --&gt;|pending| RDM_APV([\&quot;Approve / Reject\&quot;])\n    RDM_L --&gt;|gift delivered| RDM_DONE([\&quot;Mark Completed\&quot;])\n    RDM_L --&gt; RW_L\n    POST --&gt; RW_L[\&quot;Gift Catalog\&quot;]\n    RW_L --&gt; RW_F[\&quot;Add / Edit Gift\&quot;]:::form\n    POST --&gt; REG_L[\&quot;Regions &amp; Sales Groups\&quot;]\n    REG_L --&gt; REG_D[\&quot;Group Details\&quot;]\n    subgraph GRP_F[\&quot;Add / Edit Sales Group\&quot;]\n        direction TB\n        GRP_F_1[\&quot;&lt;i&gt;Group Info&lt;/i&gt;\&quot;]\n        GRP_F_2[\&quot;&lt;i&gt;Members (only unassigned Sales)&lt;/i&gt;\&quot;]\n    end\n    class GRP_F formTab\n    REG_L --&gt; GRP_F\n    REG_D --&gt; GRP_F\n    REG_D --&gt; TRF_S[\&quot;Transfer Sales&lt;br/&gt;(retailer notified)\&quot;]:::form\n    REG_L --&gt; AREA_F[\&quot;Create Region / Area\&quot;]:::form\n    subgraph KPI_L[\&quot;KPI Sales List\&quot;]\n        direction TB\n        KPI_L_1[\&quot;&lt;i&gt;KPI Sales&lt;/i&gt;\&quot;]\n        KPI_L_2[\&quot;&lt;i&gt;Ranking&lt;/i&gt;\&quot;]\n        KPI_L_3[\&quot;&lt;i&gt;Best-selling Products&lt;/i&gt;\&quot;]\n        KPI_L_4[\&quot;&lt;i&gt;Group Orders&lt;/i&gt;\&quot;]\n        KPI_L_5[\&quot;&lt;i&gt;Group Retailers&lt;/i&gt;\&quot;]\n        KPI_L_6[\&quot;&lt;i&gt;Basic Report&lt;/i&gt;\&quot;]\n    end\n    class KPI_L tab\n    POST --&gt; KPI_L\n    KPI_L --&gt; KPI_D[\&quot;KPI Details\&quot;]\n    KPI_L --&gt; KPI_F[\&quot;KPI Targets &amp; Weights\&quot;]:::form\n    POST --&gt; CMP_L[\&quot;Complaints List\&quot;]\n    CMP_L --&gt; CMP_D[\&quot;Complaint Details\&quot;]\n    CMP_D --&gt;|pending| KN_ACC[\&quot;Propose Result: Replacement or Financial Adjustment\&quot;]:::form\n    CMP_D --&gt;|pending| KN_MORE([\&quot;Request More Evidence\&quot;])\n    CMP_D --&gt;|pending| KN_REJ[\&quot;Reject Complaint (reason required)\&quot;]:::form\n    KN_ACC --&gt;|Operator proposal| CMP_D\n    CMP_D --&gt;|Admin, awaiting approval| KN_APV[\&quot;Approve Result / Reject\&quot;]:::form\n    KN_APV --&gt;|financial adjustment, paid order| REF_D\n    KN_APV --&gt;|replacement| CMP_D\n    CMP_D --&gt;|replacement approved / preparing| REPL([\&quot;Update Replacement Status\&quot;])\n\n    %% ===== Warehouse &amp; master data =====\n    POST --&gt; PICK_L[\&quot;Picking List&lt;br/&gt;(one slip per PO &amp; warehouse)\&quot;]\n    subgraph PICK_D[\&quot;Picking Details\&quot;]\n        direction TB\n        PICK_D_1[\&quot;&lt;i&gt;Gather by Batch&lt;/i&gt;\&quot;]\n        PICK_D_2[\&quot;&lt;i&gt;Split per Order Line&lt;/i&gt;\&quot;]\n        PICK_D_3[\&quot;&lt;i&gt;Exceptions&lt;/i&gt;\&quot;]\n        PICK_D_4[\&quot;&lt;i&gt;Scan Validation Log&lt;/i&gt;\&quot;]\n    end\n    class PICK_D tab\n    PICK_L --&gt; PICK_D\n    PICK_D_3 --&gt;|exception open| PICK_EXC[\&quot;Resolve Exception\&quot;]:::form\n    POST --&gt; CNT_L[\&quot;Stock Counts (P1)\&quot;]\n    CNT_L --&gt; CNT_F[\&quot;Create Count\&quot;]:::form\n    CNT_L --&gt; CNT_D[\&quot;Count Details\&quot;]\n    CNT_D --&gt;|counting| CNT_E[\&quot;Enter Actual Count\&quot;]:::form\n    POST --&gt; LEDGER[\&quot;Inventory Ledger\&quot;]\n    CNT_D --&gt;|variance pending| CNT_APV[\&quot;Approve Adjustment / Return for Recount\&quot;]:::form\n    POST --&gt; RCPT_L[\&quot;Goods Receipts\&quot;]\n    RCPT_L --&gt; RCPT_D[\&quot;Receipt Details\&quot;]\n    RCPT_L --&gt; RCPT_F[\&quot;Create Receipt\&quot;]:::form\n    RCPT_D --&gt;|pending approval| RCPT_APV([\&quot;Approve Receipt\&quot;])\n    RCPT_D --&gt; RCPT_QR([\&quot;Print Batch QR Labels\&quot;])\n    POST --&gt; BAT_L[\&quot;Batches List\&quot;]\n    subgraph BAT_D[\&quot;Batch Details\&quot;]\n        direction TB\n        BAT_D_1[\&quot;&lt;i&gt;Batch Info &amp; Stock&lt;/i&gt;\&quot;]\n        BAT_D_2[\&quot;&lt;i&gt;Locked Stock&lt;/i&gt;\&quot;]\n        BAT_D_3[\&quot;&lt;i&gt;Orders Holding Batch&lt;/i&gt;\&quot;]\n        BAT_D_4[\&quot;&lt;i&gt;History&lt;/i&gt;\&quot;]\n    end\n    class BAT_D tab\n    BAT_L --&gt; BAT_D\n    BAT_L --&gt; LOCK_F[\&quot;Lock Damaged / Expired Stock\&quot;]:::form\n    BAT_D --&gt; LOCK_F\n    BAT_D --&gt;|locked, Admin only| UNLOCK([\&quot;Unlock Batch\&quot;])\n    BAT_D --&gt; REPRINT([\&quot;Reprint QR\&quot;])\n    BAT_D --&gt;|create disposal| DISP_F\n    POST --&gt; EXPD_L[\&quot;Expiry Discounts\&quot;]\n    EXPD_L --&gt; EXPD_F[\&quot;Add / Edit Discount Rule&lt;br/&gt;(percentage only)\&quot;]:::form\n    POST --&gt; DISP_L[\&quot;Expired Disposal\&quot;]\n    DISP_L --&gt; DISP_D[\&quot;Disposal Details\&quot;]\n    DISP_D --&gt;|Admin, pending| DISP_APV[\&quot;Approve Disposal\&quot;]:::form\n    DISP_D --&gt;|Admin, pending| DISP_REJ[\&quot;Reject Disposal\&quot;]:::form\n    DISP_L --&gt; DISP_F[\&quot;Create Disposal Record\&quot;]:::form\n    POST --&gt; CAT_L[\&quot;Category Tree\&quot;]\n    CAT_L --&gt; CAT_F[\&quot;Add / Edit Category\&quot;]:::form\n    CAT_F --&gt;|root category| CAT_W([\&quot;Root Category Warning\&quot;])\n    POST --&gt; SKU_L[\&quot;Products (SKU)\&quot;]\n    SKU_L --&gt; SKU_D[\&quot;SKU Details\&quot;]\n    subgraph SKU_F[\&quot;Add / Edit SKU\&quot;]\n        direction TB\n        SKU_F_1[\&quot;&lt;i&gt;Product Info&lt;/i&gt;\&quot;]\n        SKU_F_2[\&quot;&lt;i&gt;Shelf Life &amp; MLOR&lt;/i&gt;\&quot;]\n    end\n    class SKU_F formTab\n    SKU_L --&gt; SKU_F\n    SKU_D --&gt;|Draft| SKU_F\n    SKU_D --&gt;|On sale: price locked| SKU_NEW[\&quot;Create New Version\&quot;]:::form\n    SKU_D --&gt;|On sale| PRICE_F[\&quot;Schedule New Price&lt;br/&gt;(no overlapping period)\&quot;]:::form\n    POST --&gt; WH_L[\&quot;Warehouses List\&quot;]\n    WH_L --&gt; WH_D[\&quot;Warehouse Details\&quot;]\n    WH_L --&gt; WH_MAP([\&quot;Warehouse Network Map\&quot;])\n    subgraph WH_F[\&quot;Add / Edit Warehouse\&quot;]\n        direction TB\n        WH_F_1[\&quot;&lt;i&gt;Warehouse Info, Region + Map Picker&lt;/i&gt;\&quot;]\n        WH_F_2[\&quot;&lt;i&gt;Assignment&lt;/i&gt;\&quot;]\n    end\n    class WH_F formTab\n    WH_L --&gt; WH_F\n    WH_D --&gt; WH_F\n    WH_D --&gt;|active / inactive| WH_ST([\&quot;Deactivate / Reactivate\&quot;])\n    POST --&gt; USR_L[\&quot;Users List\&quot;]\n    subgraph USR_D[\&quot;User Details\&quot;]\n        direction TB\n        USR_D_1[\&quot;&lt;i&gt;Account Info &amp; Role&lt;/i&gt;\&quot;]\n        USR_D_2[\&quot;&lt;i&gt;Change History&lt;/i&gt;\&quot;]\n    end\n    class USR_D tab\n    USR_L --&gt; USR_D\n    USR_D --&gt;|active| LOCK_ACC\n    USR_D --&gt;|locked| USR_UNLOCK([\&quot;Unlock Account\&quot;])\n    subgraph USR_F[\&quot;Create / Edit User\&quot;]\n        direction TB\n        USR_F_1[\&quot;&lt;i&gt;Account Info (company Google account)&lt;/i&gt;\&quot;]\n        USR_F_2[\&quot;&lt;i&gt;Role Scope&lt;/i&gt;\&quot;]\n    end\n    class USR_F formTab\n    USR_L --&gt; USR_F\n    USR_D --&gt; USR_F\n    POST --&gt; CFG_L[\&quot;System Config\&quot;]\n    subgraph CFG_F[\&quot;Edit Config\&quot;]\n        direction TB\n        CFG_F_1[\&quot;&lt;i&gt;Allocation: Weights, Service Radius &amp; Retry (max 3)&lt;/i&gt;\&quot;]\n        CFG_F_2[\&quot;&lt;i&gt;Quote &amp; PayOS Payment Deadline&lt;/i&gt;\&quot;]\n        CFG_F_3[\&quot;&lt;i&gt;Pricing, Loyalty Rate &amp; Customer Priority&lt;/i&gt;\&quot;]\n        CFG_F_4[\&quot;&lt;i&gt;Credit Terms &amp; Scheduled Jobs&lt;/i&gt;\&quot;]\n    end\n    class CFG_F formTab\n    CFG_L --&gt; CFG_F\n\n    %% ===== Notification deep links =====\n    NOTI -.-&gt;|order update| ORD_D\n    NOTI -.-&gt;|order blocked at dispatch| ORD_D\n    NOTI -.-&gt;|PayOS payment confirmed / expired| ORD_D\n    NOTI -.-&gt;|allocation failed / out of stock| ORD_D\n    NOTI -.-&gt;|quote expiring| ORD_D\n    NOTI -.-&gt;|delivery failed / receipt exception| ORD_D\n    NOTI -.-&gt;|new declaration| RET_D\n    NOTI -.-&gt;|overdue debt| DEBT_L\n    NOTI -.-&gt;|refund pending| REF_D\n    NOTI -.-&gt;|new complaint| CMP_D\n    NOTI -.-&gt;|gift request| RDM_L\n    NOTI -.-&gt;|expired stock| DISP_L\n    NOTI -.-&gt;|disposal pending approval| DISP_D\n    NOTI -.-&gt;|goods receipt pending approval| RCPT_D\n    NOTI -.-&gt;|picking pending / exception| PICK_D\n    NOTI -.-&gt;|count variance pending| CNT_D\n    NOTI -.-&gt;|KPI updated| KPI_L\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="AbiQnYK5e-Dx70lm-H3K-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Edit Config" mermaidId="n:CFG_F" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=default;strokeColor=#111111;fontColor=#1F3FD1;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Edit Config" id="Ylb14J2eKXkIv3xI872t-2">
          <mxCell parent="AbiQnYK5e-Dx70lm-H3K-1" style="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=default;strokeColor=#111111;fontColor=#1F3FD1;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="290" width="376" x="1970" y="6834" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;i&gt;Allocation: Weights, Service Radius &amp; Retry (max 3)&lt;/i&gt;" mermaidId="n:CFG_F_1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=default;strokeColor=#111111;fontColor=#111111;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;i&gt;Allocation: Weights, Service Radius &amp; Retry (max 3)&lt;/i&gt;" id="Ylb14J2eKXkIv3xI872t-3">
          <mxCell parent="Ylb14J2eKXkIv3xI872t-2" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=default;strokeColor=#111111;fontColor=#111111;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;labelWidth=120;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="108" width="152" x="24" y="159" as="geometry" />
          </mxCell>
        </UserObject>
