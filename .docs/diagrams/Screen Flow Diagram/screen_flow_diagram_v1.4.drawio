  <diagram id="Krl91XbH-crRBRboe6Ko" name="Sales Screen Flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Sales (Mobile App) - Screen Flow (FSCM_Prototype_Prod_v1.3, baseline 02/11/2026) =====\n    %% Notation: beige = common screen | blue text = create/edit form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several tabs / sections\n\n    LOGIN[\&quot;Login – Staff tab\&quot;]:::common\n    NOTI[\&quot;Notifications\&quot;]:::common\n    MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    LOGIN --&gt; MAIN\n    LOGIN --&gt;|Google| GG_ACC[\&quot;Choose Google Account\&quot;]:::common\n    GG_ACC --&gt;|Sales role| GG_WAIT[\&quot;Signing In\&quot;]:::common\n    GG_WAIT --&gt; MAIN\n    GG_ACC --&gt;|no Sales role| GG_DENY[\&quot;Access Denied\&quot;]:::common\n    GG_DENY --&gt;|choose another account| GG_ACC\n    GG_DENY --&gt;|back| LOGIN\n    MAIN --&gt;|bell| NOTI\n    MAIN -.-&gt;|Logout| LOGIN\n\n    %% ===== Tabs =====\n    MAIN --&gt; HOME\n    MAIN --&gt; ORD_L\n    MAIN --&gt; SYNC\n    MAIN --&gt; ACC\n\n    %% ===== Home =====\n    subgraph HOME[\&quot;Home\&quot;]\n        direction TB\n        HOME_0[\&quot;&lt;i&gt;Sync Status &amp; Overdue Debt Alert&lt;/i&gt;\&quot;]\n        HOME_1[\&quot;&lt;i&gt;Today&#39;s Orders · Quoting · Short / Rejected&lt;/i&gt;\&quot;]\n        HOME_5[\&quot;&lt;i&gt;Shortcuts: Promotions, My Sales, Ranking, Declare Retailer&lt;/i&gt;\&quot;]\n        HOME_2[\&quot;&lt;i&gt;Priority Retailers&lt;/i&gt;\&quot;]\n        HOME_3[\&quot;&lt;i&gt;Best Sellers This Month&lt;/i&gt;\&quot;]\n        HOME_4[\&quot;&lt;i&gt;Latest Notifications&lt;/i&gt;\&quot;]\n    end\n    class HOME tab\n\n    %% ===== Create sales order =====\n    HOME --&gt;|create order / all retailers| RET[\&quot;Retailers in Area&lt;br/&gt;(filter: region, area, priority)\&quot;]\n    HOME --&gt;|priority retailer: order| PROD\n    subgraph RET_D[\&quot;Retailer Details\&quot;]\n        direction TB\n        RET_D_1[\&quot;&lt;i&gt;Contact, Address, Scale &amp; Assessment&lt;/i&gt;\&quot;]\n        RET_D_2[\&quot;&lt;i&gt;Credit Term, Debt to Collect &amp; Loyalty&lt;/i&gt;\&quot;]\n    end\n    class RET_D tab\n    RET --&gt; RET_D\n    RET_D --&gt;|in own area: order for this store| PROD\n    RET_D --&gt;|out of area| RET_LOCK[\&quot;Ordering Locked&lt;br/&gt;(outside your area)\&quot;]\n    RET_D --&gt; PROPOSE([\&quot;Propose Shelf-life Update&lt;br/&gt;(Admin approves)\&quot;])\n    subgraph PROD[\&quot;Products\&quot;]\n        direction TB\n        PROD_1[\&quot;&lt;i&gt;All / Best Sellers / by Category&lt;/i&gt;\&quot;]\n        PROD_2[\&quot;&lt;i&gt;Max Orderable Quantity&lt;/i&gt;\&quot;]\n    end\n    class PROD tab\n    PROD --&gt; CART[\&quot;Cart&lt;br/&gt;(subtotal after promotion)\&quot;] --&gt; PROMO_A[\&quot;Choose Promotion&lt;br/&gt;(one valid promotion or none)\&quot;]:::form --&gt; CONF\n    subgraph CONF[\&quot;Confirm Order\&quot;]\n        direction TB\n        CONF_1[\&quot;&lt;i&gt;Delivery Address &amp; Desired Date&lt;/i&gt;\&quot;]\n        CONF_2[\&quot;&lt;i&gt;Products &amp; Price after Promotion&lt;/i&gt;\&quot;]\n        CONF_3[\&quot;&lt;i&gt;Selected Promotion&lt;/i&gt;\&quot;]\n        CONF_4[\&quot;&lt;i&gt;Payment Note&lt;br/&gt;(retailer chooses Prepaid / Credit after quote)&lt;/i&gt;\&quot;]\n        CONF_5[\&quot;&lt;i&gt;Expected Loyalty Points&lt;/i&gt;\&quot;]\n    end\n    class CONF formTab\n    CONF --&gt;|online: send| ALLOC[\&quot;Allocating…&lt;br/&gt;(real-time, per SO)\&quot;]\n    CONF --&gt;|offline: save draft| RESULT\n    CONF --&gt;|server check fails: outside radius / promotion or price expired| CONF\n    ALLOC --&gt; RESULT\n    subgraph RESULT[\&quot;Order Result\&quot;]\n        direction TB\n        RESULT_1[\&quot;&lt;i&gt;Reserved &amp; Quote Sent&lt;br/&gt;(quote no., deadline)&lt;/i&gt;\&quot;]\n        RESULT_2[\&quot;&lt;i&gt;Out of Stock&lt;br/&gt;(short SKUs, nothing reserved)&lt;/i&gt;\&quot;]\n        RESULT_4[\&quot;&lt;i&gt;Allocation Error&lt;br/&gt;(stock conflict after 3 retries, nothing reserved)&lt;/i&gt;\&quot;]\n        RESULT_3[\&quot;&lt;i&gt;Draft Saved Offline&lt;/i&gt;\&quot;]\n    end\n    class RESULT tab\n    RESULT --&gt;|back home| HOME\n    RESULT --&gt;|view order| ORD_D\n    RESULT_2 --&gt;|edit quantity &amp; resend| CART\n\n    %% ===== Orders &amp; sync =====\n    subgraph ORD_L[\&quot;Orders List&lt;br/&gt;(own &amp; same-group Sales)\&quot;]\n        direction TB\n        ORD_L_1[\&quot;&lt;i&gt;In Progress&lt;/i&gt;\&quot;]\n        ORD_L_2[\&quot;&lt;i&gt;Completed&lt;/i&gt;\&quot;]\n        ORD_L_3[\&quot;&lt;i&gt;Filter: status, store, time, creator&lt;/i&gt;\&quot;]\n    end\n    class ORD_L tab\n    subgraph SYNC[\&quot;Sync Queue&lt;br/&gt;(manual Send when online)\&quot;]\n        direction TB\n        SYNC_1[\&quot;&lt;i&gt;Pending Sync&lt;/i&gt;\&quot;]\n        SYNC_2[\&quot;&lt;i&gt;Syncing&lt;/i&gt;\&quot;]\n        SYNC_3[\&quot;&lt;i&gt;Synced → Allocated&lt;/i&gt;\&quot;]\n    end\n    class SYNC tab\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_1[\&quot;&lt;i&gt;Retailer, Channel &amp; Times&lt;br/&gt;(created, server accepted)&lt;/i&gt;\&quot;]\n        ORD_D_6[\&quot;&lt;i&gt;Processing Steps&lt;br/&gt;(Send → Allocate → Quote → Payment·PO → Dispatch → Receive)&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Products&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Price &amp; Promotion&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Warehouse Portions&lt;/i&gt;\&quot;]\n        ORD_D_4[\&quot;&lt;i&gt;Quote &amp; Payment&lt;/i&gt;\&quot;]\n        ORD_D_8[\&quot;&lt;i&gt;Shortage / Allocation Error / Rejection Reason&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    SYNC --&gt; ORD_D\n    NOTI --&gt; ORD_D\n    ORD_D --&gt;|price per batch| PRICE_D[\&quot;Batch Price Details&lt;br/&gt;(list, after promotion, % shelf-life discount)\&quot;]\n    ORD_D --&gt;|shortage: edit quantity &amp; resend| CART\n    ORD_D --&gt;|allocation not successful yet| WD([\&quot;Withdraw Request\&quot;])\n    WD --&gt;|withdrawn, nothing reserved| ORD_D\n    SYNC --&gt;|send drafts| SYNC\n    SYNC --&gt;|price / promotion changed| SYNC_C([\&quot;Confirm New Price &amp; Sync\&quot;])\n    SYNC_C --&gt;|sent: allocate| ORD_D\n    SYNC --&gt;|pending draft| SYNC_DEL([\&quot;Delete Draft\&quot;])\n\n    %% ===== Account &amp; shortcuts =====\n    subgraph ACC[\&quot;Account\&quot;]\n        direction TB\n        ACC_1[\&quot;&lt;i&gt;Profile, Role &amp; Group&lt;/i&gt;\&quot;]\n        ACC_2[\&quot;&lt;i&gt;Change Password · Push Notifications&lt;/i&gt;\&quot;]\n    end\n    class ACC tab\n    ACC --&gt; MYS[\&quot;My Sales&lt;br/&gt;(revenue after promotion, by store)\&quot;]\n    ACC --&gt; PRM_L[\&quot;Active Promotions\&quot;]\n    ACC --&gt; RANK\n    ACC --&gt; DEBT[\&quot;Debts to Collect&lt;br/&gt;(collectible now / disputed)\&quot;]\n    DEBT --&gt;|record collected| DEBT_R([\&quot;Send Receipt Request&lt;br/&gt;(Operator creates receipt &amp; allocates per invoice)\&quot;])\n    ACC --&gt; DCL_L[\&quot;Retailer Declarations\&quot;]\n    HOME --&gt; MYS &amp; PRM_L &amp; RANK &amp; DCL_L\n    HOME --&gt;|overdue debt| DEBT\n    HOME --&gt;|open sync| SYNC\n    HOME --&gt;|see all| NOTI\n    MYS --&gt; ORD_D\n    PRM_L --&gt; PRM_D[\&quot;Promotion Details&lt;br/&gt;(conditions, products, retailers)\&quot;]\n    subgraph RANK[\&quot;KPI &amp; Ranking\&quot;]\n        direction TB\n        RANK_0[\&quot;&lt;i&gt;My KPI (target, % achieved, weighted score)&lt;/i&gt;\&quot;]\n        RANK_1[\&quot;&lt;i&gt;Sales Ranking&lt;/i&gt;\&quot;]\n        RANK_2[\&quot;&lt;i&gt;Best-selling Products&lt;/i&gt;\&quot;]\n    end\n    class RANK tab\n    HOME --&gt;|best sellers| RANK\n    NOTI --&gt; DEBT\n    subgraph DCL_D[\&quot;Declaration Details\&quot;]\n        direction TB\n        DCL_D_1[\&quot;&lt;i&gt;Store Info &amp; App Account&lt;/i&gt;\&quot;]\n        DCL_D_2[\&quot;&lt;i&gt;Potential &amp; Admin Assessment&lt;/i&gt;\&quot;]\n        DCL_D_3[\&quot;&lt;i&gt;Shelf-life Requirements (Category / SKU)&lt;/i&gt;\&quot;]\n        DCL_D_4[\&quot;&lt;i&gt;Survey Photos &amp; Notes&lt;/i&gt;\&quot;]\n        DCL_D_5[\&quot;&lt;i&gt;Status Timeline / Rejection Reason&lt;/i&gt;\&quot;]\n    end\n    class DCL_D tab\n    subgraph DCL_F[\&quot;New Retailer Declaration&lt;br/&gt;(sent to Admin / Operator)\&quot;]\n        direction TB\n        DCL_F_1[\&quot;&lt;i&gt;Tab 1 – General Info:&lt;br/&gt;Store Info &amp; Location, Survey Photos,&lt;br/&gt;Potential Assessment, Survey Notes&lt;/i&gt;\&quot;]\n        DCL_F_2[\&quot;&lt;i&gt;Tab 2 – Shelf-life Requirements&lt;br/&gt;(MLOR by Category / SKU)&lt;/i&gt;\&quot;]\n    end\n    class DCL_F formTab\n    DCL_L --&gt; DCL_D\n    DCL_L --&gt; DCL_F\n    DCL_F --&gt;|sent| DCL_D\n    DCL_D --&gt;|approved, in own area: order for this store| PROD\n    DCL_F_1 --&gt; MAP([\&quot;Map Picker / Current GPS\&quot;])\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9IAMUzYf0J3HRAwhern1-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="New Retailer Declaration&#xa;(sent to Admin / Operator)" mermaidId="n:DCL_F" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=default;strokeColor=#111111;fontColor=#1F3FD1;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="New Retailer Declaration&#xa;(sent to Admin / Operator)" id="0RpMbwnJ-T_MYZmMbT72-1">
