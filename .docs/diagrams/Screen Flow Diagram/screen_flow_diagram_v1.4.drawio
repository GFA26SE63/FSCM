  <diagram id="hZuSWBXkTQktbNz2vXXw" name="Retailer Screen Flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Retailer (Mobile App) - Screen Flow (FSCM_Prototype_Prod_v1.3, baseline 02/11/2026) =====\n    %% Notation: beige = common screen | blue text = form\n    %%           oval ([ ]) = pop-up   | subgraph = screen with several tabs / sections\n\n    LOGIN[\&quot;Login – Customer tab&lt;br/&gt;(phone number + password)\&quot;]:::common\n    NOTI[\&quot;Notifications\&quot;]:::common\n    MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    OTP_V[\&quot;Verify OTP&lt;br/&gt;(step 1/2)\&quot;]:::form\n    NEW_PW[\&quot;Change Password&lt;br/&gt;(step 2/2)\&quot;]:::form\n    LOGIN --&gt; MAIN\n    LOGIN --&gt;|first login with issued password| OTP_V\n    OTP_V --&gt;|OTP correct| NEW_PW\n    NEW_PW --&gt;|password changed| MAIN\n    MAIN --&gt;|bell| NOTI\n    MAIN -.-&gt;|Logout| LOGIN\n\n    %% ===== Tabs =====\n    MAIN --&gt; ORD_L\n    MAIN --&gt; SCAN\n    MAIN --&gt; ACC\n\n    subgraph SCAN[\&quot;Scan QR\&quot;]\n        direction TB\n        SCAN_1[\&quot;&lt;i&gt;Scan Parcel Label&lt;/i&gt;\&quot;]\n        SCAN_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n    end\n    class SCAN tab\n    SCAN --&gt;|label of another store / unknown| SCAN\n\n    %% ===== Orders =====\n    subgraph ORD_L[\&quot;Orders (Home)\&quot;]\n        direction TB\n        ORD_L_0[\&quot;&lt;i&gt;Store Info &amp; Sales in Charge&lt;/i&gt;\&quot;]\n        ORD_L_1[\&quot;&lt;i&gt;Monthly Orders, Paid Total &amp; Loyalty Points&lt;/i&gt;\&quot;]\n        ORD_L_2[\&quot;&lt;i&gt;Best Sellers in Area&lt;/i&gt;\&quot;]\n        ORD_L_5[\&quot;&lt;i&gt;Credit to Pay &amp; Delivering Alert&lt;/i&gt;\&quot;]\n        ORD_L_3[\&quot;&lt;i&gt;In Progress&lt;/i&gt;\&quot;]\n        ORD_L_4[\&quot;&lt;i&gt;Completed&lt;/i&gt;\&quot;]\n        ORD_L_6[\&quot;&lt;i&gt;Search &amp; Date Filter&lt;/i&gt;\&quot;]\n    end\n    class ORD_L tab\n    subgraph ORD_D[\&quot;Order Details\&quot;]\n        direction TB\n        ORD_D_0[\&quot;&lt;i&gt;Allocating / Allocation Error / Out of Stock&lt;/i&gt;\&quot;]\n        ORD_D_9[\&quot;&lt;i&gt;Quote &amp; Response Deadline&lt;/i&gt;\&quot;]\n        ORD_D_6[\&quot;&lt;i&gt;Warehouse Portions &amp; Labels&lt;/i&gt;\&quot;]\n        ORD_D_1[\&quot;&lt;i&gt;Items &amp; Batches (expiry)&lt;/i&gt;\&quot;]\n        ORD_D_7[\&quot;&lt;i&gt;Price per Batch&lt;br/&gt;(after promotion, % shelf-life discount)&lt;/i&gt;\&quot;]\n        ORD_D_2[\&quot;&lt;i&gt;Promotion Received&lt;/i&gt;\&quot;]\n        ORD_D_3[\&quot;&lt;i&gt;Payment (PayOS / Credit) &amp; Points&lt;/i&gt;\&quot;]\n        ORD_D_8[\&quot;&lt;i&gt;Complaints &amp; Replacement Status&lt;/i&gt;\&quot;]\n        ORD_D_5[\&quot;&lt;i&gt;Status Timeline&lt;/i&gt;\&quot;]\n    end\n    class ORD_D tab\n    ORD_L --&gt; ORD_D\n    NOTI --&gt; ORD_D\n\n    %% ===== Self-order (sales order) =====\n    ORD_L --&gt;|+ Place Order| SHOP[\&quot;Products &amp; Quantities&lt;br/&gt;(list price)\&quot;]\n    SHOP --&gt; SHOP_C\n    subgraph SHOP_C[\&quot;Choose Promotion &amp; Confirm\&quot;]\n        direction TB\n        SHOP_C_1[\&quot;&lt;i&gt;One Valid Promotion or None&lt;/i&gt;\&quot;]\n        SHOP_C_3[\&quot;&lt;i&gt;Delivery Address &amp; Desired Date&lt;/i&gt;\&quot;]\n        SHOP_C_2[\&quot;&lt;i&gt;Products &amp; Subtotal after Promotion&lt;br/&gt;(shelf-life discount shown in quote)&lt;/i&gt;\&quot;]\n    end\n    class SHOP_C formTab\n    SHOP_C --&gt;|send: allocating in real time| ORD_D\n    ORD_D --&gt;|out of stock: edit quantity &amp; reorder| SHOP\n    ORD_D --&gt;|allocating / allocation error| WD[\&quot;Withdraw Request&lt;br/&gt;(reason)\&quot;]:::form\n    WD --&gt;|withdrawn, nothing reserved| ORD_D\n\n    %% ===== Quote &amp; payment =====\n    ORD_D --&gt;|accept quote| PAY_CH[\&quot;Accept Quote &amp; Choose Payment&lt;br/&gt;(Prepaid via PayOS / Credit if eligible)\&quot;]:::form\n    ORD_D --&gt;|reject quote| Q_REJ[\&quot;Reject Quote&lt;br/&gt;(reason)\&quot;]:::form\n    Q_REJ --&gt;|rejected: reservation released| ORD_D\n    PAY_CH --&gt;|Credit valid: order becomes PO| ORD_D\n    PAY_CH --&gt;|Prepaid| PAY_O\n    ORD_D --&gt;|awaiting payment| PAY_O\n    subgraph PAY_O[\&quot;PayOS Payment\&quot;]\n        direction TB\n        PAY_O_1[\&quot;&lt;i&gt;Amount (= final quote), Payment Code &amp; Deadline&lt;/i&gt;\&quot;]\n        PAY_O_2[\&quot;&lt;i&gt;QR / Open PayOS Link&lt;/i&gt;\&quot;]\n    end\n    class PAY_O tab\n    PAY_O --&gt;|PayOS webhook: paid in full → PO| ORD_D\n    PAY_O --&gt;|deadline passed: quote closed, stock released| ORD_D\n\n    %% ===== Receiving goods &amp; complaints =====\n    subgraph RCV[\&quot;Receive Goods\&quot;]\n        direction TB\n        RCV_1[\&quot;&lt;i&gt;Scan Labels by Portion&lt;br/&gt;(camera or enter code)&lt;/i&gt;\&quot;]\n        RCV_2[\&quot;&lt;i&gt;Received / Damaged Qty per Label&lt;/i&gt;\&quot;]\n        RCV_3[\&quot;&lt;i&gt;Shortage Result &amp; Amount on Hold&lt;/i&gt;\&quot;]\n    end\n    class RCV tab\n    ORD_D --&gt;|delivering: scan QR| RCV\n    SCAN --&gt;|parcel label of this store| RCV\n    RCV --&gt;|all portions confirmed| DONE[\&quot;Receipt Confirmed&lt;br/&gt;(Delivered, or Receipt Exception if short / damaged)\&quot;]\n    RCV --&gt;|portion with shortage / damage| CMP[\&quot;Send Complaint&lt;br/&gt;(portion, line/batch, reason, qty, photo / note)\&quot;]:::form\n    ORD_D --&gt;|problem with goods| CMP\n    CMP --&gt;|sent| ORD_D\n    ORD_D --&gt;|more evidence requested| CMP_ADD([\&quot;Add Photo / Note&lt;br/&gt;(same complaint)\&quot;])\n    ORD_D --&gt;|complaint rejected: add evidence &amp; resend| CMP\n    CMP_ADD --&gt; ORD_D\n    ORD_D --&gt;|replacement shipped| REP_C([\&quot;Confirm Replacement Received\&quot;])\n    REP_C --&gt; ORD_D\n    DONE --&gt;|view order| ORD_D\n    DONE --&gt;|back to list| ORD_L\n\n    %% ===== Account, payments &amp; loyalty =====\n    subgraph ACC[\&quot;Account\&quot;]\n        direction TB\n        ACC_1[\&quot;&lt;i&gt;Store Info, Code &amp; Phone&lt;/i&gt;\&quot;]\n        ACC_2[\&quot;&lt;i&gt;Sales in Charge&lt;/i&gt;\&quot;]\n        ACC_3[\&quot;&lt;i&gt;Change Password&lt;/i&gt;\&quot;]\n    end\n    class ACC tab\n    subgraph PAY[\&quot;Payments &amp; Credit\&quot;]\n        direction TB\n        PAY_1[\&quot;&lt;i&gt;Paid by Period&lt;/i&gt;\&quot;]\n        PAY_2[\&quot;&lt;i&gt;Credit to Pay, Disputed &amp; Payable Now&lt;/i&gt;\&quot;]\n        PAY_3[\&quot;&lt;i&gt;Refunds (due / refunded)&lt;/i&gt;\&quot;]\n    end\n    class PAY tab\n    subgraph LOY[\&quot;Loyalty Points\&quot;]\n        direction TB\n        LOY_1[\&quot;&lt;i&gt;Available / Held / Pending Points&lt;/i&gt;\&quot;]\n        LOY_3[\&quot;&lt;i&gt;Redeem Gifts&lt;/i&gt;\&quot;]\n        LOY_4[\&quot;&lt;i&gt;My Gifts&lt;/i&gt;\&quot;]\n        LOY_5[\&quot;&lt;i&gt;Points History&lt;/i&gt;\&quot;]\n    end\n    class LOY tab\n    ACC --&gt; PAY\n    ACC --&gt; LOY\n    ORD_L --&gt;|paid / credit| PAY\n    ORD_L --&gt;|points| LOY\n    PAY --&gt;|open order| ORD_D\n    LOY --&gt;|redeem| RDM_C([\&quot;Confirm Redemption&lt;br/&gt;(quantity, points held)\&quot;])\n    RDM_C --&gt;|confirmed| LOY\n    LOY --&gt;|pending request| RDM_X([\&quot;Cancel Request &amp; Return Points\&quot;])\n    RDM_X --&gt; LOY\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7NNfVvMnYlalftfWRUZG-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
