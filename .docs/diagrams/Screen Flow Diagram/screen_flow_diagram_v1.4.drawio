  <diagram id="TbLwSpMvLtq0jaG1fVIX" name="MOBILE - Warehouse Keeper Screen Flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ===== FSCM Warehouse Keeper (Mobile App) - Screen Flow (FSCM_Prototype_Prod_v1.3, baseline 02/11/2026) =====\n    %% Notation: beige = common screen | blue text = create/edit form\n    %%           subgraph = screen with several tabs / sections\n\n    M_LOGIN[\&quot;Login – Staff tab\&quot;]:::common\n    M_NOTI[\&quot;Notifications\&quot;]:::common\n    M_MAIN[\&quot;&lt;b&gt;Main Screen&lt;/b&gt;\&quot;]\n    M_LOGIN --&gt; M_MAIN\n    M_LOGIN --&gt;|Google| M_GG_ACC[\&quot;Choose Google Account\&quot;]:::common\n    M_GG_ACC --&gt;|Warehouse Keeper role| M_GG_WAIT[\&quot;Signing In\&quot;]:::common\n    M_GG_WAIT --&gt; M_MAIN\n    M_GG_ACC --&gt;|no Warehouse Keeper role| M_GG_DENY[\&quot;Access Denied\&quot;]:::common\n    M_GG_DENY --&gt;|choose another account| M_GG_ACC\n    M_GG_DENY --&gt;|back| M_LOGIN\n    M_MAIN --&gt;|bell| M_NOTI\n    M_MAIN -.-&gt;|Logout| M_LOGIN\n\n    %% ===== Tabs =====\n    M_MAIN --&gt; HOME\n    M_MAIN --&gt; PICK_L\n    M_MAIN --&gt; SCAN\n    M_MAIN --&gt; RCV\n    M_MAIN --&gt; ACC[\&quot;Account\&quot;]\n\n    %% ===== Home =====\n    subgraph HOME[\&quot;Home\&quot;]\n        direction TB\n        HOME_1[\&quot;&lt;i&gt;Picking Summary&lt;br/&gt;(to pick / picking / issued)&lt;/i&gt;\&quot;]\n        HOME_2[\&quot;&lt;i&gt;Shortcuts: Receive Goods, Label Lookup, Expired&lt;/i&gt;\&quot;]\n        HOME_4[\&quot;&lt;i&gt;Cycle Count Task (P1)&lt;/i&gt;\&quot;]\n        HOME_3[\&quot;&lt;i&gt;Portions to Pick&lt;/i&gt;\&quot;]\n    end\n    class HOME tab\n    HOME --&gt;|cycle count| M_CNT\n    subgraph M_CNT[\&quot;Cycle Count (P1)\&quot;]\n        direction TB\n        M_CNT_1[\&quot;&lt;i&gt;Count Lines per Batch &amp; Shelf&lt;/i&gt;\&quot;]\n        M_CNT_2[\&quot;&lt;i&gt;Counted Qty per Batch&lt;br/&gt;(match / over / short)&lt;/i&gt;\&quot;]\n        M_CNT_3[\&quot;&lt;i&gt;Variance Note&lt;/i&gt;\&quot;]\n    end\n    class M_CNT formTab\n    M_CNT --&gt;|submit: stock changes only after Admin approves adjustment| M_CNT\n    HOME --&gt;|see all| PICK_L\n    HOME --&gt;|portion| PICK_D\n    HOME --&gt;|receive goods| RCV\n    HOME --&gt;|label lookup| SCAN\n    HOME --&gt;|expired| LOOK\n\n    %% ===== Picking &amp; dispatch =====\n    subgraph PICK_L[\&quot;Picking\&quot;]\n        direction TB\n        PICK_L_0[\&quot;&lt;i&gt;Picking Slips per PO&lt;br/&gt;(one slip per PO &amp; warehouse)&lt;/i&gt;\&quot;]\n        PICK_L_1[\&quot;&lt;i&gt;Portions: All&lt;/i&gt;\&quot;]\n        PICK_L_2[\&quot;&lt;i&gt;Not Picked&lt;/i&gt;\&quot;]\n        PICK_L_3[\&quot;&lt;i&gt;Picking&lt;/i&gt;\&quot;]\n        PICK_L_5[\&quot;&lt;i&gt;Ready&lt;/i&gt;\&quot;]\n        PICK_L_4[\&quot;&lt;i&gt;Issued&lt;/i&gt;\&quot;]\n    end\n    class PICK_L tab\n    subgraph SLIP[\&quot;Picking Slip Details\&quot;]\n        direction TB\n        SLIP_1[\&quot;&lt;i&gt;PO, Issue Time &amp; Progress&lt;/i&gt;\&quot;]\n        SLIP_2[\&quot;&lt;i&gt;Gather by Batch&lt;/i&gt;\&quot;]\n        SLIP_3[\&quot;&lt;i&gt;Split per Order (Batch Price Codes)&lt;/i&gt;\&quot;]\n    end\n    class SLIP tab\n    subgraph PICK_D[\&quot;Portion Details\&quot;]\n        direction TB\n        PICK_D_1[\&quot;&lt;i&gt;Order &amp; Progress&lt;/i&gt;\&quot;]\n        PICK_D_3[\&quot;&lt;i&gt;Whole-order Readiness (all warehouses),&lt;br/&gt;Payment &amp; Block Reasons&lt;/i&gt;\&quot;]\n        PICK_D_2[\&quot;&lt;i&gt;Pick Lines (batch, expiry, shelf, suggested label)&lt;/i&gt;\&quot;]\n        PICK_D_4[\&quot;&lt;i&gt;Dispatch Conditions&lt;/i&gt;\&quot;]\n    end\n    class PICK_D tab\n    subgraph LBL[\&quot;Print Labels\&quot;]\n        direction TB\n        LBL_1[\&quot;&lt;i&gt;Picked (Child) Label&lt;/i&gt;\&quot;]\n        LBL_2[\&quot;&lt;i&gt;Source Label Left on Shelf&lt;/i&gt;\&quot;]\n    end\n    class LBL tab\n    PICK_L --&gt;|slip| SLIP\n    PICK_L --&gt;|portion| PICK_D\n    SLIP --&gt;|order portion| PICK_D\n    PICK_D --&gt;|not accepted yet| ACCEPT([\&quot;Accept Picking Slip\&quot;])\n    ACCEPT --&gt; PICK_D\n    PICK_D --&gt;|pick a line| SRC\n    subgraph SRC[\&quot;Scan Source Label\&quot;]\n        direction TB\n        SRC_1[\&quot;&lt;i&gt;Scan Label&lt;/i&gt;\&quot;]\n        SRC_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n        SRC_3[\&quot;&lt;i&gt;Scan Validation Log&lt;/i&gt;\&quot;]\n    end\n    class SRC tab\n    SRC --&gt;|wrong warehouse / batch / duplicate / locked / expired / over qty: blocked &amp; logged| SRC\n    SRC --&gt;|right batch| QTY[\&quot;Confirm Quantity\&quot;]:::form\n    QTY --&gt;|take whole label or split| LBL\n    LBL --&gt;|next line| SRC\n    LBL --&gt;|all lines picked| PICK_D\n    PICK_D --&gt;|shortage / damaged / wrong label| EXC[\&quot;Report Exception&lt;br/&gt;(photo, reason)\&quot;]:::form\n    SRC --&gt;|report exception| EXC\n    EXC --&gt;|sent: portion blocked, Admin / Keeper resolves on Portal| PICK_D\n    PICK_D --&gt;|all lines scanned: confirm picked| READY([\&quot;System confirms Ready\&quot;])\n    READY --&gt; PICK_D\n    PICK_D --&gt;|all warehouse portions Ready &amp; payment valid: confirm portion dispatch| SHIP[\&quot;Issued&lt;br/&gt;(labels In Transit)\&quot;]\n    SHIP --&gt;|back to slip| SLIP\n\n    %% ===== Label lookup =====\n    subgraph SCAN[\&quot;Scan QR\&quot;]\n        direction TB\n        SCAN_1[\&quot;&lt;i&gt;Scan Any Label&lt;/i&gt;\&quot;]\n        SCAN_2[\&quot;&lt;i&gt;Enter Label Code Manually&lt;/i&gt;\&quot;]\n        SCAN_3[\&quot;&lt;i&gt;Recent Lookups&lt;/i&gt;\&quot;]\n    end\n    class SCAN tab\n    subgraph LOOK[\&quot;Label Lookup\&quot;]\n        direction TB\n        LOOK_1[\&quot;&lt;i&gt;Label Info&lt;/i&gt;\&quot;]\n        LOOK_2[\&quot;&lt;i&gt;Parent / Child Labels&lt;/i&gt;\&quot;]\n        LOOK_3[\&quot;&lt;i&gt;Label History&lt;/i&gt;\&quot;]\n    end\n    class LOOK tab\n    SCAN --&gt;|any label| LOOK\n    LOOK --&gt; REPRINT([\&quot;Reprint Label\&quot;])\n    LOOK --&gt;|in stock| LOCK([\&quot;Lock Label – Damaged Goods&lt;br/&gt;(blocked from allocation)\&quot;])\n    LOOK --&gt;|expired / locked| WO([\&quot;Request Disposal&lt;br/&gt;(Admin approval)\&quot;])\n\n    %% ===== Goods receipt =====\n    subgraph RCV[\&quot;Receive Goods\&quot;]\n        direction TB\n        RCV_1[\&quot;&lt;i&gt;Supplier Document&lt;/i&gt;\&quot;]\n        RCV_2[\&quot;&lt;i&gt;SKU, Production &amp; Expiry Date&lt;/i&gt;\&quot;]\n        RCV_3[\&quot;&lt;i&gt;Total Cartons, System Batch ID &amp; Production Lot&lt;/i&gt;\&quot;]\n        RCV_4[\&quot;&lt;i&gt;Split into Labels (pallets)&lt;/i&gt;\&quot;]\n    end\n    class RCV formTab\n    RCV --&gt;|save &amp; print labels| RCVD[\&quot;Goods Receipt Pending Approval&lt;br/&gt;(stock not increased yet)\&quot;]\n    RCVD --&gt;|Admin approves on Portal| RCVD_OK[\&quot;Goods Received&lt;br/&gt;(batch created, stock increased once)\&quot;]\n    RCVD_OK --&gt; RCV_RE([\&quot;Reprint All Labels\&quot;])\n\n    %% ===== Notification deep links =====\n    M_NOTI --&gt;|picking slip released| SLIP\n    M_NOTI --&gt;|expired label| LOOK\n    M_NOTI --&gt;|retailer confirmed receipt| PICK_D\n    M_NOTI --&gt;|count task| M_CNT\n\n    %% ===== Styles =====\n    classDef default fill:#ffffff,stroke:#111111,color:#111111\n    classDef common fill:#F6E7B4,stroke:#111111,color:#1a1a1a\n    classDef form fill:#ffffff,stroke:#111111,color:#1F3FD1\n    classDef tab fill:#ffffff,stroke:#111111,color:#111111\n    classDef formTab fill:#ffffff,stroke:#111111,color:#1F3FD1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7ee_bTyFH1wR4e17svzg-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
