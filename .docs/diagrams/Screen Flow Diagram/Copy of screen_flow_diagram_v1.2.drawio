        <mxCell id="iZ3q5GTmfEVJ3NBpQ9PE-2" parent="iZ3q5GTmfEVJ3NBpQ9PE-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="27/10/2026" vertex="1">
