        <mxCell id="iZ3q5GTmfEVJ3NBpQ9PE-4" parent="iZ3q5GTmfEVJ3NBpQ9PE-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="Võ Minh Sơn" vertex="1">
          <mxGeometry height="496" width="100" x="160" as="geometry">
            <mxRectangle height="496" width="100" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iZ3q5GTmfEVJ3NBpQ9PE-5" parent="iZ3q5GTmfEVJ3NBpQ9PE-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;align=left;spacingLeft=6;" value="Version 1.3&lt;br&gt;- Add:&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+&amp;nbsp;Added tab “Quote &amp;amp; PO” to the Order Details screen (quote version, response deadline, PO number)&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Modify:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+&amp;nbsp;Changed the transition from Order Details to “Assign Vehicle to Portion” from “allocated” to “PO created” (only orders that have become a PO get picking slips and vehicles)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+&amp;nbsp;Renamed form “Record Payment” to “Verify Payment &amp;amp; Create PO”; transition condition changed from “prepaid / COD” to “awaiting prepayment” (COD removed)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+&amp;nbsp;Added form “Record Delivery Failure”, opened from Order Details when the order is delivering&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+&amp;nbsp;Added notification deep link “transfer proof submitted” → Order Details&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="496" width="270" x="260" as="geometry">
            <mxRectangle height="496" width="270" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6zYpk7R-wzPlWVRNCzfr-27" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b style=&quot;font-weight:normal;&quot; id=&quot;docs-internal-guid-84562742-7fff-8c86-8b8e-b056e28f631e&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.295;margin-top:5pt;margin-bottom:12pt;&quot;&gt;&lt;span style=&quot;font-size:9pt;font-family:Calibri,sans-serif;color:#404040;background-color:transparent;font-weight:400;font-style:italic;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;*A - Added&amp;nbsp; &amp;nbsp; M - Modified&amp;nbsp; &amp;nbsp; D - Deleted&lt;/span&gt;&lt;/p&gt;&lt;/b&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" vertex="1">
          <mxGeometry height="40" width="200" x="-1230" y="2420" as="geometry" />
        </mxCell>
      </root>
