        </mxCell>
        <mxCell id="pB1rJ_g2uXBPH5HbG3bR-5" parent="pB1rJ_g2uXBPH5HbG3bR-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;align=left;spacingLeft=6;" value="Version 1.2&lt;br&gt;- Modify screen flow diagram of Web Portal based on Prototype Prod&lt;br&gt;- Add “choose another account” from Access Denied back to Choose Microsoft Account" vertex="1">
          <mxGeometry height="219" width="270" x="260" as="geometry">
            <mxRectangle height="219" width="270" as="alternateBounds" />
