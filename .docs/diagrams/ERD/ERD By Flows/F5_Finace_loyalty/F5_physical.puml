@startchen F5_physical

title F5 – Physical ERD (Chen) – Payment Collection, Completion, Loyalty, Claims and After-sales

entity PAYMENT_RECEIPT {
  "Id : uuid PK" as Id <<key>>
  "ReceiptCode : varchar(40) UQ NN" as ReceiptCode
  "RetailerId : uuid FK→RETAILER NN" as RetailerId
  "CollectionMethod : varchar(30) NN" as CollectionMethod
  "ReceivedAmount : numeric(18,2) NN" as ReceivedAmount
  "AppliedAmount : numeric(18,2) NN" as AppliedAmount
  "UnappliedCreditAmount : numeric(18,2) NN" as UnappliedCreditAmount
  "ReceivedAt : timestamptz NN" as ReceivedAt
  "Reference : varchar(100) NULL" as Reference
  "EvidenceUrls : jsonb NULL" as EvidenceUrls
  "Status : smallint NN" as Status
  "RecordedByUserId : uuid FK→USER_ACCOUNT NN" as RecordedByUserId
  "ConfirmedByUserId : uuid FK→USER_ACCOUNT NULL" as ConfirmedByUserId
  "ConfirmedAt : timestamptz NULL" as ConfirmedAt
  "ReversedByUserId : uuid FK→USER_ACCOUNT NULL" as ReversedByUserId
  "ReversedAt : timestamptz NULL" as ReversedAt
  "ReversalReason : text NULL" as ReversalReason
  "ReplacesReceiptId : uuid FK→PAYMENT_RECEIPT UQ NULL" as ReplacesReceiptId
  "OperationKey : varchar(80) UQ NN" as OperationKey
  "Version : integer NN" as Version
}
entity PAYMENT_RECEIPT_ALLOCATION {
  "Id : uuid PK" as Id <<key>>
  "PaymentReceiptId : uuid FK→PAYMENT_RECEIPT NN" as PaymentReceiptId
  "PaymentId : uuid FK→PAYMENT NN" as PaymentId
  "Amount : numeric(18,2) NN" as Amount
