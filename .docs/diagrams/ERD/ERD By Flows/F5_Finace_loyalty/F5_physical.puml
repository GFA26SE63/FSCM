  "ReviewedByUserId : uuid FK→USER_ACCOUNT NULL" as ReviewedByUserId
  "Status : smallint NN" as Status
  "ResolutionType : smallint NULL" as ResolutionType
  "Description : text NULL" as Description
  "DecisionReason : text NULL" as DecisionReason
  "SubmittedAt : timestamptz NN" as SubmittedAt
  "ReviewedAt : timestamptz NULL" as ReviewedAt
  "DecidedAt : timestamptz NULL" as DecidedAt
  "ResolvedAt : timestamptz NULL" as ResolvedAt
