@startchen F5_logical

title F5 – Logical ERD (Chen) – Payment Collection, Completion, Loyalty, Claims and After-sales

entity PaymentReceipt {
  ReceiptCode <<key>>
  CollectionMethod
  ReceivedAmount
  AppliedAmount <<derived>>
  UnappliedCreditAmount <<derived>>
  ReceivedAt
  Reference
  EvidenceUrls <<multi>>
  Status
  ConfirmedAt
  ReversedAt
  ReversalReason
}
entity PaymentReceiptAllocation {
  Amount
  ApplyOrder
  IsSystemSuggested
  Status
  CreatedAt
}
entity Claim {
  ClaimCode <<key>>
  Status
  ResolutionType
  Description
  DecisionReason
  SubmittedAt
  ReviewedAt
  DecidedAt
  ResolvedAt
}
entity ClaimItem <<weak>> {
  LineNumber <<key>>
  IssueType
  AffectedQuantity
  ApprovedQuantity
  FinalUnitPrice
  AdjustmentAmount <<derived>>
  Note
}
entity FinancialAdjustment {
  AdjustmentCode <<key>>
  AdjustmentAmount
  ReceivableReductionAmount
  RefundObligationAmount
  ApprovedAt
  Note
}
entity ReplacementCase {
  ReplacementCode <<key>>
  Status
  ApprovedAt
  PreparingAt
  ShippedAt
  ReceivedAt
}
entity ManualRefund {
  RefundCode <<key>>
  Amount
  Recipient
  Reason
  Status
  VerifiedAt
  CreatedAt
}
entity ClaimEvidence {
  Id <<key>>
}
entity RefundEvidence <<weak>> {
  SubmissionNo <<key>>
}
entity CustomerReturnReceipt {
  ReturnCode <<key>>
  Status
}
entity LoyaltyProgram {
  Code <<key>>
}
entity LoyaltyProgramRetailer {
}
entity LoyaltyAccount {
  Id <<key>>
}
entity LoyaltyTransaction {
  Id <<key>>
}
entity LoyaltyReward {
  Code <<key>>
}
entity RewardRedemption {
  RedemptionCode <<key>>
  Status
}
entity Payment {
  PaymentCode <<key>>
  Method
  Status
  Amount
  AdjustedAmount
  ConfirmedAmount
  RefundedAmount
  OutstandingAmount <<derived>>
  DueDate
}
entity SalesOrder {
  OrderCode <<key>>
  Status
  CompletedAt
}
entity Retailer {
  Code <<key>>
}
entity Shipment {
  ShipmentCode <<key>>
  Status
}
entity ReceiptConfirmationItem {
  LineNumber <<key>>
  ReceivedQuantity
  DamagedQuantity
  MissingQuantity
}
entity Warehouse {
  Code <<key>>
}
entity Batch {
  BatchCode <<key>>
}
entity UserAccount {
  Email <<key>>
}

relationship "submits payment receipt" as R_PAYMENT_RECEIPT_RetailerId {
}
relationship "records payment receipt" as R_PAYMENT_RECEIPT_RecordedByUserId {
}
relationship "confirms payment receipt" as R_PAYMENT_RECEIPT_ConfirmedByUserId {
}
relationship "reverses payment receipt" as R_PAYMENT_RECEIPT_ReversedByUserId {
}
relationship "is replaced by" as R_PAYMENT_RECEIPT_ReplacesReceiptId {
}
relationship "allocates amount" as R_PAYMENT_RECEIPT_ALLOCATION_PaymentReceiptId {
}
relationship "is offset" as R_PAYMENT_RECEIPT_ALLOCATION_PaymentId {
}
relationship "is claimed" as R_RECEIPT_DISCREPANCY_ShipmentId {
}
relationship "submits claim" as R_RECEIPT_DISCREPANCY_ReportedByUserId {
}
relationship "reviews claim" as R_RECEIPT_DISCREPANCY_ReviewedByUserId {
}
relationship "has claim item" as R_RECEIPT_DISCREPANCY_ITEM_ReceiptDiscrepancyId <<identifying>> {
}
relationship "is affected" as R_RECEIPT_DISCREPANCY_ITEM_ReceiptConfirmationItemId {
}
relationship "is financially adjusted" as R_FINANCIAL_ADJUSTMENT_ReceiptDiscrepancyId {
}
