relationship "is replaced" as R_REPLACEMENT_CASE_ReceiptDiscrepancyId {
}
relationship "processes replacement" as R_REPLACEMENT_CASE_WarehouseId {
}
relationship "handles replacement" as R_REPLACEMENT_CASE_HandledByUserId {
}
relationship "is refunded" as R_MANUAL_REFUND_PaymentId {
}
relationship "generates refund" as R_MANUAL_REFUND_FinancialAdjustmentId {
}
relationship "creates refund record" as R_MANUAL_REFUND_CreatedByUserId {
}
relationship "verifies refund" as R_MANUAL_REFUND_VerifiedByUserId {
}
relationship "has evidence" as R_RECEIPT_DISCREPANCY_ATTACHMENT_ReceiptDiscrepancyId {
}
relationship "is evidence for" as R_RECEIPT_DISCREPANCY_ATTACHMENT_ReceiptDiscrepancyItemId {
}
relationship "uploads evidence" as R_RECEIPT_DISCREPANCY_ATTACHMENT_UploadedByUserId {
}
relationship "has evidence" as R_MANUAL_REFUND_EVIDENCE_ManualRefundId <<identifying>> {
}
relationship "submits evidence" as R_MANUAL_REFUND_EVIDENCE_SubmittedByUserId {
}
relationship "generates return" as R_CUSTOMER_RETURN_RECEIPT_ReceiptDiscrepancyId {
}
relationship "receives return" as R_CUSTOMER_RETURN_RECEIPT_WarehouseId {
}
relationship "is returned" as R_CUSTOMER_RETURN_RECEIPT_BatchId {
}
relationship "inspects return" as R_CUSTOMER_RETURN_RECEIPT_ReceivedByUserId {
}
relationship "has participating retailer" as R_LOYALTY_PROGRAM_RETAILER_LoyaltyProgramId {
}
relationship "joins program" as R_LOYALTY_PROGRAM_RETAILER_RetailerId {
}
relationship "owns loyalty account" as R_RETAILER_LOYALTY_RetailerId {
}
relationship "records point movement" as R_LOYALTY_TRANSACTION_RetailerLoyaltyId {
}
relationship "accrues points by" as R_LOYALTY_TRANSACTION_LoyaltyProgramId {
}
relationship "earns points from order" as R_LOYALTY_TRANSACTION_SalesOrderId {
}
relationship "adjusts points by" as R_LOYALTY_TRANSACTION_ReceiptDiscrepancyId {
}
relationship "deducts points for" as R_LOYALTY_TRANSACTION_RewardRedemptionId {
}
relationship "has reward" as R_LOYALTY_REWARD_LoyaltyProgramId {
}
relationship "redeems reward" as R_REWARD_REDEMPTION_RetailerId {
}
relationship "is redeemed" as R_REWARD_REDEMPTION_LoyaltyRewardId {
}
relationship "approves redemption" as R_REWARD_REDEMPTION_ApprovedByUserId {
}
relationship "generates receivable" as R_PAYMENT_SalesOrderId {
}
relationship "places order" as R_SALES_ORDER_RetailerId {
}
relationship "is delivered via" as R_SHIPMENT_SalesOrderId {
}

