}
entity "AllocationAttemptLine\nAllocation run line (with line trace)" as AllocationAttemptLine <<weak>> {
}
entity "Allocation\nAllocation by warehouse-batch (with final price)" as Allocation <<weak>> {
}
entity "Reservation\nReservation" as Reservation {
}
entity "SalesOrderQuote\nFinal quote" as SalesOrderQuote <<weak>> {
}
entity "SalesOrder\nSales order (SO)" as SalesOrder {
}
entity "SalesOrderLine\nSales order line" as SalesOrderLine <<weak>> {
}
entity "Product\nProduct (SKU)" as Product {
}
entity "Warehouse\nWarehouse" as Warehouse {
}
entity "Batch\nBatch" as Batch {
}
entity "InventoryBalance\nInventory balance by batch" as InventoryBalance {
}
entity "InventoryLock\nInventory lock (damaged/expired/recall)" as InventoryLock {
}
entity "TransitTable\nTransit time table" as TransitTable {
}
entity "ShelfLifeDiscountTable\nShelf-life discount table" as ShelfLifeDiscountTable {
}
entity "ShelfLifeDiscountTier\nDiscount tier by remaining shelf-life %" as ShelfLifeDiscountTier <<weak>> {
}
entity "UserAccount\nUser account" as UserAccount {
}

