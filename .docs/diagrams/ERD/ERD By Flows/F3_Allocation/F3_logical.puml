R_SALES_ORDER_LINE_SalesOrderId =1= SalesOrder
R_SALES_ORDER_LINE_SalesOrderId =N= SalesOrderLine
R_SALES_ORDER_LINE_ProductId -1- Product
R_SALES_ORDER_LINE_ProductId =N= SalesOrderLine
R_BATCH_ProductId -1- Product
R_BATCH_ProductId =N= Batch
R_BATCH_WarehouseId -1- Warehouse
R_BATCH_WarehouseId =N= Batch
R_INVENTORY_BALANCE_BatchId =1= Batch
R_INVENTORY_BALANCE_BatchId =1= InventoryBalance
R_INVENTORY_LOCK_BatchId -1- Batch
