R_ALLOCATION_TRACE_SCORE_AllocationRunLineId -1- AllocationAttemptLine
R_ALLOCATION_TRACE_SCORE_AllocationRunLineId =N= AllocationScoreTrace
R_ALLOCATION_TRACE_SCORE_BatchId -1- Batch
R_ALLOCATION_TRACE_SCORE_BatchId =N= AllocationScoreTrace
R_ALLOCATION_AllocationRunLineId -1- AllocationAttemptLine
R_ALLOCATION_AllocationRunLineId =N= Allocation
R_ALLOCATION_BatchId -1- Batch
R_ALLOCATION_BatchId =N= Allocation
R_ALLOCATION_ShelfLifeDiscountTierId -1- ShelfLifeDiscountTier
R_ALLOCATION_ShelfLifeDiscountTierId -N- Allocation
R_RESERVATION_AllocationId -1- Allocation
R_RESERVATION_AllocationId =1= Reservation
R_SALES_ORDER_QUOTE_SalesOrderId -1- SalesOrder
R_SALES_ORDER_QUOTE_SalesOrderId =N= SalesOrderQuote
R_SALES_ORDER_QUOTE_AllocationRunId -1- AllocationAttempt
R_SALES_ORDER_QUOTE_AllocationRunId =1= SalesOrderQuote
R_SALES_ORDER_QUOTE_DecidedByUserId -1- UserAccount
