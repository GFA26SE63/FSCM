@startchen F3_logical

title F3 – Logical ERD (Chen) – Real-time Allocation, Shelf-life Pricing, Reservation and Quotation

entity AllocationAttempt {
  RunCode <<key>>
  AttemptNumber
  TriggerType
  AlgorithmSettings
  Status
  ConcurrencyRetryCount
  StartedAt
  SnapshotCompletedAt
  CompletedAt
  FailureReason
  TechnicalErrorCode
}
entity AllocationAttemptLine <<weak>> {
  LineNumber <<key>>
  OrderedQuantity
  AllocatedQuantity
  ShortageQuantity <<derived>>
  EffectiveMlorRatio
  MlorSource
  RequiredShelfLifeHours
  MaxServingDistanceMeters
  Outcome
  Note
}
entity AllocationCandidateTrace {
  Stage
  Passed
  Reason
  DistanceMeters
  EstimatedArrivalAt
  AvailableQuantity
  RemainingShelfLifeHours
  RequiredShelfLifeHours
}
entity AllocationScoreTrace {
  Iteration
  Rank
  ShelfLifeScore
  DistanceScore
  CoverageScore
  WeightedScore
  RemainingDemand
  Selected
  SelectedQuantity
}
entity Allocation <<weak>> {
  AllocationSequence <<key>>
  AllocatedQuantity
  EstimatedArrivalAt
  DistanceMeters
  RemainingShelfLifePercent
  WeightedScore
  ListUnitPrice
  PromotionDiscountPercent
  BaseNetUnitPrice
  ShelfLifeDiscountPercent
  FinalUnitPrice
  GrossAmount
  NetAmount <<derived>>
  PriceExplanation
  Status
}
entity Reservation {
  Id <<key>>
  Quantity
  Status
  ReservedAt
  ExpiresAt
  ReleasedAt
  ReleaseReason
  ConsumedAt
}
entity SalesOrderQuote <<weak>> {
  RevisionNumber <<key>>
  ListAmount
  PromotionDiscountAmount
  ShelfLifeDiscountAmount
  TotalAmount <<derived>>
  IssuedAt
  ExpiresAt
  Status
  DecidedAt
  RejectionReason
}
entity Notification {
  Id <<key>>
}
entity SalesOrder {
  OrderCode <<key>>
  Status
  AcceptedAt
}
entity SalesOrderLine <<weak>> {
  LineNumber <<key>>
  OrderedQuantity
  BaseNetUnitPrice
  MlorMinimumLifeRatio
}
entity Product {
  Sku <<key>>
}
entity Warehouse {
  Code <<key>>
  Latitude
  Longitude
  ServiceRadiusMeters
}
entity Batch {
  BatchCode <<key>>
  ExpirationDate
}
entity InventoryBalance {
  Id <<key>>
  PhysicalQuantity
  ReservedQuantity
  LockedQuantity
  LockedReservedQuantity
  AvailableQuantity <<derived>>
}
entity InventoryLock {
  LockCode <<key>>
  LockedQuantity
  Status
}
entity TransitTable {
  VersionNumber <<key>>
}
entity ShelfLifeDiscountTable {
  VersionNumber <<key>>
}
entity ShelfLifeDiscountTier <<weak>> {
  TierNo <<key>>
  MinRemainingPercent
  MaxRemainingPercent
  DiscountPercent
}
entity UserAccount {
  Email <<key>>
}
entity OutboxMessage {
  Id <<key>>
}

relationship "is allocated via" as R_ALLOCATION_RUN_SalesOrderId {
}
relationship "is retry of" as R_ALLOCATION_RUN_RetryOfAllocationRunId {
}
relationship "requests retry" as R_ALLOCATION_RUN_TriggeredByUserId {
}
relationship "provides ETA" as R_ALLOCATION_RUN_TransitTableId {
}
relationship "provides discount tier" as R_ALLOCATION_RUN_ShelfLifeDiscountTableId {
}
relationship "evaluates order line" as R_ALLOCATION_RUN_LINE_AllocationRunId <<identifying>> {
}
relationship "is snapshotted into" as R_ALLOCATION_RUN_LINE_SalesOrderLineId {
}
relationship "evaluates candidate" as R_ALLOCATION_TRACE_CANDIDATE_AllocationRunLineId {
}
relationship "is candidate" as R_ALLOCATION_TRACE_CANDIDATE_BatchId {
}
relationship "scores candidate" as R_ALLOCATION_TRACE_SCORE_AllocationRunLineId {
}
relationship "is scored" as R_ALLOCATION_TRACE_SCORE_BatchId {
}
relationship "is allocated" as R_ALLOCATION_AllocationRunLineId <<identifying>> {
}
relationship "allocated from batch" as R_ALLOCATION_BatchId {
}
relationship "applies shelf-life discount" as R_ALLOCATION_ShelfLifeDiscountTierId {
}
relationship "is reserved by" as R_RESERVATION_AllocationId {
}
relationship "receives quote" as R_SALES_ORDER_QUOTE_SalesOrderId <<identifying>> {
}
relationship "issues quote" as R_SALES_ORDER_QUOTE_AllocationRunId {
}
relationship "decides quote" as R_SALES_ORDER_QUOTE_DecidedByUserId {
}
relationship "receives notification" as R_NOTIFICATION_UserAccountId {
}
relationship "relates to order" as R_NOTIFICATION_SalesOrderId {
}
relationship "emitted from event" as R_NOTIFICATION_OutboxMessageId {
}
relationship "has order line" as R_SALES_ORDER_LINE_SalesOrderId <<identifying>> {
}
relationship "is ordered" as R_SALES_ORDER_LINE_ProductId {
}
relationship "has batch" as R_BATCH_ProductId {
}
relationship "stores batch" as R_BATCH_WarehouseId {
}
relationship "has inventory balance" as R_INVENTORY_BALANCE_BatchId {
}
relationship "is locked" as R_INVENTORY_LOCK_BatchId {
}
relationship "has discount tier" as R_SHELF_LIFE_DISCOUNT_TIER_ShelfLifeDiscountTableId <<identifying>> {
}

