R_PICKING_LIST_CompletedByUserId -N- PickingList
R_PICKING_ITEM_PickingListId =1= PickingList
R_PICKING_ITEM_PickingListId =N= PickingItem
R_PICKING_ITEM_AllocationId -1- Allocation
R_PICKING_ITEM_AllocationId =1= PickingItem
R_PICKING_ITEM_BatchId -1- Batch
R_PICKING_ITEM_BatchId =N= PickingItem
R_PICKING_SCAN_PickingListId -1- PickingList
R_PICKING_SCAN_PickingListId =N= PickingScan
R_PICKING_SCAN_PickingItemId -1- PickingItem
R_PICKING_SCAN_PickingItemId -N- PickingScan
R_PICKING_SCAN_BatchQrLabelId -1- BatchQrLabel
R_PICKING_SCAN_BatchQrLabelId -N- PickingScan
R_PICKING_SCAN_ScannedBatchId -1- Batch
R_PICKING_SCAN_ScannedBatchId -N- PickingScan
R_PICKING_SCAN_ScannedByUserId -1- UserAccount
R_PICKING_SCAN_ScannedByUserId =N= PickingScan
R_SHIPMENT_SalesOrderId -1- SalesOrder
R_SHIPMENT_SalesOrderId =N= Shipment
R_SHIPMENT_PickingListId -1- PickingList
R_SHIPMENT_PickingListId =1= Shipment
R_SHIPMENT_DriverId -1- Driver
R_SHIPMENT_DriverId -N- Shipment
R_SHIPMENT_VehicleId -1- Vehicle
R_SHIPMENT_VehicleId -N- Shipment
R_RECEIPT_CONFIRMATION_ShipmentId -1- Shipment
R_RECEIPT_CONFIRMATION_ShipmentId =1= ReceiptConfirmation
R_RECEIPT_CONFIRMATION_ConfirmedByUserId -1- UserAccount
R_RECEIPT_CONFIRMATION_ConfirmedByUserId =N= ReceiptConfirmation
R_RECEIPT_CONFIRMATION_ITEM_ReceiptConfirmationId =1= ReceiptConfirmation
R_RECEIPT_CONFIRMATION_ITEM_ReceiptConfirmationId =N= ReceiptConfirmationItem
R_RECEIPT_CONFIRMATION_ITEM_PickingItemId -1- PickingItem
R_RECEIPT_CONFIRMATION_ITEM_PickingItemId =N= ReceiptConfirmationItem
R_RECEIPT_CONFIRMATION_ITEM_BatchQrLabelId -1- BatchQrLabel
R_RECEIPT_CONFIRMATION_ITEM_BatchQrLabelId -N- ReceiptConfirmationItem
R_PICKING_EXCEPTION_PickingListId -1- PickingList
R_PICKING_EXCEPTION_PickingListId =N= PickingException
R_PICKING_EXCEPTION_PickingItemId -1- PickingItem
R_PICKING_EXCEPTION_PickingItemId -N- PickingException
R_PICKING_EXCEPTION_RaisedByUserId -1- UserAccount
R_PICKING_EXCEPTION_RaisedByUserId =N= PickingException
R_PICKING_EXCEPTION_ResolvedByUserId -1- UserAccount
R_PICKING_EXCEPTION_ResolvedByUserId -N- PickingException
R_DRIVER_WarehouseId -1- Warehouse
R_DRIVER_WarehouseId =N= Driver
R_VEHICLE_WarehouseId -1- Warehouse
R_VEHICLE_WarehouseId =N= Vehicle
R_SALES_ORDER_QUOTE_SalesOrderId -1- SalesOrder
R_SALES_ORDER_QUOTE_SalesOrderId =N= SalesOrderQuote
R_ALLOCATION_BatchId -1- Batch
R_ALLOCATION_BatchId =N= Allocation
R_RESERVATION_AllocationId -1- Allocation
