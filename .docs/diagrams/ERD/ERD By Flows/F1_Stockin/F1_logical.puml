@startchen F1_logical

title F1 – Logical ERD (Chen) – Sourcing, Retailer and Master Data

entity Region {
  Code <<key>>
  Name
  Description
  IsActive
  CreatedAt
}
entity Warehouse {
  Code <<key>>
  Name
  Address
  Latitude
  Longitude
  ServiceRadiusMeters
  MinimumStockThresholdCartons
  Status
  CreatedAt
}
entity UserAccount {
  Email <<key>>
  FullName
  Phone
  Role
  GoogleSubject
  IsActive
  LockReason
  LockEffectiveAt
  LastLoginAt
  CreatedAt
}
entity ProductCategory {
  Code <<key>>
  Name
  Description
  IsActive
  CreatedAt
}
entity Product {
  Sku <<key>>
  Name
  Unit
  ShelfLifeHours
  NearDateThresholdHours
  DefaultMinimumLifeRatio
  Status
  PublishedAt
  InactivatedAt
  CreatedAt
}
entity ProductPrice {
  Id <<key>>
  UnitPrice
  EffectiveFrom
  EffectiveTo
  Status
  CreatedAt
}
entity Retailer {
  Code <<key>>
  Name
  RetailerType
  StoreSizeCategory
  PurchasingCapacity
  Address
  Latitude
  Longitude
  ContactName
  ContactPhone
  ContactEmail
  Status
  ReviewReason
  SubmittedAt
  ReviewedAt
  CreatedAt
}
entity RetailerCreditProfile {
  Id <<key>>
  CreditLimitAmount
  AllowedTermDays
  MinCompletedPrepaidOrders
  CompletedPrepaidOrders <<derived>>
  CurrentOutstandingAmount <<derived>>
  HasOverdue <<derived>>
  EligibilityStatus
  ApprovedAt
  EffectiveFrom
}
entity RetailerCategoryMlor {
  MinimumLifeRatio
  EffectiveFrom
  EffectiveTo
  IsActive
}
entity RetailerProductMlor {
  MinimumLifeRatio
  EffectiveFrom
  EffectiveTo
  IsActive
}
entity Promotion {
  Code <<key>>
  Name
  PromotionType
  MinimumQuantity
  DiscountPercent
  StartAt
  EndAt
  IsActive
  CreatedAt
}
entity ShelfLifeDiscountTable {
  VersionNumber <<key>>
  EffectiveFrom
  EffectiveTo
  IsActive
  Note
  CreatedAt
}
entity ShelfLifeDiscountTier <<weak>> {
  TierNo <<key>>
  Scope
  MinRemainingPercent
  MaxRemainingPercent
  DiscountPercent
}
entity GoodsReceipt {
  ReceiptCode <<key>>
  Status
  ReceivedAt
  RejectionReason
  CreatedAt
}
entity GoodsReceiptLine <<weak>> {
  LineNumber <<key>>
  SourceLotCode
  ProductionDate
  ExpirationDate
  ReceivedQuantity
}
entity Batch {
  BatchCode <<key>>
  ProductionDate
  ExpirationDate
  ExpiryStatus
  StockStatus
  CreatedAt
}
entity InventoryBalance {
  Id <<key>>
  PhysicalQuantity
  ReservedQuantity
  LockedQuantity
  LockedReservedQuantity
  AvailableQuantity <<derived>>
  UpdatedAt
}
entity InventoryLock {
  LockCode <<key>>
  LockedQuantity
  Reason
  Note
  EvidenceUrls <<multi>>
  Status
  LockedAt
  ReleasedAt
}
entity InventoryTransaction {
  Id <<key>>
  TransactionType
  PhysicalQuantityDelta
  ReservedQuantityDelta
  LockedQuantityDelta
  PhysicalQuantityAfter
  ReservedQuantityAfter
  AvailableQuantityAfter
  SourceType
  SourceId
  ReferenceCode
  Reason
  OccurredAt
}
entity WriteOff {
  WriteOffCode <<key>>
  Reason
  EvidenceUrls <<multi>>
  Status
  ApprovedAt
  CreatedAt
}
entity WriteOffItem <<weak>> {
  LineNumber <<key>>
  Quantity
}
entity UserSession {
  Id <<key>>
}
entity UserRegionAssignment {
}
entity UserWarehouseAssignment {
}
entity SalesGroup {
  Code <<key>>
}
entity SalesGroupMember {
}
entity RetailerSalesAssignment {
}
entity PromotionProduct {
}
entity PromotionCategory {
}
entity PromotionRetailer {
}
entity TransitTable {
  VersionNumber <<key>>
}
entity TransitTableBand <<weak>> {
  BandNo <<key>>
}
entity SystemConfiguration {
  ConfigKey <<key>>
}
entity BatchQrLabel {
  QrCode <<key>>
  Status
}
entity InventoryCountSession {
  CountCode <<key>>
  Status
}
entity InventoryCountLine <<weak>> {
  LineNumber <<key>>
  Status
}
entity AuditLog {
  Id <<key>>
}

