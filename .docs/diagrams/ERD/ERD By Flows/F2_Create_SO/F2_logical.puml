R_IDEMPOTENCY_KEY_UserAccountId =N= IdempotencyRecord
R_IDEMPOTENCY_KEY_SalesOrderId -1- SalesOrder
R_IDEMPOTENCY_KEY_SalesOrderId -1- IdempotencyRecord
