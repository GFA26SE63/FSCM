R_MAP_DISTANCE_CACHE_WarehouseId =N= DistanceCache
R_MAP_DISTANCE_CACHE_RetailerId -1- Retailer
R_MAP_DISTANCE_CACHE_RetailerId =N= DistanceCache
R_RETAILER_RegionId -1- Region
R_RETAILER_RegionId =N= Retailer
R_SALES_GROUP_RegionId -1- Region
R_SALES_GROUP_RegionId =N= SalesGroup
R_WAREHOUSE_RegionId -1- Region
R_WAREHOUSE_RegionId =N= Warehouse
R_PRODUCT_ProductCategoryId -1- ProductCategory
R_PRODUCT_ProductCategoryId =N= Product
R_PRODUCT_PRICE_ProductId -1- Product
R_PRODUCT_PRICE_ProductId =N= ProductPrice
R_RETAILER_PRODUCT_MLOR_RetailerId -1- Retailer
R_RETAILER_PRODUCT_MLOR_RetailerId =N= RetailerProductMlor
R_RETAILER_PRODUCT_MLOR_ProductId -1- Product
R_RETAILER_PRODUCT_MLOR_ProductId =N= RetailerProductMlor
R_RETAILER_CATEGORY_MLOR_RetailerId -1- Retailer
R_RETAILER_CATEGORY_MLOR_RetailerId =N= RetailerCategoryMlor
R_RETAILER_CATEGORY_MLOR_ProductCategoryId -1- ProductCategory
