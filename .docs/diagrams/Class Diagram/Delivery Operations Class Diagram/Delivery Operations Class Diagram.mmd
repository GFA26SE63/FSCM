%% ==========================================
%% API DEPENDENCIES
%% ==========================================

ShipmentsController ..> ShipmentService : uses

DeliveriesController ..> DeliveryService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

ShipmentService ..> IShipmentStore : uses

DeliveryService ..> IDeliveryStore : uses

DeliveryEtaService ..> IDeliveryEtaStore : uses

ShipmentService ..> OrderCompletionService : evaluates completion

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

ShipmentStore ..|> IShipmentStore : implements

DeliveryStore ..|> IDeliveryStore : implements

DeliveryEtaStore ..|> IDeliveryEtaStore : implements

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

ShipmentStore ..> Shipment : manages

ShipmentStore ..> ReceiptConfirmation : records

ShipmentStore ..> InventoryTransaction : records dispatch

DeliveryStore ..> Delivery : manages order delivery

DeliveryStore ..> Driver : manages

DeliveryStore ..> Vehicle : manages

DeliveryEtaStore ..> MapLocation : reads

DeliveryEtaStore ..> MapDistanceCache : reads

%% ==========================================
%% SALES ORDER RELATIONSHIPS
%% ==========================================

Retailer "1" -- "0..*" SalesOrder : places

SalesOrder "1" -- "0..1" PurchaseOrder : generates

SalesOrder "1" -- "0..*" Shipment : has shipments

SalesOrder "1" -- "0..1" Delivery : order-level record

SalesOrder "1" -- "0..*" OrderStatusHistory : status history

%% ==========================================
%% WAREHOUSE RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" Shipment : ships from

Warehouse "1" -- "0..*" Driver : manages drivers

Warehouse "1" -- "0..*" Vehicle : manages vehicles

Warehouse "1" -- "0..*" PickingList : picking lists

%% ==========================================
%% DRIVER ASSIGNMENT
%% ==========================================

Driver "0..1" -- "0..*" Shipment : assigned driver

Driver "0..1" -- "0..*" Delivery : delivery driver

%% ==========================================
%% VEHICLE ASSIGNMENT
%% ==========================================

Vehicle "0..1" -- "0..*" Shipment : assigned vehicle

Vehicle "0..1" -- "0..*" Delivery : delivery vehicle

%% ==========================================
%% PURCHASE ORDER AND PICKING
%% ==========================================

PurchaseOrder "1" -- "0..*" PickingList : releases

PickingList "0..1" -- "0..*" Shipment : picking source

%% ==========================================
%% SHIPMENT AND RECEIPT
%% ==========================================

Shipment "1" -- "0..1" ReceiptConfirmation : confirmed by

%% ==========================================
%% LOCATION RELATIONSHIPS
%% ==========================================

Warehouse "0..1" -- "0..*" MapLocation : warehouse location

Retailer "0..1" -- "0..*" MapLocation : retailer location

MapLocation "1" -- "0..*" MapDistanceCache : origin

MapLocation "1" -- "0..*" MapDistanceCache : destination

Warehouse "1" -- "0..*" MapDistanceCache : origin warehouse

Retailer "1" -- "0..*" MapDistanceCache : destination retailer