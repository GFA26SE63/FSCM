%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class ShipmentsController {
        <<Controller>>
        +List()
        +Get()
        +OrderReadiness()
        +OrderDeliveryView()
        +Assign()
        +ConfirmIssue()
        +Dispatch()
        +FlagException()
        +ConfirmReceipt()
        +Sync()
    }

    class DeliveriesController {
        <<Controller>>
        +List()
        +GetByOrder()
        +Drivers()
        +Vehicles()
        +CreateDriver()
        +UpdateDriver()
        +SetDriverStatus()
        +CreateVehicle()
        +UpdateVehicle()
        +SetVehicleStatus()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class ShipmentService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +GetOrderReadinessAsync()
        +GetRetailerOrderDeliveryAsync()
        +AssignAsync()
        +ConfirmIssueAsync()
        +DispatchAsync()
        +FlagExceptionAsync()
        +ConfirmReceiptAsync()
        +SyncOrderAsync()
        -BuildReadinessAsync()
        -IsPaymentSettledAsync()
    }

    class DeliveryService {
        <<Service>>
        +ListAsync()
        +GetByOrderAsync()
        +ListDriversAsync()
        +CreateDriverAsync()
        +UpdateDriverAsync()
        +SetDriverActiveAsync()
        +ListVehiclesAsync()
        +CreateVehicleAsync()
        +UpdateVehicleAsync()
        +SetVehicleActiveAsync()
        +DispatchAsync()
        +ConfirmReceiptAsync()
    }

    class DeliveryEtaService {
        <<Service>>
        +EstimateAsync()
        +GetScheduleAsync()
        -EnsureDistanceIsCurrentAsync()
        -NextDispatchSlot()
        -ResolveMilestone()
    }

    class OrderCompletionService {
        <<Service>>
        +EvaluateAsync()
        +HoldAsync()
    }
}

