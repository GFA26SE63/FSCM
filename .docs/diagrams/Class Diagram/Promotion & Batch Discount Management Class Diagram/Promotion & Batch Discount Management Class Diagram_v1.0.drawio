        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Promotion {\n  -Id : Guid «PK»\n  -Code : string «UK»\n  -Name : string\n  -PromotionType : string\n  -MinimumQuantity : decimal\n  -DiscountPercent : decimal\n  -StartAt : DateTimeOffset\n  -EndAt : DateTimeOffset\n  -IsActive : bool\n  -CreatedByUserId : Guid «FK»\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass PromotionProduct {\n  -Id : Guid «PK»\n  -PromotionId : Guid «FK»\n  -ProductId : Guid «FK»\n}\n\nclass PromotionCategory {\n  -Id : Guid «PK»\n  -PromotionId : Guid «FK»\n  -ProductCategoryId : Guid «FK»\n}\n\nclass PromotionRetailer {\n  -Id : Guid «PK»\n  -PromotionId : Guid «FK»\n  -RetailerId : Guid «FK»\n}\n\nclass BatchPromotion {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -PromotionId : Guid «FK»\n  -AssignedByUserId : Guid «FK»\n  -IsActive : bool\n  -AssignedAt : DateTimeOffset\n  -RemovedAt : DateTimeOffset?\n}\n\nclass ShelfLifeDiscountTable {\n  -Id : Guid «PK»\n  -Version : int «UK»\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n  -Note : string?\n  -CreatedByUserId : Guid «FK»\n}\n\nclass ShelfLifeDiscountTier {\n  -Id : Guid «PK»\n  -ShelfLifeDiscountTableId : Guid «FK»\n  -Scope : string\n  -ProductId : Guid? «FK»\n  -ProductCategoryId : Guid? «FK»\n  -MinRemainingPercent : decimal\n  -MaxRemainingPercent : decimal\n  -DiscountType : string\n  -DiscountValue : decimal\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -ProductCategoryId : Guid «FK»\n  -Sku : string\n  -Name : string\n}\n\nclass ProductCategory {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -ProductId : Guid «FK»\n  -BatchCode : string\n  -ExpirationDate : DateOnly\n  -ExpiryStatus : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; Promotion : creates\nPromotion \&quot;1\&quot; *-- \&quot;0..*\&quot; PromotionProduct : product targets\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; PromotionProduct : targeted product\nPromotion \&quot;1\&quot; *-- \&quot;0..*\&quot; PromotionCategory : category targets\nProductCategory \&quot;1\&quot; -- \&quot;0..*\&quot; PromotionCategory : targeted category\nPromotion \&quot;1\&quot; *-- \&quot;0..*\&quot; PromotionRetailer : retailer targets\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; PromotionRetailer : eligible retailer\nPromotion \&quot;1\&quot; -- \&quot;0..*\&quot; BatchPromotion : batch assignment\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; BatchPromotion : promoted batch\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; BatchPromotion : assigns\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTable : publishes\nShelfLifeDiscountTable \&quot;1\&quot; *-- \&quot;1..*\&quot; ShelfLifeDiscountTier : bands\nProduct \&quot;0..1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTier : SKU scope\nProductCategory \&quot;0..1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTier : category scope\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vcNI2asWZW82pRMGSlHS-1">
