%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class PromotionsController {
        +List()
        +Get()
        +Create()
        +Update()
        +Activate()
        +Deactivate()
    }

    class BatchDiscountsController {
        +Suggestions()
        +List()
        +Get()
        +Apply()
