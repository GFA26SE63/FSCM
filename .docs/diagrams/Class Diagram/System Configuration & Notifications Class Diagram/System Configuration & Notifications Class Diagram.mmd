%% ==========================================
%% API DEPENDENCIES
%% ==========================================

BusinessConfigurationsController ..> WarehouseConfigurationService : uses

WarehousesController ..> WarehouseConfigurationService : uses

MapController ..> MapService : uses

TransitTablesController ..> TransitTableService : uses

NotificationsController ..> NotificationService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

WarehouseConfigurationService ..> IWarehouseConfigurationStore : uses

MapService ..> IMapStore : uses

TransitTableService ..> ITransitTableStore : uses

NotificationService ..> INotificationStore : uses

InventoryOutboxDispatcher ..> IInventoryOutboxStore : uses

%% ==========================================
%% BACKGROUND PROCESSING
%% ==========================================

InventoryOutboxHostedService ..> InventoryOutboxDispatcher : executes

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

WarehouseConfigurationStore ..|> IWarehouseConfigurationStore : implements

MapStore ..|> IMapStore : implements

TransitTableStore ..|> ITransitTableStore : implements

NotificationStore ..|> INotificationStore : implements

InventoryOutboxStore ..|> IInventoryOutboxStore : implements

%% ==========================================
%% CONFIGURATION RELATIONSHIPS
%% ==========================================

UserAccount "0..1" -- "0..*" SystemConfiguration : updated by

UserAccount "0..1" -- "0..*" AuditLog : performed actions

%% ==========================================
%% REGION AND WAREHOUSE
%% ==========================================

Region "1" -- "0..*" Warehouse : contains

Warehouse "0..1" -- "0..*" MapLocation : location records

%% ==========================================
%% MAP DISTANCE RELATIONSHIPS
%% ==========================================

MapLocation "1" -- "0..*" MapDistanceCache : origin location

MapLocation "1" -- "0..*" MapDistanceCache : destination location

%% ==========================================
%% TRANSIT CONFIGURATION RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" TransitTimeRule : service rules

TransitTable "1" *-- "1..*" TransitTableBand : contains

UserAccount "1" -- "0..*" TransitTable : published by

%% ==========================================
%% NOTIFICATION RELATIONSHIPS
%% ==========================================

UserAccount "1" -- "0..*" Notification : receives

OutboxMessage "0..1" -- "0..*" Notification : produces

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

WarehouseConfigurationStore ..> SystemConfiguration : manages

WarehouseConfigurationStore ..> Warehouse : manages

WarehouseConfigurationStore ..> TransitTimeRule : manages

WarehouseConfigurationStore ..> AuditLog : records

MapStore ..> MapLocation : manages

MapStore ..> MapDistanceCache : manages

TransitTableStore ..> TransitTable : manages

TransitTableStore ..> TransitTableBand : manages

NotificationStore ..> Notification : manages

InventoryOutboxStore ..> OutboxMessage : reads

InventoryOutboxStore ..> Notification : creates