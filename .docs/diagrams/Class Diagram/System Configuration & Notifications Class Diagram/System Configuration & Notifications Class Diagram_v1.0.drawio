        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -Email : string\n  -FullName : string\n  -Role : string\n  -IsActive : bool\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass SystemConfiguration {\n  -Id : Guid «PK»\n  -ConfigKey : string\n  -ConfigValue : json\n  -Description : string\n  -ValueType : string\n  -Version : int\n  -IsActive : bool\n  -UpdatedByUserId : Guid? «FK»\n  -EffectiveFrom : DateTimeOffset\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass TransitTable {\n  -Id : Guid «PK»\n  -Version : int «UK»\n  -MaxServingDistanceMeters : int\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n  -Note : string?\n  -CreatedByUserId : Guid «FK»\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass TransitTableBand {\n  -Id : Guid «PK»\n  -TransitTableId : Guid «FK»\n  -MinDistanceMeters : int\n  -MaxDistanceMeters : int\n  -HandlingMinutes : int\n  -TransitMinutes : int\n  -EstimatedCostAmount : decimal\n  -CreatedAt : DateTimeOffset\n}\n\nclass ShelfLifeDiscountTable {\n  -Id : Guid «PK»\n  -Version : int «UK»\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n  -Note : string?\n  -CreatedByUserId : Guid «FK»\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass ShelfLifeDiscountTier {\n  -Id : Guid «PK»\n  -ShelfLifeDiscountTableId : Guid «FK»\n  -Scope : string\n  -ProductId : Guid? «FK»\n  -ProductCategoryId : Guid? «FK»\n  -MinRemainingPercent : decimal\n  -MaxRemainingPercent : decimal\n  -DiscountType : string\n  -DiscountValue : decimal\n  -CreatedAt : DateTimeOffset\n}\n\nclass Notification {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -OutboxMessageId : Guid? «FK»\n  -SalesOrderId : Guid? «FK»\n  -Type : string\n  -Title : string\n  -Message : string\n  -IsRead : bool\n  -CreatedAt : DateTimeOffset\n  -ReadAt : DateTimeOffset?\n}\n\nclass OutboxMessage {\n  -Id : Guid «PK»\n  -EventType : string\n  -AggregateType : string\n  -AggregateId : Guid\n  -Payload : json\n  -Status : string\n  -RetryCount : int\n  -CreatedAt : DateTimeOffset\n  -ProcessedAt : DateTimeOffset?\n  -LastError : string?\n}\n\nclass AuditLog {\n  -Id : Guid «PK»\n  -UserAccountId : Guid? «FK»\n  -EntityName : string\n  -EntityId : Guid\n  -Action : string\n  -OldValues : json?\n  -NewValues : json?\n  -Reason : string?\n  -CreatedAt : DateTimeOffset\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -Status : string\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -Sku : string\n  -Name : string\n}\n\nclass ProductCategory {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n}\n\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; SystemConfiguration : updates\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; TransitTable : publishes\nTransitTable \&quot;1\&quot; *-- \&quot;1..*\&quot; TransitTableBand : distance bands\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTable : publishes\nShelfLifeDiscountTable \&quot;1\&quot; *-- \&quot;1..*\&quot; ShelfLifeDiscountTier : discount tiers\nProduct \&quot;0..1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTier : SKU scope\nProductCategory \&quot;0..1\&quot; -- \&quot;0..*\&quot; ShelfLifeDiscountTier : category scope\nUserAccount \&quot;1\&quot; *-- \&quot;0..*\&quot; Notification : recipient inbox\nOutboxMessage \&quot;0..1\&quot; -- \&quot;0..*\&quot; Notification : delivery source\nSalesOrder \&quot;0..1\&quot; -- \&quot;0..*\&quot; Notification : order context\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; AuditLog : actor\nSystemConfiguration ..&gt; AuditLog : audited change\nTransitTable ..&gt; AuditLog : audited publication\nShelfLifeDiscountTable ..&gt; AuditLog : audited publication\nOutboxMessage ..&gt; Notification : dispatches\n&quot;,&#xa;  &quot;config&quot;: null,&#xa; 