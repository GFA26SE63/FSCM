%% ==========================================
%% 10. API DEPENDENCIES
%% ==========================================

PickingListsController ..> CurrentPickingService : uses

ShipmentsController ..> ShipmentService : uses

ComplaintsController ..> ComplaintService : uses

%% ==========================================
%% 11. APPLICATION DEPENDENCIES
%% ==========================================

CurrentPickingService ..> IPickingStore : uses

ShipmentService ..> IShipmentStore : uses

ComplaintService ..> IComplaintStore : uses

%% ==========================================
%% 12. INTERFACE REALIZATION
%% ==========================================

PickingStore ..|> IPickingStore : implements

ShipmentStore ..|> IShipmentStore : implements

ComplaintStore ..|> IComplaintStore : implements

%% ==========================================
%% 13. ORDER AND PICKING RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..1" PurchaseOrder : generates

PurchaseOrder "1" -- "0..*" PickingList : releases

PickingList "1" *-- "1..*" PickingItem : contains

Allocation "1" -- "0..*" PickingItem : fulfilled by

Batch "1" -- "0..*" PickingItem : source batch

%% ==========================================
%% 14. PICKING AND SHIPMENT RELATIONSHIPS
%% ==========================================

PickingList "1" -- "0..*" Shipment : associated shipments

SalesOrder "1" -- "0..*" Shipment : delivery portions

%% ==========================================
%% 15. RETAILER RECEIPT RELATIONSHIPS
%% ==========================================

Shipment "1" -- "0..1" ReceiptConfirmation : confirmed by

ReceiptConfirmation "1" *-- "0..*" ReceiptConfirmationItem : contains

ReceiptConfirmation "1" *-- "0..*" ReceiptConfirmationQrLabel : scanned labels

BatchQrLabel "1" -- "0..*" ReceiptConfirmationQrLabel : scan reference

Batch "1" -- "0..*" ReceiptConfirmationItem : received batch

%% ==========================================
%% 16. QR AND INVENTORY RELATIONSHIPS
%% ==========================================

Batch "1" -- "0..*" BatchQrLabel : identified by

Batch "1" -- "0..1" InventoryBalance : inventory balance

Batch "1" -- "0..*" InventoryTransaction : stock movements

%% ==========================================
%% 17. RECEIPT DISCREPANCY RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" ReceiptDiscrepancy : reported issues

ReceiptConfirmation "0..1" -- "0..*" ReceiptDiscrepancy : optional receipt reference

ReceiptDiscrepancy "1" *-- "1..*" ReceiptDiscrepancyItem : contains

Shipment "1" -- "0..*" ReceiptDiscrepancyItem : affected shipment

Batch "1" -- "0..*" ReceiptDiscrepancyItem : affected batch

%% ==========================================
%% 18. BUSINESS CONSTRAINTS
%% ==========================================

note for PurchaseOrder "Picking lists are created only after quotation acceptance and verified payment or credit confirmation."

note for PickingList "Warehouse picking records readiness. All warehouse portions must be fully picked before dispatch."

note for PickingItem "Scanned batch and picked quantity must match the allocation. Picking alone does not deduct physical stock."

note for Shipment "Dispatch requires all applicable guards. Physical stock decreases only on confirmed dispatch."

note for ReceiptConfirmation "Retailer confirms actual receipt by shipment. Duplicate confirmation must not create duplicate effects."

note for ReceiptConfirmationItem "Damaged is a subset of received quantity. Missing quantity equals dispatched minus received."

note for ReceiptDiscrepancy "A complaint does not automatically reverse stock movement or delivery history."

note for BatchQrLabel "QR labels preserve batch traceability. Deterministic QR payload rules require implementation verification."