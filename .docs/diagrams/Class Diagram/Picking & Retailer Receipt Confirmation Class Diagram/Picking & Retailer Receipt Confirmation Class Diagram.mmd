classDiagram
direction TB

%% ==========================================
%% 1. API LAYER
%% ==========================================

namespace API {

    class PickingListsController {
        <<Controller>>
        +List()
        +Get()
        +Scan()
        +Complete()
    }

    class ShipmentsController {
        <<Controller>>
        +List()
        +Get()
        +OrderReadiness()
        +ConfirmIssue()
        +Dispatch()
        +ConfirmReceipt()
    }

    class ComplaintsController {
        <<Controller>>
        +List()
        +Create()
        +Resolve()
    }
}

%% ==========================================
%% 2. APPLICATION LAYER
%% ==========================================

namespace Application {

    class CurrentPickingService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +ScanAsync()
        +CompleteAsync()
    }

    class ShipmentService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +GetOrderReadinessAsync()
        +ConfirmIssueAsync()
        +DispatchAsync()
        +ConfirmReceiptAsync()
    }

    class ComplaintService {
        <<Service>>
        +ListAsync()
        +CreateAsync()
        +ResolveAsync()
    }

    class IPickingStore {
        <<interface>>
        +CanAccessWarehouseAsync()
        +ListAsync()
        +FindAsync()
        +FindLabelForUpdateAsync()
        +FindOperationAsync()
        +AddLabel()
        +AddLabelEvent()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
    }

    class IShipmentStore {
        <<interface>>
        +CanViewOrderAsync()
        +CanAccessWarehouseAsync()
        +ListAsync()
        +FindByIdAsync()
        +FindOrderForUpdateAsync()
        +ListLabelsAsync()
        +AddReceipt()
        +AddReceiptLine()
        +AddInventoryTransaction()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
    }

    class IComplaintStore {
        <<interface>>
        +ListAsync()
        +CreateAsync()
        +ResolveAsync()
    }
}

