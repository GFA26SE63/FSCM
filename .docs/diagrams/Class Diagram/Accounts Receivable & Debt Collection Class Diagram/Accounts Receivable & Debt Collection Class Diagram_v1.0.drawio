        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string «UK»\n  -RetailerId : Guid «FK»\n  -PaymentMethod : string\n  -CreditTermDays : int\n  -FinalAmount : decimal\n  -Status : string\n}\n\nclass Payment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -Method : string\n  -Status : string\n  -Amount : decimal\n  -AdjustedAmount : decimal\n  -ConfirmedAmount : decimal\n  -FinalApprovedAt : DateTimeOffset\n  -DeliveredDate : DateOnly?\n  -DueDate : DateOnly?\n  -PaidDate : DateOnly?\n  -CollectionMethod : string?\n  -ConfirmedByUserId : Guid? «FK»\n  -ConfirmedAt : DateTimeOffset?\n  -Version : int\n}\n\nclass ManualPayment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -Method : string\n  -Status : string\n  -Amount : decimal\n  -OperationKey : string «UK»\n  -ConfirmedByUserId : Guid? «FK»\n  -ConfirmedAt : DateTimeOffset?\n  -Note : string?\n  -Version : int\n}\n\nclass ReceiptDiscrepancy {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ReceiptConfirmationId : Guid «FK»\n  -Status : string\n  -ReportedAt : DateTimeOffset\n  -ResolvedAt : DateTimeOffset?\n  -Note : string?\n}\n\nclass ManualRefund {\n  -Id : Guid «PK»\n  -PaymentId : Guid «FK»\n  -SalesOrderId : Guid «FK»\n  -Amount : decimal\n  -Recipient : string\n  -Reason : string\n  -Status : string\n  -TransferredAt : DateTimeOffset?\n  -TransactionReference : string?\n  -VerifiedAt : DateTimeOffset?\n  -Version : int\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -UserAccountId : Guid? «FK»\n  -Code : string\n  -Name : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nclass RetailerReceivableResult {\n  +Id : Guid\n  +OrderId : Guid\n  +OrderCode : string\n  +Status : string\n  +OriginalOrderAmount : decimal\n  +FinalApprovedAmount : decimal\n  +ApprovedAdjustmentAmount : decimal\n  +AdjustedAmount : decimal\n  +ConfirmedCollectedAmount : decimal\n  +OutstandingAmount : decimal\n  +PendingDisputedAmount : decimal\n  +CollectibleAmount : decimal\n  +DueDate : DateOnly?\n  +IsOverdue : bool\n  +DaysOverdue : int\n  +PendingRefundAmount : decimal\n  +CompletedRefundAmount : decimal\n  +RefundDueAmount : decimal\n}\n\nclass ReceivableCollectionHistory {\n  +Id : Guid\n  +Method : string\n  +Amount : decimal\n  +Status : string\n  +ConfirmedAt : DateTimeOffset?\n  +Reference : string?\n}\n\nclass ReceivableDisputeHistory {\n  +Id : Guid\n  +Status : string\n  +DisputedAmount : decimal\n  +ReportedAt : DateTimeOffset\n  +ResolvedAt : DateTimeOffset?\n}\n\nclass ReceivableRefundHistory {\n  +Id : Guid\n  +Amount : decimal\n  +Status : string\n  +TransferredAt : DateTimeOffset?\n  +TransactionReference : string?\n  +VerifiedAt : DateTimeOffset?\n  +Reason : string\n}\n\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : debtor orders\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : receivable ledger\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ManualPayment : collection attempts\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; Payment : confirms collection\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; ManualPayment : confirms manual payment\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancy : disputes\nPayment \&quot;1\&quot; -- \&quot;0..*\&quot; ManualRefund : refund obligations\nPayment ..&gt; RetailerReceivableResult : computes balances\nManualPayment ..&gt; ReceivableCollectionHistory : collection history\nReceiptDiscrepancy ..&gt; ReceivableDisputeHistory : dispute history\nManualRefund ..&gt; ReceivableRefundHistory : refund history\nRetailerReceivableResult \&quot;1\&quot; *-- \&quot;0..*\&quot; ReceivableCollectionHistory : collections\nRetailerReceivableResult \&quot;1\&quot; *-- \&quot;0..*\&quot; ReceivableDisputeHistory : disputes\nRetailerReceivableResult \&quot;1\&quot; *-- \&quot;0..*\&quot; ReceivableRefundHistory : refunds\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vWzHn8l1A8axN6veGn9x-1">
