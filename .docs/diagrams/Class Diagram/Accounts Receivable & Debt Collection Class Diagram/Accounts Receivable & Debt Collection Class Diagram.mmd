%% ==========================================
%% API DEPENDENCIES
%% ==========================================

PaymentsController ..> PaymentService : uses

PaymentReceiptsController ..> PaymentReceiptService : uses

RetailerReceivablesController ..> RetailerReceivableService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

PaymentService ..> IPaymentStore : uses

PaymentReceiptService ..> IPaymentReceiptStore : uses

RetailerReceivableService ..> IRetailerReceivableStore : uses

PaymentPlanService ..> IPaymentStore : uses

QuoteService ..> IPaymentPlanService : creates payment obligation

QuoteService ..> PurchaseOrderGateService : checks PO release

PaymentService ..> PurchaseOrderGateService : checks PO after PayOS settlement

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

PaymentStore ..|> IPaymentStore : implements

PaymentReceiptStore ..|> IPaymentReceiptStore : implements

RetailerReceivableStore ..|> IRetailerReceivableStore : implements

PaymentPlanService ..|> IPaymentPlanService : implements

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

PaymentStore ..> Payment : manages

PaymentStore ..> SalesOrder : reads order context

PaymentStore ..> AuditLog : records changes

PaymentReceiptStore ..> PaymentReceipt : manages

PaymentReceiptStore ..> PaymentReceiptAllocation : manages allocations

PaymentReceiptStore ..> Payment : updates settlements

PaymentReceiptStore ..> AuditLog : records changes

RetailerReceivableStore ..> Payment : reads obligations

RetailerReceivableStore ..> SalesOrder : reads order context

RetailerReceivableStore ..> ReceiptDiscrepancy : reads disputes

RetailerReceivableStore ..> ManualRefund : reads refund history

%% ==========================================
%% RETAILER RELATIONSHIPS
%% ==========================================

Retailer "1" -- "0..*" SalesOrder : places

Retailer "1" -- "0..*" PaymentReceipt : makes payments

%% ==========================================
%% SALES ORDER RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" SalesOrderQuote : quotations

SalesOrder "1" -- "0..1" Payment : payment obligation

%% ==========================================
%% CONSOLIDATED PAYMENT RECEIPTS
%% ==========================================

PaymentReceipt "1" *-- "0..*" PaymentReceiptAllocation : contains

Payment "1" -- "0..*" PaymentReceiptAllocation : receives allocated funds

%% ==========================================
%% FINANCIAL ADJUSTMENT RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" ReceiptDiscrepancy : reported issues

SalesOrder "1" -- "0..*" ManualRefund : refund obligations

Payment "1" -- "0..*" ManualRefund : associated refunds

%% ==========================================
%% BUSINESS DATA DEPENDENCIES
%% ==========================================

PaymentPlanService ..> SalesOrderQuote : uses approved amount

PaymentPlanService ..> SalesOrder : uses payment method

RetailerReceivableService ..> Payment : calculates balances

RetailerReceivableService ..> PaymentReceiptAllocation : summarizes collections

RetailerReceivableService ..> ManualRefund : considers refunds