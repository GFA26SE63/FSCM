classDiagram
direction TB

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class PaymentsController {
        <<Controller>>
        +List()
        +GetByOrder()
        +Collect()
        +Adjust()
        +CreatePayOsCheckout()
        +PayOsWebhook()
    }

    class PaymentReceiptsController {
        <<Controller>>
        +Confirm()
        +Reverse()
    }

    class RetailerReceivablesController {
        <<Controller>>
        +List()
        +GetByOrder()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class PaymentService {
        <<Service>>
        +ListAsync()
        +GetByOrderAsync()
        +CollectAsync()
        +AdjustReceivableAsync()
        +CreatePayOsCheckoutAsync()
        +HandlePayOsWebhookAsync()
        -ValidateReadRole()
        -ValidateCollectionAuthority()
        -ValidatePayOsWebhook()
        -NormalizeOperationKey()
        -ValidateAmount()
    }

    class PaymentPlanService {
        <<Service>>
        +CreateForFinalApprovedOrderAsync()
        +CreateForDeliveredOrderAsync()
    }

    class PaymentReceiptService {
        <<Service>>
        +ConfirmAsync()
        +ReverseAsync()
        -ToResultAsync()
        -ApplyDerivedStatus()
        -Validate()
        -NormalizeKey()
    }

    class RetailerReceivableService {
        <<Service>>
        +ListAsync()
        +GetByOrderAsync()
        -Today()
        -ToResult()
        -Validate()
        -NormalizeStatus()
    }

    class QuoteService {
        <<Service>>
        +AcceptAsync()
        +RejectAsync()
    }

    class PurchaseOrderGateService {
        <<Service>>
        +TryCreateAsync()
    }
}

%% ==========================================
%% APPLICATION INTERFACES
%% ==========================================

namespace Application_Interfaces {

    class IPaymentStore {
        <<interface>>
        +FindByOrderAsync()
        +FindByOperationKeyAsync()
        +FindByPayOsOrderCodeAsync()
        +ListAsync()
        +CanViewAsync()
        +Add()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class IPaymentPlanService {
        <<interface>>
        +CreateForFinalApprovedOrderAsync()
        +CreateForDeliveredOrderAsync()
    }

    class IPaymentReceiptStore {
        <<interface>>
        +FindReceiptByOperationKeyAsync()
        +FindReceiptAsync()
        +ListAllocationsAsync()
        +FindPaymentsForUpdateAsync()
        +ConfirmedAllocationTotalAsync()
        +AddReceipt()
        +AddAllocations()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class IRetailerReceivableStore {
        <<interface>>
        +ListAsync()
        +FindByOrderAsync()
    }
}

%% ==========================================
%% PERSISTENCE LAYER
%% ==========================================

namespace Persistence {

    class PaymentStore {
        <<Repository>>
        +FindByOrderAsync()
        +FindByOperationKeyAsync()
        +FindByPayOsOrderCodeAsync()
        +ListAsync()
        +CanViewAsync()
        +Add()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class PaymentReceiptStore {
        <<Repository>>
        +FindReceiptByOperationKeyAsync()
        +FindReceiptAsync()
        +ListAllocationsAsync()
        +FindPaymentsForUpdateAsync()
        +ConfirmedAllocationTotalAsync()
        +AddReceipt()
        +AddAllocations()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class RetailerReceivableStore {
        <<Repository>>
        +ListAsync()
        +FindByOrderAsync()
        -LoadAsync()
    }
}

