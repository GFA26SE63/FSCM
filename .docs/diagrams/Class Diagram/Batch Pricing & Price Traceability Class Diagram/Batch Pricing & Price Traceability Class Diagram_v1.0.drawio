        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass ProductPrice {\n  -Id : Guid «PK»\n  -ProductId : Guid «FK»\n  -UnitPrice : decimal\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n  -CreatedAt : DateTimeOffset\n}\n\nclass SalesOrderLine {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ProductId : Guid «FK»\n  -ProductPriceId : Guid «FK»\n  -UnitPrice : decimal\n  -GrossAmount : decimal\n  -DiscountAmount : decimal\n  -NetAmount : decimal\n  -MlorSourceRuleId : Guid? «FK»\n  -MlorSourceVersion : int\n  -MlorMinimumLifeRatio : decimal\n  -PricedAt : DateTimeOffset\n}\n\nclass OrderPromotion {\n  -Id : Guid «PK»\n  -SalesOrderLineId : Guid «FK»\n  -PromotionId : Guid «FK»\n  -PromotionCodeSnapshot : string\n  -PromotionTypeSnapshot : string\n  -MinimumQuantitySnapshot : decimal\n  -DiscountPercent : decimal\n  -DiscountAmount : decimal\n  -IsServerFinal : bool\n  -AppliedAt : DateTimeOffset\n}\n\nclass AllocationRunLine {\n  -Id : Guid «PK»\n  -SalesOrderLineId : Guid «FK»\n  -ListUnitPrice : decimal\n  -BaseNetUnitPrice : decimal\n  -TotalShelfLifeHours : int\n  -EffectiveMlorRatio : decimal\n}\n\nclass AllocationPlanVersion {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -VersionNumber : int\n  -Status : string\n  -PricedAt : DateTimeOffset\n  -TotalFinalAmount : decimal\n}\n\nclass AllocationPlanPrice {\n  -Id : Guid «PK»\n  -AllocationPlanVersionId : Guid «FK»\n  -AllocationRunLineId : Guid «FK»\n  -BatchId : Guid «REF»\n  -WarehouseId : Guid «REF»\n  -Quantity : decimal\n  -ListUnitPrice : decimal\n  -BaseNetUnitPrice : decimal\n  -PricedAt : DateTimeOffset\n  -BatchExpiresAt : DateTimeOffset\n  -TotalShelfLifeHours : int\n  -RemainingShelfLifePercent : decimal\n  -ShelfLifeDiscountTierId : Guid? «REF»\n  -DiscountType : string?\n  -DiscountValue : decimal?\n  -ShelfLifeDiscountPerUnit : decimal\n  -FinalNetUnitPrice : decimal\n  -Amount : decimal\n  -DiscountTableVersion : int\n  -Explanation : string\n}\n\nclass ShelfLifeDiscountTable {\n  -Id : Guid «PK»\n  -Version : int «UK»\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass ShelfLifeDiscountTier {\n  -Id : Guid «PK»\n  -ShelfLifeDiscountTableId : Guid «FK»\n  -Scope : string\n  -ProductId : Guid? «FK»\n  -ProductCategoryId : Guid? «FK»\n  -MinRemainingPercent : decimal\n  -MaxRemainingPercent : decimal\n  -DiscountType : string\n  -DiscountValue : decimal\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -BatchCode : string\n  -ProductId : Guid «FK»\n  -ExpirationDate : DateOnly\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -Sku : string\n  -Name : string\n}\n\nclass Promotion {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -PromotionType : string\n}\n\nProduct \&quot;1\&quot; *-- \&quot;0..*\&quot; ProductPrice : list-price versions\nProductPrice \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrderLine : source snapshot\nSalesOrderLine \&quot;1\&quot; *-- \&quot;0..*\&quot; OrderPromotion : ordinary promotion snapshot\nPromotion \&quot;1\&quot; -- \&quot;0..*\&quot; OrderPromotion : source rule\nSalesOrderLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunLine : allocation snapshot\nAllocationPlanVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationPlanPrice : immutable fragment prices\nAllocationRunLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationPlanPrice : priced line\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationPlanPrice : price by batch\nShelfLifeDiscountTable \&quot;1\&quot; *-- \&quot;1..*\&quot; ShelfLifeDiscountTier : versioned tiers\nShelfLifeDiscountTier \&quot;0..1\&quot; -- \&quot;0..*\&quot; AllocationPlanPrice : applied tier\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : batches\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EDGw0TD6_EoUonVpDEIt-1">
