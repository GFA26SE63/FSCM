classDiagram
direction TB

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class ProductsController {
        <<Controller>>
        +SetPrice()
        +ListPrices()
        +GetPriceSuggestion()
    }

    class ShelfLifeDiscountsController {
        <<Controller>>
        +Current()
        +History()
        +Version()
        +Match()
        +Publish()
    }

    class PricingController {
        <<Controller>>
        +Snapshot()
        +CartSnapshot()
    }

    class QuotesController {
        <<Controller>>
        +ForOrder()
        +ForRun()
        +Accept()
        +Reject()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class CatalogService {
        <<Service>>
        +SetPriceAsync()
        +ListPriceHistoryAsync()
        +GetPriceSuggestionAsync()
        -ValidatePrice()
    }

    class ShelfLifeDiscountService {
        <<Service>>
        +GetCurrentAsync()
        +GetVersionAsync()
        +ListHistoryAsync()
        +MatchAsync()
        +PublishAsync()
        -Validate()
    }

    class PromotionService {
        <<Service>>
        +CalculatePriceAsync()
        +CalculateIndicativePriceAsync()
        +CalculateIndicativePricesAsync()
        +ApplyBatchDiscountAsync()
        +ListEligibleCampaignsAsync()
    }

    class OrderService {
        <<Service>>
        +CreateAsync()
        +GetAsync()
        +GetByCodeAsync()
        +SubmitOfflineAsync()
    }

    class OrderPricingService {
        <<Service>>
        +CalculateAsync()
        -ToSnapshot()
    }

    class AllocationPricingService {
        <<Service>>
        +PriceAsync()
    }

    class RealTimeAllocationService {
        <<Service>>
        +AllocateAsync()
        +AllocateOnceAsync()
    }

    class AllocationPriceLookupService {
        <<Service>>
        +GetByOrderAsync()
        +GetByOrderLineAsync()
        -EnsureLinesReconcile()
        -Round()
    }

    class QuoteService {
        <<Service>>
        +ListForOrderAsync()
        +ListForRunAsync()
        +AcceptAsync()
        +RejectAsync()
    }
}

%% ==========================================
%% APPLICATION INTERFACES
%% ==========================================

namespace Application_Interfaces {

    class ICatalogStore {
        <<interface>>
        +FindActivePriceAsync()
        +ListPricesAsync()
        +AddPrice()
        +RemovePrices()
        +SaveChangesAsync()
    }

    class IShelfLifeDiscountStore {
        <<interface>>
        +FindCurrentAsync()
        +FindByVersionAsync()
        +FindEffectiveAtAsync()
        +FindCurrentForUpdateAsync()
        +MaxVersionAsync()
        +AddTable()
        +AddTiers()
        +AddAuditLog()
        +SaveChangesAsync()
    }

    class IPromotionStore {
        <<interface>>
        +ListEligibleCampaignsAsync()
        +ListEligibleBatchDiscountsAsync()
        +FindBatchDiscountAsync()
        +FindPriceProductAsync()
        +FindPriceBatchAsync()
        +SaveChangesAsync()
    }

    class IOrderPricingService {
        <<interface>>
        +CalculateAsync()
    }

    class IRealTimeAllocationStore {
        <<interface>>
        +LoadForUpdateAsync()
        +AddRun()
        +AddAllocation()
        +AddReservation()
        +AddQuote()
        +ExecuteInTransactionAsync()
        +SaveChangesAsync()
    }

    class IQuoteStore {
        <<interface>>
        +FindAsync()
        +ListForOrderAsync()
        +ListForRunAsync()
        +CanRetailerAccessAsync()
        +SaveChangesAsync()
    }

    class IAllocationRunStore {
        <<interface>>
        +FindOrderPriceAsync()
        +FindOrderTraceAsync()
        +AddPlanPrices()
        +FindPlanVersionViewAsync()
    }
}

