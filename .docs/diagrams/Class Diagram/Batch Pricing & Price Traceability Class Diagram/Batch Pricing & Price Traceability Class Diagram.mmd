%% ==========================================
%% API DEPENDENCIES
%% ==========================================

ProductsController ..> CatalogService : uses

ShelfLifeDiscountsController ..> ShelfLifeDiscountService : uses

PricingController ..> OrderService : uses

PricingController ..> PromotionService : uses

QuotesController ..> QuoteService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

CatalogService ..> ICatalogStore : uses

ShelfLifeDiscountService ..> IShelfLifeDiscountStore : uses

PromotionService ..> IPromotionStore : uses

OrderService ..> IOrderPricingService : uses

OrderPricingService ..> PromotionService : uses

RealTimeAllocationService ..> AllocationPricingService : prices batches

RealTimeAllocationService ..> IRealTimeAllocationStore : uses

AllocationPricingService ..> ShelfLifeDiscountService : matches discount tiers

QuoteService ..> IQuoteStore : uses

AllocationPriceLookupService ..> IAllocationRunStore : reads legacy traces

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

CatalogStore ..|> ICatalogStore : implements

ShelfLifeDiscountStore ..|> IShelfLifeDiscountStore : implements

PromotionStore ..|> IPromotionStore : implements

OrderPricingService ..|> IOrderPricingService : implements

RealTimeAllocationStore ..|> IRealTimeAllocationStore : implements

QuoteStore ..|> IQuoteStore : implements

AllocationRunStore ..|> IAllocationRunStore : implements

%% ==========================================
%% PRODUCT AND PRICE HISTORY
%% ==========================================

ProductCategory "1" -- "0..*" Product : classifies

Product "1" -- "0..*" ProductPrice : price history

Product "1" -- "0..*" Batch : has batches

%% ==========================================
%% SHELF LIFE DISCOUNT RULES
%% ==========================================

ShelfLifeDiscountTable "1" *-- "0..*" ShelfLifeDiscountTier : contains

Product "0..1" -- "0..*" ShelfLifeDiscountTier : SKU scope

ProductCategory "0..1" -- "0..*" ShelfLifeDiscountTier : category scope

%% ==========================================
%% PROMOTION RELATIONSHIPS
%% ==========================================

Promotion "1" -- "0..*" BatchPromotion : batch assignments

Batch "1" -- "0..*" BatchPromotion : eligible promotions

%% ==========================================
%% SALES ORDER PRICING
%% ==========================================

SalesOrder "1" *-- "1..*" SalesOrderLine : contains

Product "1" -- "0..*" SalesOrderLine : ordered product

ProductPrice "0..1" -- "0..*" SalesOrderLine : selected price

SalesOrderLine "1" *-- "0..*" OrderPromotion : promotion snapshots

Promotion "0..1" -- "0..*" OrderPromotion : source promotion

%% ==========================================
%% REAL TIME BATCH PRICING
%% ==========================================

SalesOrderLine "1" -- "0..*" Allocation : allocated portions

Batch "1" -- "0..*" Allocation : allocated batch

Promotion "0..1" -- "0..*" Allocation : applied promotion

SalesOrder "1" -- "0..*" SalesOrderQuote : issued quotations

%% ==========================================
%% LEGACY PRICE TRACE RELATIONSHIPS
%% ==========================================

SalesOrderLine "1" -- "0..*" AllocationRunLine : historical run line

AllocationRunLine "1" -- "0..*" AllocationPlanPrice : historical price rows

AllocationPlanVersion "1" *-- "0..*" AllocationPlanPrice : versioned price trace

Batch "1" -- "0..*" AllocationPlanPrice : priced batch

ShelfLifeDiscountTier "0..1" -- "0..*" AllocationPlanPrice : applied tier

AllocationPlanVersion "0..1" -- "0..*" SalesOrderQuote : historical plan reference