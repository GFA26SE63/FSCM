%% ==========================================
%% DOMAIN - PRODUCT PRICING
%% ==========================================

namespace Domain_ProductPricing {

    class ProductCategory {
        +Id: Guid
        +Code: string
        +Name: string
        +ParentCategoryId: Guid
        +IsActive: bool
    }

    class Product {
        +Id: Guid
        +ProductCategoryId: Guid
        +Sku: string
        +Name: string
        +ShelfLifeHours: int
        +Status: string
        +PublishedAt: DateTimeOffset
    }

    class ProductPrice {
        +Id: Guid
        +ProductId: Guid
        +UnitPrice: decimal
        +EffectiveFrom: DateTimeOffset
        +EffectiveTo: DateTimeOffset
        +IsActive: bool
        +CreatedAt: DateTimeOffset
    }

    class Batch {
        +Id: Guid
        +ProductId: Guid
        +WarehouseId: Guid
        +BatchCode: string
        +ProductionDate: DateOnly
        +ExpirationDate: DateOnly
        +StockStatus: string
        +ExpiryStatus: string
    }
}

