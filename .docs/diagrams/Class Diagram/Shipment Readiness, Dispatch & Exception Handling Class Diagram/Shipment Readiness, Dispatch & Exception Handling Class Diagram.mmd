%% ==========================================
%% API DEPENDENCIES
%% ==========================================

QuotesController ..> QuoteService : uses

PickingListsController ..> CurrentPickingService : uses

ShipmentsController ..> ShipmentService : uses

ComplaintsController ..> ComplaintService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

QuoteService ..> IQuoteStore : uses

QuoteService ..> PurchaseOrderGateService : requests PO creation

PurchaseOrderGateService ..> IPurchaseOrderGateStore : uses

CurrentPickingService ..> IPickingStore : uses

ShipmentService ..> IShipmentStore : uses

ComplaintService ..> IComplaintStore : uses

OrderCompletionService ..> IOrderCompletionStore : uses

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

QuoteStore ..|> IQuoteStore : implements

PurchaseOrderGateStore ..|> IPurchaseOrderGateStore : implements

PickingStore ..|> IPickingStore : implements

ShipmentStore ..|> IShipmentStore : implements

ComplaintStore ..|> IComplaintStore : implements

OrderCompletionStore ..|> IOrderCompletionStore : implements

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

QuoteStore ..> SalesOrderQuote : manages

PurchaseOrderGateStore ..> PurchaseOrder : creates

PurchaseOrderGateStore ..> PickingList : creates

PurchaseOrderGateStore ..> PickingItem : creates

PickingStore ..> PickingList : manages

PickingStore ..> PickingItem : manages

PickingStore ..> BatchQrLabel : manages QR

ShipmentStore ..> Shipment : manages

ShipmentStore ..> ReceiptConfirmation : records

ShipmentStore ..> ReceiptConfirmationItem : records

ShipmentStore ..> InventoryTransaction : records stock movement

ShipmentStore ..> OrderStatusHistory : records transitions

ComplaintStore ..> ReceiptDiscrepancy : manages

ComplaintStore ..> ReceiptDiscrepancyItem : manages

OrderCompletionStore ..> SalesOrder : completes eligible orders

%% ==========================================
%% SALES ORDER AND PURCHASE ORDER
%% ==========================================

SalesOrder "1" *-- "1..*" SalesOrderLine : contains

SalesOrder "1" -- "0..*" SalesOrderQuote : quotations

SalesOrder "1" -- "0..1" PurchaseOrder : generates

SalesOrder "1" -- "0..*" Payment : payment obligations

SalesOrder "1" -- "0..*" OrderStatusHistory : status changes

SalesOrderQuote "1" -- "0..1" PurchaseOrder : accepted quote

%% ==========================================
%% PURCHASE ORDER AND PICKING
%% ==========================================

PurchaseOrder "1" *-- "0..*" PickingList : releases picking

Warehouse "1" -- "0..*" PickingList : processes

PickingList "1" *-- "0..*" PickingItem : contains

Allocation "1" -- "0..*" PickingItem : picking source

Batch "1" -- "0..*" Allocation : allocated from

SalesOrderLine "1" -- "0..*" Allocation : allocated portions

%% ==========================================
%% SHIPMENT RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" Shipment : warehouse shipments

Warehouse "1" -- "0..*" Shipment : dispatches

PickingList "0..1" -- "0..1" Shipment : produces

Driver "0..1" -- "0..*" Shipment : assigned driver

Vehicle "0..1" -- "0..*" Shipment : assigned vehicle

Warehouse "1" -- "0..*" Driver : manages

Warehouse "1" -- "0..*" Vehicle : manages

%% ==========================================
%% INVENTORY AND RESERVATION
%% ==========================================

Batch "1" -- "0..1" InventoryBalance : current balance

Batch "1" -- "0..*" Reservation : reserved stock

Allocation "0..1" -- "0..*" Reservation : reservation source

Batch "1" -- "0..*" InventoryLock : stock locks

Batch "1" -- "0..*" InventoryTransaction : movements

ShipmentService ..> Reservation : consumes on issue

ShipmentService ..> InventoryBalance : updates on issue

ShipmentService ..> InventoryLock : checks eligibility

%% ==========================================
%% QR LABEL TRACEABILITY
%% ==========================================

Batch "1" -- "0..*" BatchQrLabel : labels

BatchQrLabel "1" -- "0..*" QrLabelEvent : history

%% ==========================================
%% RETAILER RECEIPT
%% ==========================================

Shipment "1" -- "0..*" ReceiptConfirmation : receipt records

ReceiptConfirmation "1" *-- "0..*" ReceiptConfirmationItem : contains

ReceiptConfirmation "1" *-- "0..*" ReceiptConfirmationQrLabel : scanned labels

BatchQrLabel "1" -- "0..*" ReceiptConfirmationQrLabel : confirmed label

%% ==========================================
%% RECEIPT DISCREPANCY
%% ==========================================

SalesOrder "1" -- "0..*" ReceiptDiscrepancy : complaints

ReceiptConfirmation "0..1" -- "0..*" ReceiptDiscrepancy : reported after receipt

ReceiptDiscrepancy "1" *-- "0..*" ReceiptDiscrepancyItem : contains

Shipment "1" -- "0..*" ReceiptDiscrepancyItem : affected shipment