classDiagram
direction TB

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class QuotesController {
        <<Controller>>
        +ForOrder()
        +Accept()
        +Reject()
    }

    class PickingListsController {
        <<Controller>>
        +List()
        +Get()
        +Scan()
        +Complete()
    }

    class ShipmentsController {
        <<Controller>>
        +List()
        +Get()
        +OrderReadiness()
        +OrderDeliveryView()
        +Assign()
        +ConfirmIssue()
        +Dispatch()
        +FlagException()
        +ConfirmReceipt()
        +Sync()
    }

    class ComplaintsController {
        <<Controller>>
        +List()
        +Create()
        +Resolve()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class QuoteService {
        <<Service>>
        +ListForOrderAsync()
        +AcceptAsync()
        +RejectAsync()
    }

    class PurchaseOrderGateService {
        <<Service>>
        +TryCreateAsync()
    }

    class CurrentPickingService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +ScanAsync()
        +CompleteAsync()
        -EnsureWarehouseKeeper()
        -FindAccessibleAsync()
    }

    class ShipmentService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +GetOrderReadinessAsync()
        +GetRetailerOrderDeliveryAsync()
        +AssignAsync()
        +ConfirmIssueAsync()
        +DispatchAsync()
        +FlagExceptionAsync()
        +ConfirmReceiptAsync()
        +SyncOrderAsync()
        -BuildReadinessAsync()
        -IsPaymentSettledAsync()
        -ReconcileAsync()
    }

    class ComplaintService {
        <<Service>>
        +ListAsync()
        +CreateAsync()
        +ResolveAsync()
    }

    class OrderCompletionService {
        <<Service>>
        +EvaluateAsync()
        +HoldAsync()
    }
}

%% ==========================================
%% APPLICATION INTERFACES
%% ==========================================

namespace Application_Interfaces {

    class IQuoteStore {
        <<interface>>
        +FindAsync()
        +FindPaymentByOrderAsync()
        +CanRetailerAccessAsync()
        +SaveChangesAsync()
    }

    class IPurchaseOrderGateStore {
        <<interface>>
        +LoadForUpdateAsync()
        +AddPurchaseOrder()
        +AddPickingList()
        +AddPickingItem()
        +AddHistory()
        +ExecuteInTransactionAsync()
        +SaveChangesAsync()
    }

    class IPickingStore {
        <<interface>>
        +FindAsync()
        +ListAsync()
        +ListByOrderAsync()
        +FindLabelForUpdateAsync()
        +AddLabel()
        +AddLabelEvent()
        +AddShipment()
        +AddOrderHistory()
        +ShipmentExistsAsync()
        +ExecuteInTransactionAsync()
        +SaveChangesAsync()
    }

    class IShipmentStore {
        <<interface>>
        +FindByIdAsync()
        +FindOrderForUpdateAsync()
        +ListByOrderAsync()
        +ListExpectedWarehousesAsync()
        +ListIssuableAsync()
        +ListLabelsAsync()
        +FindDriverAsync()
        +FindVehicleAsync()
        +CanAccessWarehouseAsync()
        +AddShipment()
        +AddInventoryTransaction()
        +AddReceipt()
        +AddReceiptLine()
        +AddReceiptQrLabel()
        +AddOrderHistory()
        +ExecuteInTransactionAsync()
        +SaveChangesAsync()
    }

    class IComplaintStore {
        <<interface>>
        +ListAsync()
        +CreateAsync()
        +ResolveAsync()
    }

    class IOrderCompletionStore {
        <<interface>>
        +FindAsync()
        +CompleteAsync()
    }
}

