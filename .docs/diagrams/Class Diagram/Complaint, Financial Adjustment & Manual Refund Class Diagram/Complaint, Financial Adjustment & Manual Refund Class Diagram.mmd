%% ==========================================
%% API DEPENDENCIES
%% ==========================================

ComplaintsController ..> ComplaintService : uses

PaymentsController ..> PaymentService : uses

RefundsController ..> RefundService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

ComplaintService ..> IComplaintStore : uses

ComplaintService ..> OrderCompletionService : evaluates completion

PaymentService ..> IPaymentStore : uses

RefundService ..> IRefundStore : uses

RefundService ..> IPaymentStore : checks payment and transaction

OrderCompletionService ..> IOrderCompletionStore : uses

OrderCompletionService ..> LoyaltyAccrualService : evaluates loyalty

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

ComplaintStore ..|> IComplaintStore : implements

PaymentStore ..|> IPaymentStore : implements

RefundStore ..|> IRefundStore : implements

OrderCompletionStore ..|> IOrderCompletionStore : implements

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

ComplaintStore ..> ReceiptDiscrepancy : creates and resolves

ComplaintStore ..> ReceiptDiscrepancyItem : manages

ComplaintStore ..> ReceiptConfirmation : validates receipt

ComplaintStore ..> ReceiptConfirmationItem : validates actual quantity

ComplaintStore ..> Allocation : retrieves final batch price

PaymentStore ..> Payment : manages

PaymentStore ..> AuditLog : records adjustment audit

RefundStore ..> ManualRefund : manages

RefundStore ..> Payment : reads refund obligation

RefundStore ..> AuditLog : records refund audit

OrderCompletionStore ..> SalesOrder : evaluates and completes

%% ==========================================
%% ORDER RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..1" Payment : payment obligation

SalesOrder "1" -- "0..*" Shipment : warehouse shipments

SalesOrder "1" -- "0..*" ReceiptConfirmation : received portions

SalesOrder "1" -- "0..*" ReceiptDiscrepancy : complaints

SalesOrder "1" -- "0..*" ManualRefund : refund obligations

%% ==========================================
%% RECEIPT RELATIONSHIPS
%% ==========================================

Shipment "0..1" -- "0..*" ReceiptConfirmation : receipt records

ReceiptConfirmation "1" *-- "0..*" ReceiptConfirmationItem : contains

ReceiptConfirmation "1" -- "0..*" ReceiptDiscrepancy : reported issues

%% ==========================================
%% COMPLAINT COMPOSITION
%% ==========================================

ReceiptDiscrepancy "1" *-- "1..*" ReceiptDiscrepancyItem : contains

%% ==========================================
%% BATCH AND ALLOCATION TRACEABILITY
%% ==========================================

Batch "1" -- "0..*" Allocation : allocated portions

Batch "0..1" -- "0..*" ReceiptDiscrepancyItem : affected batch

Shipment "0..1" -- "0..*" ReceiptDiscrepancyItem : affected shipment

Allocation "0..1" -- "0..*" ReceiptDiscrepancyItem : final price source

%% ==========================================
%% REFUND RELATIONSHIPS
%% ==========================================

Payment "1" -- "0..*" ManualRefund : refund obligations

%% ==========================================
%% USER RELATIONSHIPS
%% ==========================================

UserAccount "1" -- "0..*" ReceiptDiscrepancy : reports

UserAccount "0..1" -- "0..*" ReceiptDiscrepancy : reviews

UserAccount "1" -- "0..*" ManualRefund : creates

UserAccount "0..1" -- "0..*" ManualRefund : verifies