classDiagram
direction TB

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class ComplaintsController {
        <<Controller>>
        +List()
        +Create()
        +Resolve()
        -ActorId()
        -Role()
    }

    class PaymentsController {
        <<Controller>>
        +List()
        +GetByOrder()
        +Collect()
        +Adjust()
    }

    class RefundsController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Evidence()
        +Verify()
        -UserId()
        -Role()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class ComplaintService {
        <<Service>>
        +CreateAsync()
        +ListAsync()
        +ResolveAsync()
    }

    class PaymentService {
        <<Service>>
        +ListAsync()
        +GetByOrderAsync()
        +CollectAsync()
        +AdjustReceivableAsync()
        -ValidateReadRole()
        -NormalizeOperationKey()
        -ValidateAmount()
        -ToResult()
    }

    class RefundService {
        <<Service>>
        +CreateAsync()
        +ListAsync()
        +GetAsync()
        +SubmitEvidenceAsync()
        +VerifyAsync()
        -EnsureOperator()
        -EnsureRead()
        -ValidateAmount()
        -MutateAsync()
        -Reload()
        -Audit()
        -ToResult()
    }

    class OrderCompletionService {
        <<Service>>
        +EvaluateAsync()
        -HoldAsync()
    }

    class LoyaltyAccrualService {
        <<Service>>
        +EvaluateAsync()
    }
}

%% ==========================================
%% APPLICATION INTERFACES
%% ==========================================

namespace Application_Interfaces {

    class IComplaintStore {
        <<interface>>
        +CreateAsync()
        +ListAsync()
        +ResolveAsync()
    }

    class IPaymentStore {
        <<interface>>
        +FindByOrderAsync()
        +FindByOperationKeyAsync()
        +ListAsync()
        +CanViewAsync()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class IRefundStore {
        <<interface>>
        +FindAsync()
        +FindByOperationKeyAsync()
        +ListAsync()
        +TotalsAsync()
        +Add()
        +AddAuditLog()
        +SaveChangesAsync()
    }

    class IOrderCompletionStore {
        <<interface>>
        +FindAsync()
        +CompleteAsync()
    }
}

%% ==========================================
%% PERSISTENCE LAYER
%% ==========================================

namespace Persistence {

    class ComplaintStore {
        <<Repository>>
        +CreateAsync()
        +ListAsync()
        +ResolveAsync()
        -ToResult()
    }

    class PaymentStore {
        <<Repository>>
        +FindByOrderAsync()
        +FindByOperationKeyAsync()
        +ListAsync()
        +CanViewAsync()
        +AddAuditLog()
        +SaveChangesAsync()
        +ExecuteInTransactionAsync()
        +ClearTracking()
    }

    class RefundStore {
        <<Repository>>
        +FindAsync()
        +FindByOperationKeyAsync()
        +ListAsync()
        +TotalsAsync()
        +Add()
        +AddAuditLog()
        +SaveChangesAsync()
        -LoadAsync()
    }

    class OrderCompletionStore {
        <<Repository>>
        +FindAsync()
        +CompleteAsync()
    }
}

