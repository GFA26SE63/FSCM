        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass ReceiptDiscrepancy {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ReceiptConfirmationId : Guid «FK»\n  -ReportedByRetailerUserId : Guid «FK»\n  -ReviewedByUserId : Guid? «FK»\n  -Status : string\n  -Note : string?\n  -ReportedAt : DateTimeOffset\n  -ReviewedAt : DateTimeOffset?\n  -ResolvedAt : DateTimeOffset?\n}\n\nclass ReceiptDiscrepancyItem {\n  -Id : Guid «PK»\n  -ReceiptDiscrepancyId : Guid «FK»\n  -BatchId : Guid? «FK»\n  -IssueType : string\n  -ExpectedQuantity : decimal\n  -ActualReceivedQuantity : decimal\n  -EvidenceBlobUrl : string?\n  -Note : string?\n}\n\nclass ReceiptConfirmation {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ShipmentId : Guid? «FK»\n  -ConfirmedByRetailerUserId : Guid «FK»\n  -Status : string\n  -ConfirmedAt : DateTimeOffset\n}\n\nclass ReceiptConfirmationItem {\n  -Id : Guid «PK»\n  -ReceiptConfirmationId : Guid «FK»\n  -SalesOrderLineId : Guid? «FK»\n  -BatchId : Guid «FK»\n  -BatchQrLabelId : Guid «FK»\n  -ExpectedQuantity : decimal\n  -ReceivedQuantity : decimal\n  -DamagedQuantity : decimal\n  -MissingQuantity : decimal\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -FinalAmount : decimal\n  -Status : string\n}\n\nclass Payment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -Amount : decimal\n  -AdjustedAmount : decimal\n  -ConfirmedAmount : decimal\n  -Status : string\n  -Version : int\n}\n\nclass AdjustReceivableData {\n  +Amount : decimal\n  +Reason : string\n  +ExpectedVersion : int\n}\n\nclass ManualRefund {\n  -Id : Guid «PK»\n  -PaymentId : Guid «FK»\n  -SalesOrderId : Guid «FK»\n  -Amount : decimal\n  -Recipient : string\n  -Reason : string\n  -Status : string\n  -CreateOperationKey : string «UK»\n  -CreateRequestHash : string\n  -EvidenceOperationKey : string? «UK»\n  -TransferredAt : DateTimeOffset?\n  -TransactionReference : string?\n  -EvidenceReference : string?\n  -SubmittedByUserId : Guid? «FK»\n  -SubmittedAt : DateTimeOffset?\n  -VerificationOperationKey : string? «UK»\n  -VerifiedByUserId : Guid? «FK»\n  -VerifiedAt : DateTimeOffset?\n  -VerificationNote : string?\n  -CreatedByUserId : Guid «FK»\n  -Version : int\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -BatchCode : string\n  -ProductId : Guid «FK»\n  -ExpirationDate : DateOnly\n}\n\nclass BatchQrLabel {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK»\n  -QrCode : string «UK»\n  -Quantity : decimal\n  -Status : string\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nclass ComplaintResult {\n  +Id : Guid\n  +Code : string\n  +OrderCode : string\n  +RetailerCode : string\n  +Sku : string\n  +ExpectedQuantity : decimal\n  +ActualQuantity : decimal\n  +IssueType : string\n  +Status : string\n  +LabelCode : string?\n  +EvidenceUrl : string?\n  +Response : string?\n}\n\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmation : receipt evidence\nReceiptConfirmation \&quot;1\&quot; *-- \&quot;1..*\&quot; ReceiptConfirmationItem : received quantities\nReceiptConfirmation \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancy : complaints\nReceiptDiscrepancy \&quot;1\&quot; *-- \&quot;1..*\&quot; ReceiptDiscrepancyItem : complaint items\nBatch \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancyItem : affected batch\nBatch \&quot;1\&quot; *-- \&quot;0..*\&quot; BatchQrLabel : trace labels\nBatchQrLabel \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptConfirmationItem : scan evidence\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ReceiptDiscrepancy : reports or reviews\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : receivable\nReceiptDiscrepancy ..&gt; AdjustReceivableData : approved adjustment\nAdjustReceivableData ..&gt; Payment : changes adjusted amount\nPayment \&quot;1\&quot; -- \&quot;0..*\&quot; ManualRefund : refunds excess collection\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ManualRefund : order refunds\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; ManualRefund : creates submits verifies\nReceiptDiscrepancy ..&gt; ComplaintResult : API projection\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="37XTFx3NMBc1NEoN56Ax-1">
