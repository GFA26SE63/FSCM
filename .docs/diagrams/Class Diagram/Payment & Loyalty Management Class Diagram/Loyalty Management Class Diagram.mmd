LoyaltyRewardsController ..> RewardService : uses

LoyaltyRedemptionsController ..> RedemptionService : uses

LoyaltyRedemptionWorkflowController ..> RedemptionWorkflowService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

LoyaltyService ..> ILoyaltyStore : uses

LoyaltyCardService ..> ILoyaltyCardStore : uses

RewardService ..> IRewardStore : uses

RedemptionService ..> IRedemptionStore : uses

RedemptionWorkflowService ..> IRedemptionWorkflowStore : uses

LoyaltyAccrualService ..> ILoyaltyAccrualStore : uses

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

LoyaltyStore ..|> ILoyaltyStore : implements

LoyaltyCardStore ..|> ILoyaltyCardStore : implements

RewardStore ..|> IRewardStore : implements

RedemptionStore ..|> IRedemptionStore : implements

RedemptionStore ..|> IRedemptionWorkflowStore : implements

LoyaltyAccrualStore ..|> ILoyaltyAccrualStore : implements

%% ==========================================
%% LOYALTY PROGRAM RELATIONSHIPS
%% ==========================================

LoyaltyProgram "1" -- "0..*" LoyaltyProgramRetailer : enrollments

Retailer "1" -- "0..*" LoyaltyProgramRetailer : participates in

LoyaltyProgram "1" -- "0..*" LoyaltyReward : offers

%% ==========================================
%% LOYALTY ACCOUNT RELATIONSHIPS
%% ==========================================

Retailer "1" -- "0..1" RetailerLoyalty : loyalty account

RetailerLoyalty "1" -- "0..*" LoyaltyTransaction : transaction history

LoyaltyProgram "1" -- "0..*" LoyaltyTransaction : points program

SalesOrder "0..1" -- "0..*" LoyaltyTransaction : earning source

%% ==========================================
%% REWARD REDEMPTION RELATIONSHIPS
%% ==========================================

Retailer "1" -- "0..*" RewardRedemption : requests

LoyaltyReward "1" -- "0..*" RewardRedemption : redeemed reward

LoyaltyTransaction "0..1" -- "0..*" RewardRedemption : points movement

SalesOrder "0..1" -- "0..*" RewardRedemption : related order

%% ==========================================
%% BUSINESS CONSTRAINTS
%% ==========================================

note for RetailerLoyalty "Available points are current points minus held points."

note for LoyaltyTransaction "Point movements must be traceable and idempotent."

note for LoyaltyAccrualService "Award points only after delivery, settlement and complaint conditions are satisfied."

note for RewardRedemption "Redemption workflow manages point holds, approval, delivery and completion."