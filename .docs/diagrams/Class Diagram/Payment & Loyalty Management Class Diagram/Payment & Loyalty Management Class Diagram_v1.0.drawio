        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Payment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -Method : string\n  -Status : string\n  -Amount : decimal\n  -AdjustedAmount : decimal\n  -ConfirmedAmount : decimal\n  -FinalApprovedAt : DateTimeOffset\n  -DeliveredDate : DateOnly?\n  -DueDate : DateOnly?\n  -PaidDate : DateOnly?\n  -CollectionMethod : string?\n  -PayOsOrderCode : long? «UK»\n  -PayOsPaymentLinkId : string? «UK»\n  -PayOsReference : string? «UK»\n  -ConfirmedByUserId : Guid? «FK»\n  -ConfirmedAt : DateTimeOffset?\n  -Version : int\n}\n\nclass ManualPayment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -Method : string\n  -Status : string\n  -Amount : decimal\n  -OperationKey : string «UK»\n  -RequestHash : string\n  -ConfirmedByUserId : Guid? «FK»\n  -ConfirmedAt : DateTimeOffset?\n  -Note : string?\n  -Version : int\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -PaymentMethod : string\n  -FinalAmount : decimal\n  -CreditTermDays : int\n  -Status : string\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -UserAccountId : Guid? «FK»\n}\n\nclass RetailerLoyalty {\n  -Id : Guid «PK»\n  -RetailerId : Guid «FK, UK»\n  -CurrentPoints : int\n  -HeldPoints : int\n  -LifetimeEarnedPoints : int\n  -LifetimeRedeemedPoints : int\n  -CreatedAt : DateTimeOffset\n  -UpdatedAt : DateTimeOffset\n}\n\nclass LoyaltyProgram {\n  -Id : Guid «PK»\n  -Code : string «UK»\n  -Name : string\n  -Description : string?\n  -SpendAmountPerPoint : decimal\n  -MinimumRedeemPoints : int\n  -StartAt : DateTimeOffset\n  -EndAt : DateTimeOffset\n  -PointsExpireAt : DateTimeOffset?\n  -IsActive : bool\n  -CreatedByUserId : Guid «FK»\n}\n\nclass LoyaltyProgramRetailer {\n  -Id : Guid «PK»\n  -LoyaltyProgramId : Guid «FK»\n  -RetailerId : Guid «FK»\n}\n\nclass LoyaltyTransaction {\n  -Id : Guid «PK»\n  -LoyaltyProgramId : Guid «FK»\n  -RetailerLoyaltyId : Guid «FK»\n  -SalesOrderId : Guid? «FK»\n  -CreatedByUserId : Guid? «FK»\n  -TransactionType : string\n  -Points : int\n  -BalanceAfter : int\n  -Note : string?\n  -CreatedAt : DateTimeOffset\n}\n\nclass LoyaltyReward {\n  -Id : Guid «PK»\n  -LoyaltyProgramId : Guid «FK»\n  -Code : string «UK»\n  -Name : string\n  -RewardType : string\n  -RequiredPoints : int\n  -DiscountAmount : decimal?\n  -DiscountPercent : decimal?\n  -AvailableQuantity : int?\n  -IsActive : bool\n}\n\nclass RewardRedemption {\n  -Id : Guid «PK»\n  -RetailerId : Guid «FK»\n  -LoyaltyRewardId : Guid «FK»\n  -LoyaltyTransactionId : Guid? «FK, UK»\n  -SalesOrderId : Guid? «FK»\n  -ClientRequestId : string\n  -RedeemedPoints : int\n  -Status : string\n  -RedeemedByUserId : Guid «FK»\n  -RedeemedAt : DateTimeOffset\n  -FulfilledAt : DateTimeOffset?\n  -CancelledAt : DateTimeOffset?\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -FullName : string\n  -Role : string\n}\n\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : receivable\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; ManualPayment : manual collections\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; Payment : confirms\nUserAccount \&quot;0..1\&quot; -- \&quot;0..*\&quot; ManualPayment : confirms\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : orders\nRetailer \&quot;1\&quot; *-- \&quot;0..1\&quot; RetailerLoyalty : points account\nLoyaltyProgram \&quot;1\&quot; *-- \&quot;0..*\&quot; LoyaltyReward : rewards\nLoyaltyProgram \&quot;1\&quot; -- \&quot;0..*\&quot; LoyaltyProgramRetailer : scope\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; LoyaltyProgramRetailer : enrolled\nLoyaltyProgram \&quot;1\&quot; -- \&quot;0..*\&quot; LoyaltyTransaction : rules\nRetailerLoyalty \&quot;1\&quot; *-- \&quot;0..*\&quot; LoyaltyTransaction : ledger\nSalesOrder \&quot;0..1\&quot; -- \&quot;0..*\&quot; LoyaltyTransaction : earning source\nLoyaltyReward \&quot;1\&quot; -- \&quot;0..*\&quot; RewardRedemption : redeemed reward\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; RewardRedemption : redeems\nLoyaltyTransaction \&quot;0..1\&quot; -- \&quot;0..1\&quot; RewardRedemption : redemption debit\nSalesOrder \&quot;0..1\&quot; -- \&quot;0..*\&quot; RewardRedemption : applied to\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; RewardRedemption : performs\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pbI5CuV-5k6RfPxbgzPh-1">
