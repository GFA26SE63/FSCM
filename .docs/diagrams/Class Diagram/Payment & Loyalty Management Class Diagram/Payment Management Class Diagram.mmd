%% ==========================================
%% DOMAIN - PAYMENT
%% ==========================================

namespace Domain_Payment {

    class Payment {
        +Id: Guid
        +SalesOrderId: Guid
        +Amount: decimal
        +AdjustedAmount: decimal
        +ConfirmedAmount: decimal
        +Method: string
        +CollectionMethod: string
        +Status: string
        +DueDate: DateTimeOffset
        +PaidDate: DateTimeOffset
        +PayOsOrderCode: string
        +OperationKey: string
        +Version: int
        +CreatedAt: DateTimeOffset
    }

    class PaymentReceipt {
        +Id: Guid
        +ReceiptCode: string
        +RetailerId: Guid
        +ReceivedAmount: decimal
        +UnappliedCreditAmount: decimal
        +Reference: string
        +Status: string
        +OperationKey: string
        +ConfirmedAt: DateTimeOffset
        +ConfirmedByUserId: Guid
        +ReversedAt: DateTimeOffset
        +Version: int
    }

    class PaymentReceiptAllocation {
        +Id: Guid
        +PaymentReceiptId: Guid
        +PaymentId: Guid
        +Amount: decimal
        +CreatedAt: DateTimeOffset
    }

    class ManualRefund {
        +Id: Guid
        +SalesOrderId: Guid
        +PaymentId: Guid
        +Amount: decimal
        +Reason: string
        +Recipient: string
        +Status: string
        +TransactionReference: string
        +EvidenceReference: string
        +VerifiedAt: DateTimeOffset
        +VerifiedByUserId: Guid
        +Version: int
    }
}

%% ==========================================
%% DOMAIN - REFERENCES
%% ==========================================

namespace Domain_References {

    class Retailer {
        +Id: Guid
