        +SalesOrderId: Guid
        +PaymentMethod: string
        +Status: string
        +IssuedAt: DateTimeOffset
    }
}

%% ==========================================
%% API DEPENDENCIES
%% ==========================================

PaymentsController ..> PaymentService : uses

PaymentReceiptsController ..> PaymentReceiptService : uses

RetailerReceivablesController ..> RetailerReceivableService : uses

RefundsController ..> RefundService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

PaymentService ..> IPaymentStore : uses

PaymentService ..> IPayOsGateway : uses

PaymentService ..> PurchaseOrderGateService : checks issuance

PaymentReceiptService ..> IPaymentReceiptStore : uses

RetailerReceivableService ..> IRetailerReceivableStore : uses

RefundService ..> IRefundStore : uses

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

PaymentStore ..|> IPaymentStore : implements

PaymentReceiptStore ..|> IPaymentReceiptStore : implements

RetailerReceivableStore ..|> IRetailerReceivableStore : implements

RefundStore ..|> IRefundStore : implements

PayOsGateway ..|> IPayOsGateway : implements

%% ==========================================
%% PAYMENT RELATIONSHIPS
%% ==========================================

Retailer "1" -- "0..*" SalesOrder : places

SalesOrder "1" -- "0..1" Payment : payment obligation

SalesOrder "1" -- "0..1" PurchaseOrder : generates

Retailer "1" -- "0..*" PaymentReceipt : makes payments

%% ==========================================
%% CONSOLIDATED PAYMENT RECEIPTS
%% ==========================================

PaymentReceipt "1" *-- "0..*" PaymentReceiptAllocation : contains

Payment "1" -- "0..*" PaymentReceiptAllocation : receives allocations

%% ==========================================
%% MANUAL REFUND RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" ManualRefund : refund obligations

Payment "0..1" -- "0..*" ManualRefund : related payment

%% ==========================================
%% BUSINESS CONSTRAINTS
%% ==========================================

note for PaymentReceipt "One receipt can fund multiple payment obligations."

note for PaymentReceiptAllocation "Each allocation applies a portion of the received amount."

note for ManualRefund "Refunds require manual transfer and evidence verification."

note for PurchaseOrder "Prepaid orders require verified full payment before issuance."