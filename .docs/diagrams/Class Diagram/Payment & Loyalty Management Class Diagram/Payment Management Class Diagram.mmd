    }

    class SalesOrder {
        +Id: Guid
        +OrderCode: string
        +RetailerId: Guid
        +FinalAmount: decimal
        +PaymentMethod: string
        +Status: string
    }

    class PurchaseOrder {
        +Id: Guid
