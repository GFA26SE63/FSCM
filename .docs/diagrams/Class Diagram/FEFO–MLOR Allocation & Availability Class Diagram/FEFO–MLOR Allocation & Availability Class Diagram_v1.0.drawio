        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass AllocationRun {\n  -Id : Guid «PK»\n  -RunCode : string\n  -BusinessDate : DateOnly «UK»\n  -CutoffAt : DateTimeOffset\n  -Status : string\n  -AlgorithmSettings : json\n  -TransitTableVersion : int\n  -EtaScheduleVersion : int\n  -OrderCount : int\n  -FailureReason : string?\n  -StartedAt : DateTimeOffset\n  -SnapshotCompletedAt : DateTimeOffset?\n  -CompletedAt : DateTimeOffset?\n  -Version : int\n}\n\nclass AllocationRunOrder {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -SalesOrderId : Guid «FK»\n  -OrderCodeSnapshot : string\n  -RetailerId : Guid «REF»\n  -AcceptedAt : DateTimeOffset\n  -DeliveryDeadline : DateOnly?\n  -PriorityRank : int\n  -Status : string\n  -ShortageReason : string?\n}\n\nclass AllocationRunLine {\n  -Id : Guid «PK»\n  -AllocationRunOrderId : Guid «FK»\n  -SalesOrderLineId : Guid «FK»\n  -ProductId : Guid «REF»\n  -SkuSnapshot : string\n  -LineNumber : int\n  -OrderedQuantity : decimal\n  -TotalShelfLifeHours : int\n  -EffectiveMlorRatio : decimal\n  -MlorSource : string\n  -ListUnitPrice : decimal\n  -BaseNetUnitPrice : decimal\n  -AllocatedQuantity : decimal\n}\n\nclass AllocationRunStock {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «REF»\n  -ProductId : Guid «REF»\n  -ExpirationDate : DateOnly\n  -SnapshotQuantity : decimal\n  -RemainingQuantity : decimal\n  -InventoryVersion : int\n}\n\nclass AllocationPlanVersion {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -VersionNumber : int\n  -Status : string\n  -PricedAt : DateTimeOffset\n  -FulfilledOrderCount : int\n  -ShortOrderCount : int\n  -TotalFinalAmount : decimal\n  -ApprovedByUserId : Guid? «FK»\n  -ApprovedAt : DateTimeOffset?\n  -RecalculationReason : string?\n  -Version : int\n}\n\nclass AllocationRunAllocation {\n  -Id : Guid «PK»\n  -AllocationRunId : Guid «FK»\n  -AllocationPlanVersionId : Guid «FK»\n  -AllocationRunLineId : Guid «FK»\n  -BatchId : Guid «FK»\n  -WarehouseId : Guid «REF»\n  -Quantity : decimal\n  -Sequence : int\n  -EstimatedArrivalAt : DateTimeOffset\n  -RemainingShelfLifeHours : decimal\n  -WeightedScore : decimal\n}\n\nclass AllocationLineTrace {\n  -Id : Guid «PK»\n  -AllocationPlanVersionId : Guid «FK»\n  -AllocationRunLineId : Guid «FK»\n  -Outcome : string\n  -OrderedQuantity : decimal\n  -DrawnQuantity : decimal\n  -ShortageQuantity : decimal\n  -RequiredShelfLifeHours : decimal\n  -ShelfLifeWeight : decimal\n  -DistanceWeight : decimal\n  -CoverageWeight : decimal\n  -MaximumDistanceMeters : decimal\n  -Note : string?\n}\n\nclass AllocationTraceCandidate {\n  -Id : Guid «PK»\n  -AllocationLineTraceId : Guid «FK»\n  -BatchId : Guid «REF»\n  -WarehouseId : Guid «REF»\n  -Stage : string\n  -Passed : bool\n  -Reason : string\n  -EstimatedArrivalAt : DateTimeOffset?\n  -RemainingShelfLifeHours : decimal?\n  -RequiredShelfLifeHours : decimal?\n}\n\nclass AllocationTraceScore {\n  -Id : Guid «PK»\n  -AllocationLineTraceId : Guid «FK»\n  -Iteration : int\n  -Rank : int\n  -BatchId : Guid «REF»\n  -WarehouseId : Guid «REF»\n  -RemainingDemand : decimal\n  -ShelfLifeScore : decimal\n  -DistanceScore : decimal\n  -CoverageScore : decimal\n  -WeightedScore : decimal\n  -Selected : bool\n  -SelectedQuantity : decimal\n}\n\nclass Batch {\n  -Id : Guid «PK»\n  -WarehouseId : Guid «FK»\n  -ProductId : Guid «FK»\n  -BatchCode : string\n  -Quantity : decimal\n  -ExpirationDate : DateOnly\n  -ExpiryStatus : string\n  -StockStatus : string\n  -Version : int\n}\n\nclass InventoryBalance {\n  -Id : Guid «PK»\n  -BatchId : Guid «FK, UK»\n  -PhysicalQuantity : decimal\n  -ReservedQuantity : decimal\n  -AvailableQuantity : decimal\n  -Version : int\n  -UpdatedAt : DateTimeOffset\n}\n\nclass Reservation {\n  -Id : Guid «PK»\n  -AllocationRunAllocationId : Guid? «FK, UK»\n  -BatchId : Guid «FK»\n  -Quantity : decimal\n  -Status : string\n  -ReservedAt : DateTimeOffset\n  -ReleasedAt : DateTimeOffset?\n  -ConsumedAt : DateTimeOffset?\n}\n\nclass Warehouse {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Type : string\n  -MinimumStockThresholdCartons : int\n  -IsActive : bool\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -Sku : string\n  -Name : string\n  -ShelfLifeHours : int\n  -Status : string\n}\n\nclass RetailerProductMlor {\n  -Id : Guid «PK»\n  -RetailerId : Guid «FK»\n  -ProductCategoryId : Guid? «FK»\n  -ProductId : Guid? «FK»\n  -MinimumLifeRatio : decimal\n  -MinimumLifeHours : int?\n  -Version : int\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -Status : string\n  -ServerReceivedAt : DateTimeOffset\n}\n\nclass SalesOrderLine {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ProductId : Guid «FK»\n  -OrderedQuantity : decimal\n  -MlorSourceRuleId : Guid? «FK»\n  -MlorSourceVersion : int\n  -MlorMinimumLifeRatio : decimal\n}\n\nAllocationRun \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunOrder : freezes orders\nSalesOrder \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunOrder : snapshot of\nAllocationRunOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; AllocationRunLine : lines\nSalesOrderLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunLine : snapshot of\nAllocationRun \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunStock : stock pool\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunStock : snapshot of\nAllocationRun \&quot;1\&quot; *-- \&quot;1..*\&quot; AllocationPlanVersion : proposals\nAllocationPlanVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationRunAllocation : allocations\nAllocationRunLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunAllocation : fulfilled by\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationRunAllocation : selected batch\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : stores\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Batch : batches\nBatch \&quot;1\&quot; *-- \&quot;1\&quot; InventoryBalance : availability\nAllocationRunAllocation \&quot;1\&quot; -- \&quot;0..1\&quot; Reservation : creates on approval\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation : reserves\nAllocationPlanVersion \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationLineTrace : explains\nAllocationRunLine \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationLineTrace : traced line\nAllocationLineTrace \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationTraceCandidate : hard filters\nAllocationLineTrace \&quot;1\&quot; *-- \&quot;0..*\&quot; AllocationTraceScore : scoring turns\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationTraceCandidate : evaluated batch\nBatch \&quot;1\&quot; -- \&quot;0..*\&quot; AllocationTraceScore : ranked batch\nRetailerProductMlor \&quot;0..1\&quot; -- \&quot;0..*\&quot; SalesOrderLine : snapshotted rule\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrderLine : requested product\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jSn53eUcqiZIJZWcjUvS-1">
