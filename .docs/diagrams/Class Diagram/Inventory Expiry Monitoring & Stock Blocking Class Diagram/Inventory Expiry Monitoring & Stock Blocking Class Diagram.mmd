classDiagram
direction TB

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class InventoryController {
        <<Controller>>
        +List()
        +GetBatch()
        +History()
        +ExpiryHealth()
    }

    class InventoryLocksController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Release()
    }
}

%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class InventoryService {
        <<Service>>
        +ListInventoryAsync()
        +GetBatchAsync()
        +ListHistoryAsync()
        +GetExpiryHealthAsync()
    }

    class InventoryExpirySweepService {
        <<Service>>
        +RunAsync()
        -CalculateExpiryStatus()
        -BuildExpiryLock()
        -BuildBatchExpiredMessage()
    }

    class InventoryLockService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +CreateAsync()
        +ReleaseAsync()
        -EnsureWarehouseAccessAsync()
        -EnsureWriteRole()
    }

    class InventoryLifecycleService {
        <<Service>>
        +GetAsync()
        +ReserveAsync()
        +ReleaseAsync()
        +IssueAsync()
    }

    class InventoryOutboxDispatcher {
        <<Service>>
        +DispatchAsync()
    }
}

%% ==========================================
%% APPLICATION INTERFACES
%% ==========================================

namespace Application_Interfaces {

    class IInventoryStore {
        <<interface>>
        +ListInventoryAsync()
        +FindBatchInventoryAsync()
        +ListHistoryAsync()
        +FindLatestExpirySweepRunAsync()
        +CountOutboxMessagesAsync()
        +CanAccessWarehouseAsync()
        +FindBalanceForUpdateAsync()
        +AddTransaction()
        +SaveChangesAsync()
    }

    class IBatchExpiryStore {
        <<interface>>
        +ListBatchesForExpirySweepAsync()
        +AddSweepRun()
        +AddInventoryLock()
        +AddOutboxMessage()
        +SaveChangesAsync()
    }

    class IInventoryLockStore {
        <<interface>>
        +ListAsync()
        +FindAsync()
        +FindBatchContextAsync()
        +FindForUpdateAsync()
        +CanAccessWarehouseAsync()
        +Add()
        +SaveChangesAsync()
    }

    class IInventoryLifecycleStore {
        <<interface>>
        +FindForUpdateAsync()
        +AddReservation()
        +AddTransaction()
        +SaveChangesAsync()
    }

    class IInventoryOutboxStore {
        <<interface>>
        +ListPendingBatchExpiredMessagesAsync()
        +ListExpiryNotificationRecipientsAsync()
        +NotificationExistsAsync()
        +AddNotification()
        +SaveChangesAsync()
    }
}

%% ==========================================
%% PERSISTENCE LAYER
%% ==========================================

namespace Persistence {

    class InventoryStore {
        <<Repository>>
        +ListInventoryAsync()
        +FindBatchInventoryAsync()
        +ListHistoryAsync()
        +FindLatestExpirySweepRunAsync()
        +ListBatchesForExpirySweepAsync()
        +FindForUpdateAsync()
        +FindBalanceForUpdateAsync()
        +AddSweepRun()
        +AddInventoryLock()
        +AddOutboxMessage()
        +AddReservation()
        +AddTransaction()
        +SaveChangesAsync()
    }

    class InventoryLockStore {
        <<Repository>>
        +ListAsync()
        +FindAsync()
        +FindBatchContextAsync()
        +FindForUpdateAsync()
        +CanAccessWarehouseAsync()
        +Add()
        +SaveChangesAsync()
    }

    class InventoryOutboxStore {
        <<Repository>>
        +ListPendingBatchExpiredMessagesAsync()
        +ListExpiryNotificationRecipientsAsync()
        +NotificationExistsAsync()
        +AddNotification()
        +SaveChangesAsync()
    }
}

%% ==========================================
%% INFRASTRUCTURE - BACKGROUND JOBS
%% ==========================================

namespace Infrastructure {

    class DateTrackerHostedService {
        <<BackgroundJob>>
        #ExecuteAsync()
        -RunSweepAsync()
        -GetDelayUntilNextRun()
    }

    class InventoryOutboxHostedService {
        <<BackgroundJob>>
        #ExecuteAsync()
    }
}

%% ==========================================
%% DOMAIN - INVENTORY
%% ==========================================

namespace Domain_Inventory {

    class Batch {
        +Id: Guid
        +ProductId: Guid
        +WarehouseId: Guid
        +BatchCode: string
        +ProductionDate: DateOnly
        +ExpirationDate: DateOnly
        +Quantity: int
        +StockStatus: string
        +ExpiryStatus: string
        +ParentBatchId: Guid
        +RootBatchId: Guid
        +Version: int
        +CreatedAt: DateTimeOffset
        +UpdatedAt: DateTimeOffset
    }

    class InventoryBalance {
        +Id: Guid
        +BatchId: Guid
        +PhysicalQuantity: int
        +ReservedQuantity: int
        +AvailableQuantity: int
        +Version: int
        +UpdatedAt: DateTimeOffset
    }

    class InventoryLock {
        +Id: Guid
        +BatchId: Guid
        +ProductId: Guid
        +WarehouseId: Guid
        +LockedQuantity: int
        +Reason: string
        +Note: string
        +RequiresResolution: bool
        +Status: string
        +LockedByUserId: Guid
        +ReleasedByUserId: Guid
        +ReleasedAt: DateTimeOffset
        +Version: int
        +CreatedAt: DateTimeOffset
        +UpdatedAt: DateTimeOffset
    }

    class Reservation {
        +Id: Guid
        +BatchId: Guid
        +AllocationId: Guid
        +Quantity: int
        +Status: string
        +ReservedAt: DateTimeOffset
        +ReleasedAt: DateTimeOffset
        +ConsumedAt: DateTimeOffset
    }

    class InventoryTransaction {
        +Id: Guid
        +ProductId: Guid
        +BatchId: Guid
        +WarehouseId: Guid
        +TransactionType: string
        +SourceType: string
        +SourceId: Guid
        +ReferenceCode: string
        +PhysicalQuantityDelta: int
        +ReservedQuantityDelta: int
        +PhysicalQuantityAfter: int
        +ReservedQuantityAfter: int
        +AvailableQuantityAfter: int
        +OccurredAt: DateTimeOffset
    }
}

%% ==========================================
%% DOMAIN - EXPIRY MONITORING
%% ==========================================

namespace Domain_Expiry {

    class ExpirySweepRun {
