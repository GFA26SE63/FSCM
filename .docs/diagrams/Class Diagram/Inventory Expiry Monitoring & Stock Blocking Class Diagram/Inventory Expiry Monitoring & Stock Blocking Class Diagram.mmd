        +StatusesUpdated: int
        +BatchesExpired: int
        +StartedAt: DateTimeOffset
        +CompletedAt: DateTimeOffset
        +Error: string
    }
}

%% ==========================================
%% DOMAIN - WRITE OFF
%% ==========================================

namespace Domain_WriteOff {

    class WriteOff {
        +Id: Guid
