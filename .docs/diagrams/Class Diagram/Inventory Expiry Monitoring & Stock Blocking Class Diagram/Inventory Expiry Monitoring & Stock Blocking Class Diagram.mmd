    }
}

%% ==========================================
%% API DEPENDENCIES
%% ==========================================

InventoryController ..> InventoryService : uses

InventoryLocksController ..> InventoryLockService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

InventoryService ..> IInventoryStore : uses

InventoryExpirySweepService ..> IBatchExpiryStore : uses

InventoryLockService ..> IInventoryLockStore : uses

InventoryLifecycleService ..> IInventoryLifecycleStore : uses

InventoryOutboxDispatcher ..> IInventoryOutboxStore : uses

%% ==========================================
%% BACKGROUND JOB DEPENDENCIES
%% ==========================================

DateTrackerHostedService ..> InventoryExpirySweepService : executes

InventoryOutboxHostedService ..> InventoryOutboxDispatcher : executes

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

InventoryStore ..|> IInventoryStore : implements

InventoryStore ..|> IBatchExpiryStore : implements

InventoryStore ..|> IInventoryLifecycleStore : implements

InventoryLockStore ..|> IInventoryLockStore : implements

InventoryOutboxStore ..|> IInventoryOutboxStore : implements

%% ==========================================
%% INVENTORY STORE DEPENDENCIES
%% ==========================================

InventoryStore ..> Batch : manages

InventoryStore ..> InventoryBalance : manages

InventoryStore ..> Reservation : manages

InventoryStore ..> InventoryTransaction : records

InventoryStore ..> ExpirySweepRun : records

InventoryStore ..> OutboxMessage : publishes

%% ==========================================
%% INVENTORY LOCK DEPENDENCIES
%% ==========================================

InventoryLockStore ..> InventoryLock : manages

InventoryLockStore ..> Batch : reads

InventoryLockStore ..> InventoryBalance : validates

%% ==========================================
%% OUTBOX DEPENDENCIES
%% ==========================================

InventoryOutboxStore ..> OutboxMessage : processes

InventoryOutboxStore ..> Notification : creates

%% ==========================================
%% WAREHOUSE AND BATCH RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" Batch : stores

Batch "1" -- "0..1" InventoryBalance : has balance

%% ==========================================
%% BATCH LOCKING
%% ==========================================

Batch "1" -- "0..*" InventoryLock : has locks

Warehouse "1" -- "0..*" InventoryLock : lock location

UserAccount "1" -- "0..*" InventoryLock : created by

%% ==========================================
%% RESERVATION RELATIONSHIPS
%% ==========================================

Batch "1" -- "0..*" Reservation : reserved from

Allocation "0..1" -- "0..*" Reservation : related allocation

Batch "1" -- "0..*" Allocation : allocated portions

%% ==========================================
%% INVENTORY TRANSACTION RELATIONSHIPS
%% ==========================================

Batch "1" -- "0..*" InventoryTransaction : stock history

Warehouse "1" -- "0..*" InventoryTransaction : movements

%% ==========================================
%% WRITE OFF RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" WriteOff : write off requests

UserAccount "1" -- "0..*" WriteOff : requested by

WriteOff "1" *-- "0..*" WriteOffItem : contains

WriteOff "1" *-- "0..*" WriteOffAttachment : evidence

Batch "1" -- "0..*" WriteOffItem : affected batch

%% ==========================================
%% NOTIFICATION RELATIONSHIPS
%% ==========================================

OutboxMessage "0..1" -- "0..*" Notification : produces

UserAccount "1" -- "0..*" Notification : receives