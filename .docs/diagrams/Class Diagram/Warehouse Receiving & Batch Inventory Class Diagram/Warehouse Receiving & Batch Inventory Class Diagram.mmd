classDiagram
direction TB

%% ==========================================
%% 1. API LAYER
%% ==========================================

namespace API {

    class GoodsReceiptsController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Approve()
    }

    class InventoryController {
        <<Controller>>
        +List()
        +GetBatch()
        +History()
        +ExpiryHealth()
    }

    class QrLabelsController {
        <<Controller>>
        +List()
        +Get()
        +Generate()
        +PrintBatch()
        +Scan()
        +Split()
    }

    class InventoryLocksController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Release()
    }
}

%% ==========================================
%% 2. APPLICATION LAYER
%% ==========================================

namespace Application {

    class InventoryService {
        <<Service>>
        +CreateReceiptAsync()
        +ApproveReceiptAsync()
        +ListReceiptsAsync()
        +GetReceiptAsync()
        +ListInventoryAsync()
        +GetBatchAsync()
        +ListHistoryAsync()
        +GetExpiryHealthAsync()
        -ValidateLine()
        -CalculateExpiryStatus()
    }

    class QrLabelService {
        <<Service>>
        +ListAsync()
        +GetAsync()
        +GenerateAsync()
        +RenderBatchPrintableAsync()
        +ScanAsync()
        +SplitAsync()
    }

    class InventoryLockService {
        <<Service>>
        +CreateAsync()
        +ReleaseAsync()
        +GetAsync()
        +ListAsync()
    }

    class InventoryExpirySweepService {
        <<Service>>
        +RunAsync()
        -CalculateExpiryStatus()
    }

    class IInventoryStore {
        <<interface>>
        +FindReceiptAsync()
        +FindReceiptForApprovalAsync()
        +FindBatchForUpdateAsync()
        +FindBalanceForUpdateAsync()
        +ListInventoryAsync()
        +AddReceipt()
        +AddReceiptLine()
        +AddBatch()
        +AddBalance()
        +AddTransaction()
        +SaveChangesAsync()
    }

    class IQrLabelStore {
        <<interface>>
        +FindByIdAsync()
        +FindBatchAsync()
        +ListAsync()
        +AddLabel()
        +AddEvent()
        +SaveChangesAsync()
    }

    class IInventoryLockStore {
        <<interface>>
        +FindAsync()
        +FindBatchContextAsync()
        +FindForUpdateAsync()
        +ListAsync()
        +Add()
        +SaveChangesAsync()
    }

    class IBatchExpiryStore {
        <<interface>>
        +ListBatchesForExpirySweepAsync()
        +AddInventoryLock()
        +AddSweepRun()
        +SaveChangesAsync()
    }

    class IQrCodeRenderer {
        <<interface>>
        +RenderPng()
        +RenderSvg()
    }
}

%% ==========================================
%% 3. PERSISTENCE LAYER
%% ==========================================

namespace Persistence {

    class InventoryStore {
        <<Repository>>
        +FindReceiptAsync()
        +FindReceiptForApprovalAsync()
        +FindBatchForUpdateAsync()
        +FindBalanceForUpdateAsync()
        +ListInventoryAsync()
        +AddReceipt()
        +AddReceiptLine()
        +AddBatch()
        +AddBalance()
        +AddTransaction()
        +SaveChangesAsync()
    }

    class QrLabelStore {
        <<Repository>>
        +FindByIdAsync()
        +FindBatchAsync()
        +ListAsync()
        +AddLabel()
        +AddEvent()
        +SaveChangesAsync()
    }

    class InventoryLockStore {
        <<Repository>>
        +FindAsync()
        +FindBatchContextAsync()
        +FindForUpdateAsync()
        +ListAsync()
        +Add()
        +SaveChangesAsync()
    }
}

%% ==========================================
%% 4. INFRASTRUCTURE LAYER
%% ==========================================

namespace Infrastructure {

    class QrCoderQrCodeRenderer {
        <<Service>>
        +RenderPng()
        +RenderSvg()
    }
}

%% ==========================================
%% 5. DOMAIN - GOODS RECEIVING
%% ==========================================

namespace Domain_Receiving {

    class GoodsReceipt {
        +Id: Guid
        +ReceiptCode: string
        +WarehouseId: Guid
        +CreatedByUserId: Guid
        +IdempotencyKey: string
        +RequestHash: string
        +Status: string
        +ReceivedAt: DateTimeOffset
        +ApprovedByUserId: Guid
        +ApprovedAt: DateTimeOffset
        +Version: int
        +CreatedAt: DateTimeOffset
    }

    class GoodsReceiptLine {
        +Id: Guid
        +GoodsReceiptId: Guid
        +ProductId: Guid
        +SourceLotCode: string
        +ReceivedQuantity: int
        +ProductionDate: DateOnly
        +ExpirationDate: DateOnly
        +CreatedAt: DateTimeOffset
    }
}

%% ==========================================
%% 6. DOMAIN - BATCH INVENTORY
%% ==========================================

namespace Domain_Inventory {

    class Warehouse {
        +Id: Guid
        +Code: string
        +Name: string
        +RegionId: Guid
        +IsActive: bool
    }

    class Product {
        +Id: Guid
        +Sku: string
        +Name: string
        +ShelfLifeHours: int
        +Status: string
    }

    class Batch {
        +Id: Guid
        +WarehouseId: Guid
        +ProductId: Guid
        +BatchCode: string
        +ProductionDate: DateOnly
        +ExpirationDate: DateOnly
        +Quantity: int
        +StockStatus: string
        +ExpiryStatus: string
        +Version: int
    }

    class InventoryBalance {
        +Id: Guid
        +BatchId: Guid
        +PhysicalQuantity: int
        +ReservedQuantity: int
        +AvailableQuantity: int
        +Version: int
        +UpdatedAt: DateTimeOffset
    }

    class InventoryTransaction {
        +Id: Guid
        +BatchId: Guid
        +WarehouseId: Guid
        +ProductId: Guid
        +GoodsReceiptLineId: Guid
        +TransactionType: string
        +SourceType: string
        +PhysicalQuantityDelta: int
        +ReservedQuantityDelta: int
        +PhysicalQuantityAfter: int
        +ReservedQuantityAfter: int
        +OccurredAt: DateTimeOffset
    }

    class InventoryLock {
        +Id: Guid
        +BatchId: Guid
        +WarehouseId: Guid
        +LockedQuantity: int
        +Reason: string
        +Status: string
        +RequiresResolution: bool
        +LockedByUserId: Guid
        +ReleasedAt: DateTimeOffset
        +Version: int
    }
}

