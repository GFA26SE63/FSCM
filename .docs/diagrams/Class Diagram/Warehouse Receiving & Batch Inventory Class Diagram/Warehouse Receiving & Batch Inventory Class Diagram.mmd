%% ==========================================
%% 9. API TO APPLICATION DEPENDENCIES
%% ==========================================

GoodsReceiptsController ..> InventoryService : uses
InventoryController ..> InventoryService : uses
QrLabelsController ..> QrLabelService : uses
InventoryLocksController ..> InventoryLockService : uses

%% ==========================================
%% 10. APPLICATION TO STORE DEPENDENCIES
%% ==========================================

InventoryService ..> IInventoryStore : uses
QrLabelService ..> IQrLabelStore : uses
InventoryLockService ..> IInventoryLockStore : uses
InventoryExpirySweepService ..> IBatchExpiryStore : uses

QrLabelService ..> IQrCodeRenderer : renders QR

%% ==========================================
%% 11. INTERFACE REALIZATION
%% ==========================================

InventoryStore ..|> IInventoryStore : implements
InventoryStore ..|> IBatchExpiryStore : implements

QrLabelStore ..|> IQrLabelStore : implements
InventoryLockStore ..|> IInventoryLockStore : implements

QrCoderQrCodeRenderer ..|> IQrCodeRenderer : implements

%% ==========================================
%% 12. GOODS RECEIPT RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" GoodsReceipt : receives goods

GoodsReceipt "1" *-- "1..*" GoodsReceiptLine : contains

Product "1" -- "0..*" GoodsReceiptLine : received product

GoodsReceiptLine "1" -- "0..*" InventoryTransaction : receipt movements

%% ==========================================
%% 13. BATCH AND INVENTORY RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" Batch : stores

Product "1" -- "0..*" Batch : has batches

Batch "1" -- "0..1" InventoryBalance : stock balance

Batch "1" -- "0..*" InventoryTransaction : stock movements

Batch "1" -- "0..*" InventoryLock : unavailable stock

%% ==========================================
%% 14. QR LABEL RELATIONSHIPS
%% ==========================================

Batch "1" -- "0..*" BatchQrLabel : identified by labels

GoodsReceipt "1" -- "0..*" BatchQrLabel : receipt labels

BatchQrLabel "1" *-- "0..*" QrLabelEvent : event history

%% ==========================================
%% 15. WRITE-OFF RELATIONSHIPS
%% ==========================================

Warehouse "1" -- "0..*" WriteOff : records write-offs

WriteOff "1" *-- "0..*" WriteOffItem : contains

WriteOff "1" *-- "0..*" WriteOffAttachment : evidence

Batch "1" -- "0..*" WriteOffItem : affected batch

%% ==========================================
%% 16. BUSINESS CONSTRAINTS
%% ==========================================

note for GoodsReceipt "Stock increases only after approval. Repeated approval must not post inventory twice."

note for Batch "Batch identity follows warehouse, product and expiry rules."

note for InventoryBalance "Physical stock, reserved stock and available stock must remain consistent."

note for InventoryLock "Unavailable stock cannot be allocated. Overlapping locked and reserved quantities are not deducted twice."

note for BatchQrLabel "QR content and printing must follow the approved goods identification rules."

note for WriteOff "An approved write-off reduces physical stock exactly once."

note for WriteOffAttachment "Evidence images are stored through the image storage service."