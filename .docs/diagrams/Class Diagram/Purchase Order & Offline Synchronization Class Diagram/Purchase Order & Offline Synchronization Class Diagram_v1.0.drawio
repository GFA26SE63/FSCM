        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass OfflineOrder {\n  -Id : int? «PK, local»\n  -ClientRequestId : string «UK»\n  -Payload : OfflineOrderPayload\n  -Status : SyncStatus\n  -CreatedAt : DateTime\n  -RetryCount : int\n  -Error : string\n  -LastAttemptAt : DateTime?\n  -SyncedAt : DateTime?\n  -ServerOrderCode : string\n  -SyncMode : string\n  -FinalAmount : int?\n  -PromoChanged : bool\n  -ChangeReason : string\n}\n\nclass OfflineOrderPayload {\n  -ClientRequestId : string\n  -OfflineCode : string\n  -RetailerCode : string\n  -RetailerName : string\n  -CreatedAt : DateTime\n  -Payment : PaymentMethod\n  -CreditTerm : int\n  -Lines : List~CartLine~\n  -LocalTotal : int\n  -LocalDiscount : int\n  -LocalPromoIds : List~string~\n  +LocalFinal : int\n}\n\nclass CartLine {\n  -Sku : string\n  -Qty : int\n}\n\nclass SyncSnapshot {\n  -ServerTime : DateTime\n  -Retailers : List~Retailer~\n  -Products : List~Product~\n  -Prices : List~ProductPrice~\n  -Promotions : List~Promotion~\n  -Stock : List~StockEntry~\n  -FullReload : bool\n}\n\nclass OrderSyncResult {\n  -ClientRequestId : string\n  -Accepted : bool\n  -OrderCode : string\n  -Reason : string\n  -FinalAmount : int?\n  -PromoChanged : bool\n  -ChangeReason : string\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -SalesGroupId : Guid «FK»\n  -CreatedByUserId : Guid «FK»\n  -ReviewedByUserId : Guid? «FK»\n  -ClientOrderKey : Guid «UK»\n  -RequestHash : string\n  -Source : string\n  -Status : string\n  -PaymentMethod : string\n  -DeliveryAddress : string\n  -RequestedDeliveryDate : DateOnly?\n  -CreditTermDays : int\n  -SubtotalAmount : decimal\n  -DiscountAmount : decimal\n  -FinalAmount : decimal\n  -FinalPricePendingAllocation : bool\n  -OfflineEstimatedAmount : decimal?\n  -HasOfflineDifference : bool\n  -ServerReceivedAt : DateTimeOffset\n  -ReviewedAt : DateTimeOffset?\n  -RejectionReason : string?\n  -Version : int\n}\n\nclass SalesOrderLine {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK»\n  -ProductId : Guid «FK»\n  -ProductPriceId : Guid «FK»\n  -LineNumber : int\n  -SkuSnapshot : string\n  -ProductNameSnapshot : string\n  -OrderedQuantity : decimal\n  -UnitPrice : decimal\n  -GrossAmount : decimal\n  -DiscountAmount : decimal\n  -NetAmount : decimal\n  -MlorSourceRuleId : Guid? «FK»\n  -MlorSourceVersion : int\n  -MlorMinimumLifeRatio : decimal\n  -MlorResolvedAt : DateTimeOffset\n  -EstimatedArrivalAt : DateTimeOffset?\n  -CreatedAt : DateTimeOffset\n}\n\nclass OrderPromotion {\n  -Id : Guid «PK»\n  -SalesOrderLineId : Guid «FK»\n  -PromotionId : Guid «FK»\n  -PromotionCodeSnapshot : string\n  -PromotionNameSnapshot : string\n  -PromotionTypeSnapshot : string\n  -MinimumQuantitySnapshot : decimal\n  -DiscountPercent : decimal\n  -DiscountAmount : decimal\n  -IsServerFinal : bool\n  -AppliedAt : DateTimeOffset\n}\n\nclass IdempotencyKey {\n  -Id : Guid «PK»\n  -Key : string «UK»\n  -Scope : string\n  -UserAccountId : Guid «FK»\n  -SalesOrderId : Guid? «FK»\n  -Status : string\n  -CreatedAt : DateTimeOffset\n  -ExpiresAt : DateTimeOffset\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Status : string\n  -CreditTermDays : int\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -Email : string\n  -FullName : string\n  -Role : string\n  -IsActive : bool\n}\n\nclass Product {\n  -Id : Guid «PK»\n  -ProductCategoryId : Guid «FK»\n  -Sku : string\n  -Name : string\n  -Unit : string\n  -ShelfLifeHours : int\n  -Status : string\n}\n\nclass ProductPrice {\n  -Id : Guid «PK»\n  -ProductId : Guid «FK»\n  -UnitPrice : decimal\n  -EffectiveFrom : DateTimeOffset\n  -EffectiveTo : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass Promotion {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -PromotionType : string\n  -DiscountPercent : decimal\n  -StartAt : DateTimeOffset\n  -EndAt : DateTimeOffset\n  -IsActive : bool\n}\n\nOfflineOrder \&quot;1\&quot; *-- \&quot;1\&quot; OfflineOrderPayload : serialized payload\nOfflineOrderPayload \&quot;1\&quot; *-- \&quot;1..*\&quot; CartLine : lines\nSyncSnapshot ..&gt; Retailer : caches\nSyncSnapshot ..&gt; Product : caches\nSyncSnapshot ..&gt; ProductPrice : caches\nSyncSnapshot ..&gt; Promotion : caches\nOfflineOrder ..&gt; OrderSyncResult : receives\nOfflineOrderPayload ..&gt; SalesOrder : POST offline\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : places\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : creates\nSalesOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; SalesOrderLine : lines\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; ProductPrice : price history\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrderLine : ordered product\nProductPrice \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrderLine : price snapshot source\nSalesOrderLine \&quot;1\&quot; *-- \&quot;0..*\&quot; OrderPromotion : applied promotions\nPromotion \&quot;1\&quot; -- \&quot;0..*\&quot; OrderPromotion : source\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; IdempotencyKey : owns\nSalesOrder \&quot;0..1\&quot; -- \&quot;0..1\&quot; IdempotencyKey : deduplicated by\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7oqe0QnN4TZn_IISa2Ev-1">
