classDiagram
direction TB

%% ==========================================
%% MOBILE APPLICATION
%% ==========================================

namespace Mobile {

    class OrderRepository {
        <<repository>>
        +createOnline()
        +createOffline()
        +listOrders()
        +getOrder()
        +removeFromQueue()
    }

    class OfflineOrder {
        +id: int
        +localCode: String
        +payload: OfflineOrderPayload
        +status: String
        +retryCount: int
        +serverOrderCode: String
        +error: String
        +createdAt: DateTime
        +lastAttemptAt: DateTime
        +syncedAt: DateTime
        +copyWith()
    }

    class OfflineOrderPayload {
        +clientRequestId: String
        +offlineCode: String
        +retailerCode: String
        +retailerName: String
        +lines: List
        +localTotal: double
        +localDiscount: double
        +localPromoIds: List
        +createdAt: DateTime
        +toJson()
        +fromJson()
    }

    class OfflineOrderDao {
        <<DAO>>
        +insert()
        +update()
        +all()
        +byStatus()
        +byLocalCode()
        +delete()
    }

    class SyncService {
        <<service>>
        +syncAll()
        +refreshSnapshot()
        -_push()
        -_pull()
        -_recoverStale()
    }

    class SyncQueueLogic {
        +inCreationOrder()
        +dueForPush()
        +markSyncing()
        +applyResult()
        +markFailed()
        +recoverStale()
    }

    class AppDatabase {
        <<SQLite>>
        +close()
        +clearCache()
    }

    class ApiClient {
        <<HTTP Client>>
    }
}

%% ==========================================
%% API LAYER
%% ==========================================

namespace API {

    class OrdersController {
        <<controller>>
        +List()
        +Get()
        +GetByCode()
        +Create()
        +SubmitOffline()
        +Cancel()
        +Timeline()
    }
}

%% ==========================================
%% APPLICATION LAYER
%% ==========================================

namespace Application {

    class OrderService {
        <<service>>
        +ListAsync()
        +GetAsync()
        +GetByCodeAsync()
        +CreateAsync()
        +SubmitOfflineAsync()
        +CancelAsync()
        +GetTimelineAsync()
    }

    class IOrderStore {
        <<interface>>
        +FindAsync()
        +FindByClientOrderKeyAsync()
        +FindRetailerContextAsync()
        +FindPublishedProductAsync()
        +ResolveMlorAsync()
        +NextOrderCodeAsync()
        +AddOrder()
        +AddLine()
        +AddPromotion()
        +AddHistory()
        +SaveChangesAsync()
    }

    class IOrderPricingService {
        <<interface>>
        +CalculateAsync()
    }

    class OrderPricingService {
        <<service>>
        +CalculateAsync()
    }

    class IRealTimeAllocationService {
        <<interface>>
        +AllocateAsync()
    }

    class RealTimeAllocationService {
        <<service>>
        +AllocateAsync()
    }
}

%% ==========================================
%% PERSISTENCE LAYER
%% ==========================================

namespace Persistence {

    class OrderStore {
        <<repository>>
        +FindAsync()
        +FindByClientOrderKeyAsync()
        +FindRetailerContextAsync()
        +FindPublishedProductAsync()
        +ResolveMlorAsync()
        +NextOrderCodeAsync()
        +AddOrder()
        +AddLine()
        +AddPromotion()
        +AddHistory()
        +SaveChangesAsync()
    }
}

