%% ==========================================
%% MOBILE DEPENDENCIES
%% ==========================================

OrderRepository ..> OfflineOrderDao : manages offline orders
OrderRepository ..> ApiClient : sends online requests

SyncService ..> OfflineOrderDao : reads and updates queue
SyncService ..> SyncQueueLogic : manages synchronization
SyncService ..> ApiClient : submits queued orders

OfflineOrderDao ..> AppDatabase : uses SQLite
OfflineOrderDao ..> OfflineOrder : persists

%% ==========================================
%% MOBILE DATA RELATIONSHIPS
%% ==========================================

OfflineOrder "1" *-- "1" OfflineOrderPayload : contains

%% ==========================================
%% API DEPENDENCIES
%% ==========================================

ApiClient ..> OrdersController : REST integration
OrdersController ..> OrderService : uses

%% ==========================================
%% APPLICATION DEPENDENCIES
%% ==========================================

OrderService ..> IOrderStore : accesses order data
OrderService ..> IOrderPricingService : calculates prices
OrderService ..> IRealTimeAllocationService : requests allocation

%% ==========================================
%% INTERFACE REALIZATION
%% ==========================================

OrderStore ..|> IOrderStore : implements
OrderPricingService ..|> IOrderPricingService : implements
RealTimeAllocationService ..|> IRealTimeAllocationService : implements

%% ==========================================
%% PERSISTENCE DEPENDENCIES
%% ==========================================

OrderStore ..> SalesOrder : persists
OrderStore ..> SalesOrderLine : persists
OrderStore ..> OrderPromotion : persists
OrderStore ..> OrderStatusHistory : persists

%% ==========================================
%% SALES ORDER COMPOSITION
%% ==========================================

SalesOrder "1" *-- "1..*" SalesOrderLine : contains

SalesOrderLine "1" *-- "0..*" OrderPromotion : applied promotions

SalesOrder "1" *-- "0..*" OrderStatusHistory : status changes

%% ==========================================
%% IDEMPOTENCY RELATIONSHIP
%% ==========================================

IdempotencyKey "0..*" --> "0..1" SalesOrder : references

%% ==========================================
%% BUSINESS REFERENCES
%% ==========================================

Retailer "1" -- "0..*" SalesOrder : places orders

Product "1" -- "0..*" SalesOrderLine : ordered product

%% ==========================================
%% PURCHASE ORDER RELATIONSHIPS
%% ==========================================

SalesOrder "1" -- "0..*" SalesOrderQuote : quotations

SalesOrder "1" -- "0..1" PurchaseOrder : generates

SalesOrderQuote "1" -- "0..1" PurchaseOrder : accepted quotation

%% ==========================================
%% BUSINESS CONSTRAINTS
%% ==========================================

note for OfflineOrder "Mobile-side draft. Stored locally in SQLite before successful synchronization."

note for IdempotencyKey "Prevents duplicate server orders when the same request is retried."

note for SalesOrder "Supports Sales-assisted and Retailer-direct orders. Valid orders enter real-time allocation."

note for SalesOrderQuote "Final quotation follows successful batch allocation and pricing."

note for PurchaseOrder "Created only after quote acceptance and verified payment or valid credit confirmation."