        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Region {\n  -Id : Guid «PK»\n  -Code : string\n  -Name : string\n  -Description : string?\n  -IsActive : bool\n}\n\nclass UserAccount {\n  -Id : Guid «PK»\n  -Email : string\n  -FullName : string\n  -Role : string\n  -IsActive : bool\n}\n\nclass UserRegionAssignment {\n  -Id : Guid «PK»\n  -UserAccountId : Guid «FK»\n  -RegionId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -UnassignedAt : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass SalesGroup {\n  -Id : Guid «PK»\n  -RegionId : Guid «FK»\n  -Code : string\n  -Name : string\n  -IsActive : bool\n}\n\nclass SalesGroupMember {\n  -Id : Guid «PK»\n  -SalesGroupId : Guid «FK»\n  -UserAccountId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -UnassignedAt : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass RetailerSalesAssignment {\n  -Id : Guid «PK»\n  -RetailerId : Guid «FK»\n  -SalesGroupId : Guid «FK»\n  -AssignedAt : DateTimeOffset\n  -UnassignedAt : DateTimeOffset?\n  -IsActive : bool\n}\n\nclass Retailer {\n  -Id : Guid «PK»\n  -RegionId : Guid «FK»\n  -Code : string\n  -Name : string\n  -Status : string\n}\n\nclass SalesOrder {\n  -Id : Guid «PK»\n  -OrderCode : string\n  -RetailerId : Guid «FK»\n  -SalesGroupId : Guid «FK»\n  -CreatedByUserId : Guid «FK»\n  -Status : string\n  -FinalAmount : decimal\n  -ServerReceivedAt : DateTimeOffset\n}\n\nclass Payment {\n  -Id : Guid «PK»\n  -SalesOrderId : Guid «FK, UK»\n  -Status : string\n  -Amount : decimal\n  -AdjustedAmount : decimal\n  -ConfirmedAmount : decimal\n  -DeliveredDate : DateOnly?\n  -DueDate : DateOnly?\n  -PaidDate : DateOnly?\n  -Version : int\n}\n\nclass SalesRankingQuery {\n  +FromDate : DateOnly\n  +ToDate : DateOnly\n  +SalesGroupId : Guid?\n}\n\nclass SalesRevenueRow {\n  +SalesUserId : Guid\n  +SalesUserName : string\n  +SalesGroupId : Guid\n  +SalesGroupCode : string\n  +SalesGroupName : string\n  +RegionId : Guid\n  +OrderCount : int\n  +RecognizedRevenue : decimal\n}\n\nclass SalesRankingResult {\n  +FromDate : DateOnly\n  +ToDate : DateOnly\n  +Scope : string\n  +Entries : List~SalesRankingEntryResult~\n}\n\nclass SalesRankingEntryResult {\n  +Rank : int\n  +SalesUserId : Guid\n  +SalesUserName : string\n  +SalesGroupId : Guid\n  +SalesGroupCode : string\n  +SalesGroupName : string\n  +RegionId : Guid\n  +OrderCount : int\n  +RecognizedRevenue : decimal\n}\n\nRegion \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroup : owns\nRegion \&quot;1\&quot; -- \&quot;0..*\&quot; Retailer : contains\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; UserRegionAssignment : region scope\nRegion \&quot;1\&quot; -- \&quot;0..*\&quot; UserRegionAssignment : scoped users\nSalesGroup \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroupMember : memberships\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; SalesGroupMember : members\nSalesGroup \&quot;1\&quot; -- \&quot;0..*\&quot; RetailerSalesAssignment : retailer scope\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; RetailerSalesAssignment : assignment history\nSalesGroup \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : captures\nRetailer \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : places\nUserAccount \&quot;1\&quot; -- \&quot;0..*\&quot; SalesOrder : creates\nSalesOrder \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : receivable\nSalesRankingQuery ..&gt; SalesGroup : filters scope\nSalesOrder ..&gt; SalesRevenueRow : aggregates delivered orders\nPayment ..&gt; SalesRevenueRow : adjusted revenue\nSalesGroupMember ..&gt; SalesRevenueRow : access scope\nSalesRevenueRow ..&gt; SalesRankingEntryResult : ranked into\nSalesRankingResult \&quot;1\&quot; *-- \&quot;0..*\&quot; SalesRankingEntryResult : entries&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0gKdbdRpFf1xULm1v-sr-1">
