%% ==========================================
%% APPLICATION SERVICES
%% ==========================================

namespace Application_Services {

    class TerritoryService {
        <<Service>>
        +ListRegionsAsync()
        +GetRegionAsync()
        +CreateRegionAsync()
        +UpdateRegionAsync()
        +SetRegionStatusAsync()
        +ListSalesGroupsAsync()
        +GetSalesGroupAsync()
        +CreateSalesGroupAsync()
        +UpdateSalesGroupAsync()
        +SetSalesGroupStatusAsync()
        +ListMembershipsAsync()
        +TransferSalesAsync()
        +ListRetailerAssignmentsAsync()
        +AssignRetailerAsync()
        +CheckOrderAccessAsync()
    }

    class ReportService {
        <<Service>>
        +GetSalesRankingAsync()
        +GetSalesKpiAsync()
        +GetProductRankingAsync()
        -ResolveScopeAsync()
        -ValidatePeriod()
        -BuildKpiEntry()
        -ParseConfiguration()
    }
}

