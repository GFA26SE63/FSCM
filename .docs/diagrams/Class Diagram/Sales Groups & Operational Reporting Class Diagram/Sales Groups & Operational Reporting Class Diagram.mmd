namespace API {

    class RegionsController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Update()
        +UpdateStatus()
    }

    class SalesGroupsController {
        <<Controller>>
        +List()
        +Get()
        +Create()
        +Update()
        +UpdateStatus()
    }

