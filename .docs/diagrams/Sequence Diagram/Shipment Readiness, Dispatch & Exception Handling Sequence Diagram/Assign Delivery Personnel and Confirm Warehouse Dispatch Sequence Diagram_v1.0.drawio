        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\nactor Staff as \&quot;Admin/Operator\&quot;\nparticipant UI as \&quot;Interface: UI\&quot;\nparticipant API as \&quot;mainController: Controller\&quot;\nparticipant Delivery as \&quot;deliveryService: Service\&quot;\nparticipant Ship as \&quot;shipmentService: Service\&quot;\nparticipant DB as \&quot;PostgreSQL: Database\&quot;\nStaff-&gt;&gt;UI: Assign driver and vehicle to shipment\nUI-&gt;&gt;+API: PATCH /api/v1/shipments/{id}/assignment\nAPI-&gt;&gt;Delivery: validateAndAssign()\nDelivery-&gt;&gt;DB: Save same-warehouse assignment snapshot\nStaff-&gt;&gt;UI: Confirm shipment issue\nUI-&gt;&gt;+API: POST /api/v1/shipments/{id}/issue\nAPI-&gt;&gt;Ship: confirmIssue(idempotencyKey, version)\nShip-&gt;&gt;DB: Recheck readiness and reservation\nalt Ready\n    Ship-&gt;&gt;DB: Decrease OnHand and Reserved once\n    Ship-&gt;&gt;DB: Mark shipment Dispatched and order when all shipments issued\n    API--&gt;&gt;-UI: Dispatch confirmed\nelse Not ready or duplicate\n    API--&gt;&gt;-UI: Blocked/existing result\nend\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="43sUy9aYdVP_hnpQnFRk-1">
