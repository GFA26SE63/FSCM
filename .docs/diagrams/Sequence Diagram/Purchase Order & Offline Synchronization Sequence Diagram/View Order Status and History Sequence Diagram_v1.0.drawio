        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User as \&quot;Retailer/Sales/Manager/Admin/Operator\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant App as \&quot;applicationService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    User-&gt;&gt;UI: Select order\n    UI-&gt;&gt;+API: GET /api/v1/orders/{id} and /timeline\n    API-&gt;&gt;App: Authorize resource scope\n    App-&gt;&gt;+DB: Read order, allocation trace and status history\n    alt Authorized\n        DB--&gt;&gt;-App: Order snapshots and transitions\n        App--&gt;&gt;UI: Items, prices, fulfillment and timeline\n    else Outside scope\n        API--&gt;&gt;-UI: 403/404\n    end\n    Note over UI,DB: Timeline includes PendingApproval, AwaitingAllocation, Allocating, AwaitingRunApproval, Allocated, Picking, Dispatched, Delivering, Delivered and exception branches.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zqu3IBf5M2mu0ZHaFY1J-1">
