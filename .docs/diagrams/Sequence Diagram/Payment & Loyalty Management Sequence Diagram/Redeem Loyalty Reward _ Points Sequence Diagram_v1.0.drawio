        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Retailer as \&quot;Retailer\&quot;\n    actor Admin as \&quot;Admin\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant Workflow as \&quot;redemptionWorkflow: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Retailer-&gt;&gt;UI: Select reward and request redemption\n    UI-&gt;&gt;+API: POST /api/v1/loyalty/redemptions\n    API-&gt;&gt;+Workflow: Create(request, actor)\n    Workflow-&gt;&gt;DB: Check reward validity, balance and negative-correction block\n    alt Sufficient usable points\n        Workflow-&gt;&gt;DB: Create request and hold/deduct points idempotently\n        alt Approval required\n            Admin-&gt;&gt;UI: Review redemption\n            UI-&gt;&gt;+API: POST /loyalty/redemptions/{id}/approve\n            API-&gt;&gt;+Workflow: Approve(id)\n            Workflow-&gt;&gt;DB: Set Approved\n        end\n        API--&gt;&gt;-UI: Redemption status\n        Admin-&gt;&gt;UI: Deliver and complete gift\n        UI-&gt;&gt;+API: POST .../{id}/deliver then /complete\n        API-&gt;&gt;+Workflow: Complete(id)\n        Workflow-&gt;&gt;DB: Append completion ledger and audit\n    else Insufficient or negative balance\n        Workflow--&gt;&gt;-API: Insufficient points\n        API--&gt;&gt;-UI: 409/validation error\n    end\n    Note over Workflow,DB: Reject/cancel restores held points once; later adjustment/refund posts linked correction.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="fdpNhskFmWFijmQjWzHN-1">
