        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Payer as \&quot;Retailer/authorized staff\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant Pay as \&quot;paymentService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    participant PayOS as \&quot;payOS: External System\&quot;\n    alt Prepaid QR/bank transfer\n        Payer-&gt;&gt;UI: Request payment after final allocation approval\n        UI-&gt;&gt;+API: POST /api/v1/payments/orders/{orderId}/payos-checkout\n        API-&gt;&gt;Pay: Validate approved final amount and payment gate\n        Pay-&gt;&gt;+PayOS: Create checkout for server amount\n        PayOS--&gt;&gt;-Pay: Checkout URL/order code\n        Pay--&gt;&gt;UI: Redirect to PayOS\n        PayOS-&gt;&gt;API: POST /api/v1/payments/payos/webhook\n        API-&gt;&gt;Pay: Verify signature, order, amount, currency and status\n        Pay-&gt;&gt;DB: Idempotently confirm full payment in canonical ledger\n    else Cash / manual transfer / COD\n        Payer-&gt;&gt;UI: Provide payment evidence\n        UI-&gt;&gt;+API: POST /api/v1/payments/orders/{orderId}/collect\n        API-&gt;&gt;Pay: Validate method, stage and full outstanding amount\n        Pay-&gt;&gt;DB: Record confirmed payment idempotently\n    end\n    API--&gt;&gt;-UI: Payment status independent from order status\n    Note over Pay,DB: Prepaid must be fully paid before dispatch; COD is collected at delivery; deferred due date starts after complete receipt.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="WELIlRAiSpUNY3yp2aGI-1">
