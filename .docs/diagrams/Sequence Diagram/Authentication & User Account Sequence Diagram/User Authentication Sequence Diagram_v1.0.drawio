  <diagram name="Page-1" id="7QgkHzRdWtPldURx5_RQ">
    <mxGraphModel dx="2343" dy="1313" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User as \&quot;User\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant ID as \&quot;identityService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    participant Entra as \&quot;entraId: External System\&quot;\n    User-&gt;&gt;UI: Enter credentials and select Login\n    UI-&gt;&gt;+API: POST /api/v1/auth/login\n    API-&gt;&gt;+ID: Authenticate(username, password)\n    ID-&gt;&gt;DB: Load account, credential and status\n    alt Local account valid and active\n        ID--&gt;&gt;-API: Issue JWT/refresh token\n        API--&gt;&gt;-UI: AuthenticationResult\n        UI-&gt;&gt;+API: GET /api/v1/auth/me\n        API-&gt;&gt;+ID: Resolve role and resource scope\n        ID--&gt;&gt;UI: Role, warehouse/region/group/retailer scope\n    else Invalid or inactive account\n        ID--&gt;&gt;-API: Authentication error\n        API--&gt;&gt;-UI: 401 with error message\n    end\n    opt Entra exchange\n        User-&gt;&gt;UI: Sign in with Entra\n        UI-&gt;&gt;+Entra: Complete identity sign-in\n        Entra--&gt;&gt;-UI: Identity token\n        UI-&gt;&gt;+API: POST /api/v1/auth/entra/exchange\n        API-&gt;&gt;+ID: Validate token and link eligible account\n        ID-&gt;&gt;DB: Check account and assignments\n        alt Eligible account\n            ID--&gt;&gt;-API: Issue FSCM tokens\n            API--&gt;&gt;-UI: AuthenticationResult\n        else No eligible account\n            API--&gt;&gt;UI: 401/403 access denied\n        end\n    end\n    Note over UI,API: Google login is not exposed by the current backend contract.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CQfG65P80XLpy6ymcFqT-132">
