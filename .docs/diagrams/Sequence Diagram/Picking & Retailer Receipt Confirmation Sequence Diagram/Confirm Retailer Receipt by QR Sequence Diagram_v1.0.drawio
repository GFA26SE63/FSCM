        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Retailer as \&quot;Retailer\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant Ship as \&quot;shipmentService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Retailer-&gt;&gt;UI: Scan every dispatched QR label\n    UI-&gt;&gt;+API: POST /api/v1/shipments/{id}/receipt\n    API-&gt;&gt;Ship: ConfirmReceipt(actor, QR, quantity, idempotency)\n    Ship-&gt;&gt;DB: Verify retailer ownership, shipment, tag and quantity\n    alt Valid and not already confirmed\n        Ship-&gt;&gt;DB: Save receipt confirmation and mark shipment received\n        Ship-&gt;&gt;DB: Check whether all order shipments are received\n        alt All shipments received\n            Ship-&gt;&gt;DB: Set order Delivered/complete receipt\n            Ship-&gt;&gt;DB: Calculate deferred due date if applicable\n        end\n        API--&gt;&gt;-UI: Receipt confirmed\n    else Invalid or duplicate QR\n        API--&gt;&gt;UI: Conflict/error\n    end\n    Note over Ship,DB: Receipt does not create retailer inventory or automatically settle payment.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="SVT5CDanWg84rwE1eEQn-1">
