  <diagram name="Page-1" id="IaFI4aqGp7THamB8NUjI">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant Job as \&quot;allocationJob: Control\&quot;\n    participant Run as \&quot;allocationRunService: Service\&quot;\n    participant Planner as \&quot;allocationEngine: Service\&quot;\n    participant ETA as \&quot;deliveryEtaService: Service\&quot;\n    participant Map as \&quot;googleMapsCache: Entity\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Job-&gt;&gt;Run: StartAsync(published allocation_run cutoff)\n    Run-&gt;&gt;+DB: Acquire distributed/idempotency lock\n    Run-&gt;&gt;+DB: Snapshot approved eligible orders and shared stock pool\n    Run-&gt;&gt;+ETA: Resolve schedule, distance and ETA inputs\n    ETA-&gt;&gt;+Map: Read cached warehouse-retailer distance\n    Map--&gt;&gt;-ETA: Versioned distance or controlled provider error\n    ETA--&gt;&gt;-Run: ETA/schedule/transit snapshot\n    Run-&gt;&gt;Planner: Plan orders by server_received_at then order code\n    loop Each order line\n        Planner-&gt;&gt;Planner: Filter SKU, active/non-expired batch, Available, distance, ETA and MLOR\n        Planner-&gt;&gt;Planner: Greedy weighted score; tie-break batch id; recalc quantity score\n        Planner-&gt;&gt;Planner: Select batch fragments, then resolve HSD discount SKU→Category\n    end\n    alt Every line complete\n        Planner-&gt;&gt;DB: Persist tentative allocation, prices, candidates and trace\n        DB--&gt;&gt;-Run: AwaitingRunApproval proposal\n    else Any line short\n        Planner-&gt;&gt;Planner: Roll back all tentative quantity for this order\n        Planner-&gt;&gt;DB: Persist ShortInRun result and trace\n    end\n    Note over Planner,DB: Tentative plan changes neither OnHand nor Reserved; no cross-order batch reassignment.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0uOvgJvqIEltCizOMn2G-37">
