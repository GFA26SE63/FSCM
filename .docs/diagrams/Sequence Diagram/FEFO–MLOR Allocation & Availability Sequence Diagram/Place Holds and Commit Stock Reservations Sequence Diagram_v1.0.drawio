        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Admin as \&quot;Admin\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant App as \&quot;applicationService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    participant Issue as \&quot;pickingIssueService: Service\&quot;\n    Admin-&gt;&gt;UI: Review plan version\n    UI-&gt;&gt;+API: GET /api/v1/allocation-runs/plan-versions/{id}\n    API-&gt;&gt;App: Load proposal and trace\n    App-&gt;&gt;DB: Read proposal version and snapshots\n    alt Request recalculation\n        Admin-&gt;&gt;UI: Request recalculation with reason\n        UI-&gt;&gt;+API: POST .../request-recalculation\n        API-&gt;&gt;App: Create superseding proposal version\n        App-&gt;&gt;DB: Keep prior version unapproved\n    else Approve\n        Admin-&gt;&gt;UI: Approve proposal\n        UI-&gt;&gt;+API: POST .../approve\n        API-&gt;&gt;App: Revalidate inventory, batch, ETA, MLOR, price and rule versions\n        alt Revalidation passes\n            App-&gt;&gt;DB: Transactionally increase Reserved and decrease Available\n            App-&gt;&gt;DB: Mark version Approved and order Allocated\n            App-&gt;&gt;Issue: Issue picking lists once\n            Issue-&gt;&gt;DB: Create warehouse lists and order-line splits\n            API--&gt;&gt;-UI: Approved and Picking released\n        else Conflict\n            App-&gt;&gt;DB: Roll back reservation and leave proposal for recalculation\n            API--&gt;&gt;-UI: Conflict; review new version\n        end\n    end\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kiwT223PZP7Jx7l_v_p1-1">
