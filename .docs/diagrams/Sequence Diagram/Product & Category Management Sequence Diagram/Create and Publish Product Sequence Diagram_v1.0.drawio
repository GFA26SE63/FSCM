        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Admin as \&quot;Admin\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant App as \&quot;applicationService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Admin-&gt;&gt;UI: Enter SKU, category, price and shelf life\n    UI-&gt;&gt;+API: POST /api/v1/products\n    API-&gt;&gt;App: Create product\n    App-&gt;&gt;+DB: Validate SKU/category and save Draft\n    DB--&gt;&gt;-App: Draft product\n    App--&gt;&gt;UI: Draft created\n    Admin-&gt;&gt;UI: Publish product\n    UI-&gt;&gt;+API: POST /api/v1/products/{id}/publish\n    API-&gt;&gt;App: Publish(id)\n    App-&gt;&gt;DB: Validate mandatory fields and current version\n    alt Complete draft\n        App-&gt;&gt;DB: Set Published and snapshot price\n        API--&gt;&gt;-UI: Published\n    else Invalid draft\n        API--&gt;&gt;-UI: Validation error\n    end\n    Note over UI,DB: Published product/price is immutable; change uses Inactive + new SKU or clone-to-Draft.\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CKOk2jZyqmgo-bHi5tyf-1">
