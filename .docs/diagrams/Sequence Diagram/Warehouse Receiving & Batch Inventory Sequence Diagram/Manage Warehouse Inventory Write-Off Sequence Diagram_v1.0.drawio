        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Keeper as \&quot;Warehouse Keeper\&quot;\n    actor Approver as \&quot;Admin/authorized Operator\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant Inv as \&quot;inventoryService: Service\&quot;\n    participant Blob as \&quot;evidenceStorage: External System\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Keeper-&gt;&gt;UI: Select damaged/expired quantity and attach evidence\n    UI-&gt;&gt;+API: POST inventory lock/write-off request\n    API-&gt;&gt;Inv: Validate warehouse scope and eligible quantity\n    Inv-&gt;&gt;DB: Lock quantity before write-off\n    Inv-&gt;&gt;Blob: Store evidence reference\n    Inv-&gt;&gt;DB: Save pending write-off and audit\n    Approver-&gt;&gt;UI: Review write-off\n    UI-&gt;&gt;+API: Approve write-off\n    API-&gt;&gt;Inv: Approve with current version\n    alt Quantity and evidence valid\n        Inv-&gt;&gt;DB: Reduce OnHand, mark disposed and finalize transaction\n        API--&gt;&gt;-UI: Write-off approved\n    else Reserved/locked conflict or over-quantity\n        Inv-&gt;&gt;DB: Keep NeedsHandling/lock state; no negative stock\n        API--&gt;&gt;-UI: Conflict requiring authorized resolution\n    end\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sJStfzrM9uXErYYrXUb5-1">
