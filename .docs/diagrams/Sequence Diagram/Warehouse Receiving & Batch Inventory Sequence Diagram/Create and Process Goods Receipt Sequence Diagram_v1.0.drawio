        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Keeper as \&quot;Warehouse Keeper/Admin\&quot;\n    participant UI as \&quot;Interface: UI\&quot;\n    participant API as \&quot;mainController: Controller\&quot;\n    participant Inv as \&quot;inventoryService: Service\&quot;\n    participant DB as \&quot;PostgreSQL: Database\&quot;\n    Keeper-&gt;&gt;UI: Enter receipt lines (warehouse, SKU, expiry, quantity)\n    UI-&gt;&gt;+API: POST /api/v1/goods-receipts\n    API-&gt;&gt;Inv: Create receipt\n    Inv-&gt;&gt;DB: Validate warehouse scope and batch fields\n    Inv-&gt;&gt;DB: Save Draft/Submitted receipt; no stock increase\n    API--&gt;&gt;-UI: Receipt awaiting approval\n    Keeper-&gt;&gt;UI: Approve receipt when authorized\n    UI-&gt;&gt;API: POST /api/v1/goods-receipts/{id}/approve\n    API-&gt;&gt;Inv: Approve with idempotency/version\n    Inv-&gt;&gt;DB: Transactionally create/merge batch and increase OnHand\n    Inv-&gt;&gt;DB: Create QR labels and inventory transaction\n    alt First approval\n        DB--&gt;&gt;API: Received and inventory updated\n    else Duplicate retry\n        DB--&gt;&gt;API: Existing approval result; no double increase\n    end\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="a6AmXHNoBZVnphIW2-gF-1">
