<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="-r4xRhbChq21K1hwCNaS">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml finance_loyalty_v1.0\ntitle F5 - Credit, Completed, Loyalty and After-sales\n\n|System|\nstart\npartition \&quot;Credit: raise and collect receivable\&quot; {\n  :C1 converted to a Credit PO (quote price pending delivery + stored term);\n  |Retailer|\n  :Receive all C1 parts in full (or resolve exceptions);\n  |System|\n  :Activate the receivable (e.g. 500,000d);\\ndue date = full-receipt date + term (03/11 -&gt; 10/11);\n  |Sales/Operator|\n  :Record collection of the allowed portion (evidence); separate disputed amount;\n  |System|\n  if (Outstanding = 0 &amp; no pending case?) then (yes)\n    :C1 -&gt; Completed;\n  else (debt/dispute remains)\n    :Keep tracking receivable (received-in-full but not paid-in-full -&gt; not Completed);\n  endif\n}\n\npartition \&quot;Completed &amp; award points (once)\&quot; {\n  |System|\n  :Evaluate all delivery parts + exceptions + money + pending cases;\n  if (No obligation/case left to resolve?) then (clean)\n    :Emit Completed event (e.g. P1);\n    :Award points ONCE on valid purchase value\\n(612,000d -&gt; 61 points, 1pt/10,000d, round down);\n  else (obligation remains)\n    :Not Completed;\n    stop\n  endif\n}\n\npartition \&quot;Reward redemption &amp; point hold\&quot; {\n  |Retailer|\n  :Choose a reward (e.g. 60 points) + submit redemption request;\n  |System|\n  :Hold 60 points + reward quantity (available points left = 1);\n  |Authorized user|\n  if (Approve &amp; deliver reward?) then (completed)\n    :Deliver reward; held 60 points -&gt; used;\n  else (reject/cancel)\n    :Release reward + return held points;\n  endif\n}\n\npartition \&quot;Complaint, price adjustment, refund &amp; point clawback\&quot; {\n  |Retailer|\n  :Open P1 / part W1 / batch A1, report 1 damaged carton + evidence;\n  |Admin|\n  if (Accept complaint?) then (accept)\n    :Reduce obligation by the affected goods&#39; final price\\n(A1 actual 72,000d: 612,000d -&gt; 540,000d);\n    |System|\n    :Reconcile collected 612,000d vs obligation 540,000d -&gt; refund 72,000d;\n    :Recompute target points on 540,000d (54) -&gt; claw back 7 points\\n(balance may go negative -&gt; block new redemption);\n    |Admin/Operator|\n    :Create refund case, transfer externally, submit evidence;\\ncase = \&quot;Awaiting verification\&quot;;\n    if (Evidence valid?) then (yes)\n      :Mark \&quot;Refunded\&quot; 72,000d; net collected 540,000d; balance = 0;\n    else (reject)\n      :\&quot;Needs supplement\&quot; -&gt; preparer supplements &amp; resubmits same case;\n    endif\n  else (reject)\n    :Restore per the record;\n  endif\n}\n\npartition \&quot;Notifications, KPI and period close\&quot; {\n  |Sales Manager|\n  :Open KPI + period ranking for the group;\n  |Admin|\n  :Open dashboard/period report (filled/short, stock held/issued, money/exceptions);\n  :Close the period after reconciliation;\n}\n\n|System|\n:Close the money/points ledger + reports;\\na post-Completed complaint opens a separate adjustment case, keeping history;\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aFN6zra0uacw_n7J5eYR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
