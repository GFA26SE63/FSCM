  <diagram name="Trang-1" id="BPEn1xwR4NH9LCMMavWV">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml sales_order_v1.0\ntitle F2 - Retailer, MLOR, Promotions and SO Capture\n\n|Sales|\nstart\n:Declare retailer - General Information tab\\n(name, contact, GPS, store size, potential);\n:Shelf-life Requirements tab - set MLOR\\n(Category 30%, SKU_A override 80% for R2);\n:Submit the declaration for review;\n\n|Admin|\nif (Approve retailer profile?) then (approve)\n  :Create retailer + official MLOR set;\n  :Configure credit term (R2 = Credit 7 days);\nelse (reject)\n  :Return rejection reason;\n  stop\nendif\n\n|Admin|\n:Create group promotion (A+B: total &gt;= 10 cartons -&gt; 10% off)\\n+ choose retailer/scope/effective window;\n:Configure shelf-life discount table\\n(&lt;40%: -20%; 40-&lt;70%: -10%; &gt;=70%: 0%);\n\n|Sales|\n:Load catalog, view price + MLOR per retailer;\n:Build the cart, apply group promotion if threshold met;\n\npartition \&quot;SO capture (online)\&quot; {\n  |Sales|\n  :Create SO (P1: A6+B4, P2: A3+B2, C1: A5, SHORT: A4+B4);\n  :Send SO to the server;\n  |System|\n  :Store server receipt time, SO code, promo/MLOR;\\nSO = \&quot;Pending input approval\&quot;;\n}\n\npartition \&quot;Offline draft\&quot; {\n  |Sales|\n  :Lose connection -&gt; build cart, save draft on device;\n  :Reconnect -&gt; manually tap Submit;\n  |System|\n  if (Price/MLOR conditions changed?) then (changed)\n    :Return the difference, require Sales confirmation;\n    |Sales|\n    :Confirm the new conditions, then resubmit;\n  else (unchanged)\n  endif\n  |System|\n  :Accept the order (idempotent by request key);\n}\n\n|Admin/Operator|\n:Open the queue; check retailer/SKU/quantity/delivery deadline/conditions;\nif (Order valid &amp; before 12:00 cutoff?) then (yes)\n  :Approve the input demand;\nelse (no / after cutoff)\n  :Reject with reason OR defer to the next run;\nendif\n\n|System|\n:Hand over SO (server receipt time + stored conditions) to F3;\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hJtMN916VikSBi_AIr7h-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
